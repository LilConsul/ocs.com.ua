backend:
  name: github
  repo: LilConsul/ocs.com.ua
  branch: denys/chore/deploy
  base_url: http://localhost:4321
  auth_endpoint: /api/auth
  commit_messages:
    create: '[CMS] Create: {{collection}} "{{slug}}"'
    update: '[CMS] Update" {{collection}} "{{slug}}"'
    delete: '[CMS] Delete: {{collection}} "{{slug}}"'
    uploadMedia: '[CMS] Upload: "{{path}}"'
    deleteMedia: '[CMS] Delete: "{{path}}"'
  squash_merges: true

  #name: test-repo

# Editorial workflow — drafts live in PRs, editors promote Draft → In Review → Ready
publish_mode: editorial_workflow

# Site URLs
site_url: https://ocs.com.ua
display_url: https://ocs.com.ua

# Branding
logo:
  src: /admin-logo.svg
  show_in_header: true

# CMS locale (UI language)
locale: en # ua

# Slug sanitization: force ASCII filenames, strip diacritics (important for Ukrainian category names)
slug:
  encoding: ascii
  clean_accents: true
  sanitize_replacement: "-"

# All equipment media (images, datasheets) uploads land here
media_folder: "application/frontend/public/assets/equipment"
public_folder: "/assets/equipment"

i18n:
  structure: multiple_files
  locales: [en, ua]
  default_locale: en

collections:
  # ── Equipment Categories ────────────────────────────────────────────────────
  # File collection — each locale of each _index file is a named entry.
  # No i18n on the collection (file collections only support single_file i18n).
  # To add a new category: add two entries below (one en, one ua) and create the files.
  - name: "equipment-categories"
    label: "Equipment Categories"
    label_singular: "Equipment Category"
    description: >-
      Equipment type category index files. Controls sidebar label, icon,
      sort order and description for each category folder.
    editor:
      preview: false
    files:
      - name: "checkweighers-en"
        label: "Checkweighers (EN)"
        file: "application/frontend/src/content/equipment/checkweighers/_index.en.md"
        fields: &category_fields
          - { label: "Type", name: "type", widget: "hidden", default: "category" }
          - { label: "Title", name: "title", widget: "string" }
          - { label: "Description", name: "description", widget: "text", required: false }
          - { label: "Icon", name: "icon", widget: "string", required: false, hint: "Material Symbol name, e.g. scale" }
          - { label: "Order", name: "order", widget: "number", value_type: "int", default: 0, required: false, hint: "Lower numbers appear first in the sidebar." }
      - name: "checkweighers-ua"
        label: "Checkweighers (UA)"
        file: "application/frontend/src/content/equipment/checkweighers/_index.ua.md"
        fields: *category_fields
      - name: "catchweighers-en"
        label: "Catchweighers & DWS (EN)"
        file: "application/frontend/src/content/equipment/catchweighers/_index.en.md"
        fields: *category_fields
      - name: "catchweighers-ua"
        label: "Catchweighers & DWS (UA)"
        file: "application/frontend/src/content/equipment/catchweighers/_index.ua.md"
        fields: *category_fields

  # ── Equipment Products ───────────────────────────────────────────────────────
  # Manages product files inside category sub-folders (everything except _index).
  - name: "equipment"
    label: "Equipment Products"
    label_singular: "Equipment Product"
    description: >-
      Individual product pages inside a category sub-folder.
      Use Order to control sort position within the category.
    folder: "application/frontend/src/content/equipment"
    create: true
    delete: false
    i18n: true
    preview_path: "{{locale}}/catalogue/{{dirname}}/{{filename}}"
    summary: "{{title}} — {{dirname}}/{{filename}}"
    sortable_fields: ["order", "title"]
    view_filters:
      - label: "Food & Beverage"
        field: industries
        pattern: "food-beverage"
      - label: "Pharmaceutical"
        field: industries
        pattern: "pharmaceutical"
      - label: "Cosmetics"
        field: industries
        pattern: "cosmetics"
    view_groups:
      - label: "By Category"
        field: dirname
      - label: "By Order"
        field: order
    editor:
      preview: false
    nested:
      depth: 2
      summary: "{{title | default('index')}}"
    meta:
      path:
        widget: select
        label: "Category"
        index_file: "_index"
        options:
          - { label: "Checkweighers", value: "checkweighers" }
          - { label: "Catchweighers & DWS", value: "catchweighers" }
    fields:
      - { label: "Type", name: "type", widget: "hidden", default: "product", i18n: duplicate }
      # Shared across locales
      - { label: "Icon", name: "icon", widget: "string", required: false, i18n: duplicate }
      - { label: "Order", name: "order", widget: "number", value_type: "int", default: 0, required: false, hint: "Lower numbers appear first within this category.", i18n: duplicate }
      - label: "Gallery"
        name: "gallery"
        widget: "list"
        required: false
        i18n: true
        min: 0
        max: 3
        field: { label: "Image", name: "image", widget: "image" }
      - { label: "Datasheet", name: "datasheet", widget: "file", required: false, i18n: duplicate }
      - { label: "Industries", name: "industries", widget: "list", required: false, i18n: true }
      # Translatable fields
      - { label: "Title", name: "title", widget: "string", i18n: true }
      - { label: "Description", name: "description", widget: "text", required: false, i18n: true }
      - label: "Specifications"
        name: "specs"
        widget: "list"
        required: false
        i18n: true
        min: 0
        max: 10
        fields:
          - { label: "Label", name: "label", widget: "string" }
          - { label: "Value", name: "value", widget: "string" }
      - { label: "Body", name: "body", widget: "richtext", required: false, i18n: true }
