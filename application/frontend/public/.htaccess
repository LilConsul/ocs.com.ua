# Send "charset=UTF-8" in the Content-Type header of HTML responses (SEO checkers flag its absence)
AddDefaultCharset UTF-8

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
# Astro emits 50x.astro as 50x/index.html. Name the file explicitly: a bare /50x would make
# mod_dir answer with a 301 redirect instead of the error page.
ErrorDocument 500 /50x/index.html
ErrorDocument 502 /50x/index.html
ErrorDocument 503 /50x/index.html
ErrorDocument 504 /50x/index.html

# --- One address per page: https://ocs.com.ua ---
# www and plain http answer with one 301 to https://ocs.com.ua (dev: https://dev.ocs.com.ua).
# Only our own host names: mail.ocs.com.ua, autoconfig and the other mail hosts share this
# Apache vhost and must keep working over http. Let's Encrypt challenges stay reachable.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_URI} !^/\.well-known/
	RewriteCond %{HTTP_HOST} ^www\.ocs\.com\.ua$ [NC]
	RewriteRule ^ https://ocs.com.ua%{REQUEST_URI} [R=301,L]
	RewriteCond %{REQUEST_URI} !^/\.well-known/
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP_HOST} ^((dev\.)?ocs\.com\.ua)$ [NC]
	RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Permanent redirects (mod_alias; needs AllowOverride FileInfo, same as ErrorDocument) ---
# RedirectMatch runs before Apache maps the URL to a file, so these win over any file in dist.
# Targets end in "/" so mod_dir does not add a second 301.

# Root: send to the default locale (Ukrainian), matching src/pages/index.astro
RedirectMatch 301 ^/$ /ua/

# Crawlers and SEO tools probe /sitemap.xml first; the real file is sitemap-index.xml
# (@astrojs/sitemap, referenced from robots.txt)
RedirectMatch 301 ^/sitemap\.xml$ /sitemap-index.xml

# /{lang}/catalogue has no page of its own: send it to the Header's "Catalogue" target
RedirectMatch 301 ^/(en|ua)/catalogue/?$ /$1/catalogue/equipment/checkweigher/

# /{lang}/catalogue/equipment and /{lang}/catalogue/industry have no index page either:
# send them to the first target the Header uses for "Catalogue" / "Industries"
RedirectMatch 301 ^/(en|ua)/catalogue/equipment/?$ /$1/catalogue/equipment/checkweigher/
RedirectMatch 301 ^/(en|ua)/catalogue/industry/?$ /$1/catalogue/industry/food-beverage/

# Old scheme /{lang}/catalogue/{category}[/{product}] -> /{lang}/catalogue/equipment/...
RedirectMatch 301 ^/(en|ua)/catalogue/(?!(?:equipment|industry)(?:/|$))([^/]+(?:/[^/]+)?)/?$ /$1/catalogue/equipment/$2/

# --- LLM files ---
# Markdown copies of the pages (/ua/about.md, linked from /llms.txt) must be served as text.
# Apache's MIME table may have no .md entry, which would send them as a download.
AddType "text/markdown; charset=UTF-8" .md

# --- Browser caching ---
# Files under /_astro/ carry a content hash in their name (a new build writes a new name), so
# browsers may keep them for a year without asking again. Everything else revalidates as before.
<IfModule mod_headers.c>
	<If "%{REQUEST_URI} =~ m#^/_astro/#">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</If>
</IfModule>

# --- Security headers ---
# HSTS: browsers go straight to https:// for a year (no includeSubDomains: mail.ocs.com.ua and
# the other hosts on this server are not ours to commit). The rest stop MIME sniffing, keep the
# site out of other sites' frames, trim the Referer sent to other sites and switch off device
# APIs the site never uses.
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
	Header always set X-Content-Type-Options "nosniff"
	# Only this site and the Plerdy dashboard (heatmaps) may show pages in a frame
	Header always set Content-Security-Policy "frame-ancestors 'self' https://*.plerdy.com"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"
</IfModule>
