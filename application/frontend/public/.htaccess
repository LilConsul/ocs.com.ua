# Send "charset=UTF-8" in the Content-Type header of HTML responses (SEO checkers flag its absence)
AddDefaultCharset UTF-8

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
# Astro emits 50x.astro as 50x/index.html. Name the file explicitly: a bare /50x would make
# mod_dir answer with a 301 redirect instead of the error page.
ErrorDocument 500 /50x/index.html
ErrorDocument 502 /50x/index.html
ErrorDocument 503 /50x/index.html
ErrorDocument 504 /50x/index.html

# --- Permanent redirects (mod_alias; needs AllowOverride FileInfo, same as ErrorDocument) ---
# RedirectMatch runs before Apache maps the URL to a file, so these win over any file in dist.
# Targets end in "/" so mod_dir does not add a second 301.

# Root: send to the default locale (Ukrainian), matching src/pages/index.astro
RedirectMatch 301 ^/$ /ua/

# /{lang}/catalogue has no page of its own: send it to the Header's "Catalogue" target
RedirectMatch 301 ^/(en|ua)/catalogue/?$ /$1/catalogue/equipment/checkweigher/

# /{lang}/catalogue/equipment and /{lang}/catalogue/industry have no index page either:
# send them to the first target the Header uses for "Catalogue" / "Industries"
RedirectMatch 301 ^/(en|ua)/catalogue/equipment/?$ /$1/catalogue/equipment/checkweigher/
RedirectMatch 301 ^/(en|ua)/catalogue/industry/?$ /$1/catalogue/industry/food-beverage/

# Old scheme /{lang}/catalogue/{category}[/{product}] -> /{lang}/catalogue/equipment/...
RedirectMatch 301 ^/(en|ua)/catalogue/(?!(?:equipment|industry)(?:/|$))([^/]+(?:/[^/]+)?)/?$ /$1/catalogue/equipment/$2/
