# DecapCMS Configuration
# Copy this file to .env.local and fill in the actual values

# GitHub OAuth Application Credentials
# Create at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:4321/api/auth/callback/github (dev)
#                             https://ocs.com.ua/api/auth/callback/github (prod)
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# GitHub Repository Configuration
GITHUB_OWNER=LilConsul
GITHUB_REPO=ocs.com.ua
GITHUB_BRANCH=main

# Decap CMS settings (all optional)
# Public site URL used for "View live" links in the CMS
SITE_URL=https://ocs.com.ua
# Host serving /api/auth; defaults to the origin the admin is opened on
# CMS_BASE_URL=http://localhost:4321
# Decap UI language (e.g. en, ua)
CMS_LOCALE=en
