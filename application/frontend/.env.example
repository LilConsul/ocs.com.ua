# Tina CMS Configuration
# For local development, you can leave these empty or use dummy values
# For production, get these from https://tina.io after creating a project

# Tina Cloud Client ID (get from tina.io dashboard)
NEXT_PUBLIC_TINA_CLIENT_ID=

# Tina Cloud Token (get from tina.io dashboard)
TINA_TOKEN=

# Git branch to use (default: main)
TINA_BRANCH=main

# Optional: For deployment
# SSH_PRIVATE_KEY=
# REMOTE_HOST=
# REMOTE_USER=
