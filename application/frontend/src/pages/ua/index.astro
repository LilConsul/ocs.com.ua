---
import Layout from '@/layouts/Layout.astro';

const locale = 'ua';
---

<Layout title="Привіт Світ">
	<main class="min-h-screen flex flex-col items-center justify-center p-8">
		<h1 class="text-4xl font-bold mb-4">Привіт Світ!</h1>
		<p class="text-xl mb-8">Це українська версія сторінки</p>
		<a href="/en" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
			Switch to English
		</a>
	</main>
</Layout>
