---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — Сторінку не знайдено | OS-Technology" description="Сторінку не знайдено">
	<div
		class="mx-auto flex min-h-[70vh] max-w-2xl flex-col items-center justify-center px-6 py-20 text-center"
	>
		<!-- Big Clean 404 Display -->
		<div class="relative mb-2 select-none">
			<span
				class="text-foreground/10 font-mono text-[100px] leading-none font-black tracking-tighter md:text-[140px]"
			>
				404
			</span>
			<div class="absolute inset-0 flex items-center justify-center">
				<span
					class="border-border/80 bg-background/80 text-muted-foreground rounded-full border px-3.5 py-1 font-mono text-xs font-semibold shadow-xs backdrop-blur-md"
				>
					HTTP 404 // NOT FOUND
				</span>
			</div>
		</div>

		<!-- Title -->
		<h1
			id="title-ua"
			class="font-heading text-foreground mb-3 text-2xl font-bold tracking-tight md:text-3xl"
		>
			Сторінку не знайдено
		</h1>
		<h1
			id="title-en"
			class="font-heading text-foreground mb-3 hidden text-2xl font-bold tracking-tight md:text-3xl"
		>
			Page Not Found
		</h1>

		<!-- Description -->
		<p
			id="desc-ua"
			class="text-muted-foreground mb-8 max-w-md text-sm leading-relaxed md:text-base"
		>
			Сторінка, яку ви шукаєте, не існує або була переміщена. Перейдіть до каталогу або на головну
			сторінку.
		</p>
		<p
			id="desc-en"
			class="text-muted-foreground mb-8 hidden max-w-md text-sm leading-relaxed md:text-base"
		>
			The page you are looking for does not exist or has been moved. Explore our catalogue or return
			home.
		</p>

		<!-- Action Buttons -->
		<div class="flex flex-wrap items-center justify-center gap-3">
			<a
				id="btn-home"
				href="/ua"
				class="bg-primary text-primary-foreground inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 text-sm font-medium shadow-xs transition-all hover:opacity-90 active:scale-95"
			>
				<span class="material-symbols-outlined text-[18px]">home</span>
				<span id="btn-home-text">На головну</span>
			</a>

			<a
				id="btn-catalogue"
				href="/ua/catalogue/checkweigher"
				class="border-border bg-background text-foreground hover:bg-muted inline-flex items-center justify-center gap-2 rounded-xl border px-6 py-3 text-sm font-medium shadow-2xs transition-all active:scale-95"
			>
				<span class="material-symbols-outlined text-[18px]">category</span>
				<span id="btn-cat-text">Каталог обладнання</span>
			</a>
		</div>
	</div>
</Layout>

<script>
	const isEn = window.location.pathname.startsWith("/en") || document.referrer.includes("/en");

	if (isEn) {
		document.getElementById("title-ua")?.classList.add("hidden");
		document.getElementById("title-en")?.classList.remove("hidden");

		document.getElementById("desc-ua")?.classList.add("hidden");
		document.getElementById("desc-en")?.classList.remove("hidden");

		const btnHome = document.getElementById("btn-home") as HTMLAnchorElement | null;
		if (btnHome) btnHome.href = "/en";
		const btnHomeText = document.getElementById("btn-home-text");
		if (btnHomeText) btnHomeText.textContent = "Return to Home";

		const btnCat = document.getElementById("btn-catalogue") as HTMLAnchorElement | null;
		if (btnCat) btnCat.href = "/en/catalogue/checkweigher";
		const btnCatText = document.getElementById("btn-cat-text");
		if (btnCatText) btnCatText.textContent = "Browse Catalogue";
	}
</script>
