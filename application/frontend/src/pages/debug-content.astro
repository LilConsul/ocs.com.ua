---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";

const allEquipment = await getCollection("equipment");

// Type guards to differentiate categories from products based on schema
const isCategory = (item: any) => "en-label" in item.data;
const isProduct = (item: any) => "en-title" in item.data;

const categories = allEquipment.filter(isCategory);
const products = allEquipment.filter(isProduct);
---

<Layout title="Debug: Content Collections">
	<div class="max-w-4xl mx-auto p-8">
		<h1 class="text-3xl font-bold mb-6">Content Collection Debug</h1>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold mb-4">Categories ({categories.length})</h2>
			<ul class="list-disc pl-6 space-y-2">
				{
					categories.map((cat) => (
						<li>
							<strong>{cat.id}</strong>
							<ul class="pl-4 text-sm text-gray-600">
								<li>EN: {cat.data["en-label"]}</li>
								<li>UA: {cat.data["ua-label"]}</li>
								<li>Icon: {cat.data.icon || "none"}</li>
								<li>Order: {cat.data.order || "none"}</li>
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold mb-4">Products ({products.length})</h2>
			<ul class="list-disc pl-6 space-y-2">
				{
					products.map((prod) => (
						<li>
							<strong>{prod.id}</strong>
							<ul class="pl-4 text-sm text-gray-600">
								<li>EN: {prod.data["en-title"]}</li>
								<li>UA: {prod.data["ua-title"]}</li>
								<li>Images: {prod.data.gallery?.length || 0}</li>
								<li>Specs: {prod.data.specs?.length || 0}</li>
							</ul>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mb-8">
			<h2 class="text-2xl font-semibold mb-4">Expected Routes</h2>
			<ul class="list-disc pl-6">
				{
					categories.map((cat) => {
						const slug = cat.id; // ID is the slug directly
						return (
							<>
								<li>
									<a
										href={`/en/catalogue/${slug}`}
										class="text-blue-600 hover:underline"
									>
										/en/catalogue/{slug}
									</a>
								</li>
								<li>
									<a
										href={`/ua/catalogue/${slug}`}
										class="text-blue-600 hover:underline"
									>
										/ua/catalogue/{slug}
									</a>
								</li>
							</>
						);
					})
				}
			</ul>
		</section>
	</div>
</Layout>
