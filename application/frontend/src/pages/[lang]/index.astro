---
import { getTranslations } from "@/i18n";
import { languages } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang },
	}));
}

const { lang } = Astro.params;
const t = getTranslations(lang as "en" | "ua");
---

<Layout title={t("site.title")} description={t("site.description")}>
	<!-- Hero Section -->
	<section class="relative flex min-h-180 items-center overflow-hidden">
		<!-- Background Image -->
		<div class="absolute inset-0 z-0">
			<img
				src="/images/main_page.webp"
				alt={t("hero.imageAlt")}
				class="ml-4 h-full w-full object-cover"
				loading="eager"
			/>
		</div>

		<!-- Gradient Overlay - More white on left, less on right -->
		<div class="from-background via-background absolute inset-0 z-10 bg-linear-to-r to-transparent">
		</div>

		<!-- Content -->
		<div class="relative z-20 mx-auto w-full max-w-7xl px-8 py-20">
			<div class="max-w-2xl">
				<!-- Badges -->
				<div class="mb-8 flex flex-wrap items-center gap-3">
					<div
						class="bg-background/90 border-border inline-flex items-center gap-2 rounded-full border px-4 py-1 backdrop-blur-sm"
					>
						<span class="bg-primary h-2 w-2 animate-pulse rounded-full"></span>
						<span
							class="text-muted-foreground font-mono text-[12px] leading-4 font-medium tracking-wider uppercase"
						>
							{t("hero.badge")}
						</span>
					</div>
					<div
						class="bg-background/90 border-border inline-flex items-center gap-2 rounded-full border px-4 py-1 backdrop-blur-sm"
					>
						<span class="bg-primary h-2 w-2 animate-pulse rounded-full"></span>
						<span
							class="text-muted-foreground font-mono text-[12px] leading-4 font-medium tracking-wider uppercase"
						>
							{t("hero.badgeMesutronic")}
						</span>
					</div>
				</div>

				<!-- Title -->
				<h1
					class="font-heading mb-8 text-[40px] leading-12 font-semibold tracking-[-0.02em] md:text-[64px] md:leading-18"
				>
					{t("hero.title")}
					<br />
					<span class="text-muted-foreground">{t("hero.titleHighlight")}</span>
				</h1>

				<!-- Description -->
				<p class="text-muted-foreground mb-12 text-[18px] leading-7">
					{t("hero.description")}
				</p>

				<!-- CTA -->
				<div class="flex flex-col gap-4 sm:flex-row">
					<a
						href={`/${lang}#catalogue`}
						class="bg-primary text-primary-foreground inline-flex items-center justify-center rounded-lg px-8 py-4 font-medium transition-opacity hover:opacity-90"
					>
						{t("hero.exploreCta")}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="ml-2"
						>
							<path d="M5 12h14"></path>
							<path d="m12 5 7 7-7 7"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Stats Section -->
	<section id="about" class="border-border bg-card border-y py-24">
		<div class="mx-auto max-w-7xl px-8">
			<div
				class="divide-border grid grid-cols-1 gap-12 divide-y md:grid-cols-3 md:divide-x md:divide-y-0"
			>
				<div class="flex flex-col items-center pt-8 text-center first:pt-0 md:pt-0">
					<span class="font-heading text-foreground mb-2 text-[36px] leading-11 font-bold">50+</span
					>
					<span
						class="text-muted-foreground font-mono text-[12px] leading-4 font-medium tracking-wider uppercase"
						>{t("stats.clients")}</span
					>
				</div>
				<div class="flex flex-col items-center pt-8 text-center md:pt-0">
					<span class="font-heading text-foreground mb-2 text-[36px] leading-11 font-bold">10+</span
					>
					<span
						class="text-muted-foreground font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase"
						>{t("stats.experience")}</span
					>
				</div>
				<div class="flex flex-col items-center pt-8 text-center md:pt-0">
					<span class="font-heading text-foreground mb-2 text-[36px] leading-[44px] font-bold"
						>500+</span
					>
					<span
						class="text-muted-foreground font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase"
						>{t("stats.installations")}</span
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Features Section -->
	<section id="catalogue" class="mx-auto max-w-[1280px] px-8 py-24">
		<div class="mb-16 text-center">
			<h2
				class="font-heading text-foreground mb-4 text-[36px] leading-[44px] font-medium tracking-tight"
			>
				{t("features.title")}
			</h2>
			<div class="bg-primary mx-auto h-1 w-24 rounded-full"></div>
		</div>

		<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
			<!-- Feature 1 -->
			<div
				class="bg-card border-border group overflow-hidden rounded-xl border transition-all hover:shadow-lg"
			>
				<div class="bg-muted relative flex h-48 items-center justify-center overflow-hidden">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="64"
						height="64"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="text-primary"
					>
						<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
						<circle cx="9" cy="7" r="4"></circle>
						<path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
						<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
					</svg>
				</div>
				<div class="p-8">
					<h3 class="font-heading text-foreground mb-3 text-[28px] leading-[36px] font-medium">
						{t("features.checkweighers.title")}
					</h3>
					<p class="text-muted-foreground mb-6 text-[16px] leading-[24px]">
						{t("features.checkweighers.description")}
					</p>
					<a
						href="#"
						class="text-primary inline-flex items-center gap-2 font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase transition-all hover:gap-3"
					>
						{t("features.technicalDetails")}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 12h14"></path>
							<path d="m12 5 7 7-7 7"></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- Feature 2 -->
			<div
				class="bg-card border-border group overflow-hidden rounded-xl border transition-all hover:shadow-lg"
			>
				<div class="bg-muted relative flex h-48 items-center justify-center overflow-hidden">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="64"
						height="64"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="text-primary"
					>
						<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
						<circle cx="12" cy="12" r="3"></circle>
					</svg>
				</div>
				<div class="p-8">
					<h3 class="font-heading text-foreground mb-3 text-[28px] leading-[36px] font-medium">
						{t("features.xray.title")}
					</h3>
					<p class="text-muted-foreground mb-6 text-[16px] leading-[24px]">
						{t("features.xray.description")}
					</p>
					<a
						href="#"
						class="text-primary inline-flex items-center gap-2 font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase transition-all hover:gap-3"
					>
						{t("features.technicalDetails")}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 12h14"></path>
							<path d="m12 5 7 7-7 7"></path>
						</svg>
					</a>
				</div>
			</div>

			<!-- Feature 3 -->
			<div
				class="bg-card border-border group overflow-hidden rounded-xl border transition-all hover:shadow-lg"
			>
				<div class="bg-muted relative flex h-48 items-center justify-center overflow-hidden">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="64"
						height="64"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="text-primary"
					>
						<rect width="18" height="18" x="3" y="3" rx="2"></rect>
						<path d="M9 8h6"></path>
						<path d="M9 12h6"></path>
						<path d="M9 16h6"></path>
					</svg>
				</div>
				<div class="p-8">
					<h3 class="font-heading text-foreground mb-3 text-[28px] leading-9 font-medium">
						{t("features.metalDetectors.title")}
					</h3>
					<p class="text-muted-foreground mb-6 text-[16px] leading-[24px]">
						{t("features.metalDetectors.description")}
					</p>
					<a
						href="#"
						class="text-primary inline-flex items-center gap-2 font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase transition-all hover:gap-3"
					>
						{t("features.technicalDetails")}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 12h14"></path>
							<path d="m12 5 7 7-7 7"></path>
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact Section -->
	<section id="contact" class="bg-primary text-primary-foreground py-24">
		<div class="mx-auto max-w-[1280px] px-8 text-center">
			<h2
				class="font-heading mb-6 text-[40px] leading-[48px] font-semibold tracking-[-0.02em] md:text-[64px] md:leading-[72px]"
			>
				{t("contact.title")}
			</h2>
			<p class="mx-auto mb-8 max-w-2xl text-[18px] leading-[28px] opacity-90">
				{t("contact.description")}
			</p>
			<a
				href="#"
				class="bg-background text-foreground inline-flex items-center justify-center rounded-lg px-8 py-4 text-[16px] leading-[24px] font-medium transition-opacity hover:opacity-90"
			>
				{t("contact.cta")}
			</a>
		</div>
	</section>
</Layout>
