---
import HeroSection from "@/components/homepage/HeroSection.astro";
import IndustriesSection from "@/components/homepage/IndustriesSection.astro";
import { PartnersSection } from "@/components/homepage/PartnersSection";
import StatsSection from "@/components/homepage/StatsSection.astro";
import partnersData from "@/data/partners.json";
import { getInlineTranslations } from "@/i18n";
import { languages } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang },
	}));
}

const { lang } = Astro.params;
const _ = getInlineTranslations(lang as "en" | "ua");

// Prepare translations for PartnersSection
const partnerTranslations = {
	label: _("Our Clients"),
	title: _("Trusted by Ukraine's Leading Manufacturers"),
	description: _(
		"Supplying and servicing precision weighing equipment for major food, pharmaceutical, and chemical companies since 2013."
	),
	categoryFood: _("Food & Beverage"),
	categoryHousehold: _("Consumer Goods"),
	categoryPharma: _("Pharmaceutical"),
	installations: _("Installations"),
	installationsValue: "300+",
	installationsDescription: _("Systems operating across Ukrainian manufacturing facilities."),
	experience: _("Years of Experience"),
	experienceValue: "10+",
	experienceDescription: _("Technical expertise and service support since 2013."),
	retention: _("Client Retention"),
	retentionValue: "98%",
	retentionDescription: _("Long-term partnerships built on reliable support."),
};
---

<Layout title={_("OS-Technology Ukraine | Checkweighers & Inspection Systems")} description={_("Dynamic checkweighers and Track & Trace systems for food, pharmaceutical, and logistics industries in Ukraine. Official Wipotec partner.")}>
	<HeroSection lang={lang as "en" | "ua"} />
	<StatsSection lang={lang as "en" | "ua"} />
	<IndustriesSection lang={lang as "en" | "ua"} />
	<PartnersSection
		client:load
		partnersByCategory={partnersData}
		translations={partnerTranslations}
		lang={lang as "en" | "ua"}
	/>
</Layout>
