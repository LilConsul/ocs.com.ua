---
import { getTranslations } from "@/i18n";
import { languages } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({
		params: { lang },
	}));
}

const { lang } = Astro.params;
const t = getTranslations(lang as "en" | "ua");
---

<Layout title={t("site.title")} description={t("site.description")}>
	<!-- Hero Section -->
	<section class="relative min-h-180 flex items-center overflow-hidden">
		<!-- Background Image -->
		<div class="absolute inset-0 z-0">
			<img
				src="/images/main_page.webp"
				alt={lang === "ua" ? "Промислове обладнання для контролю якості" : "Industrial quality inspection equipment"}
				class="ml-4 w-full h-full object-cover"
				loading="eager"
			/>
		</div>

		<!-- Gradient Overlay - More white on left, less on right -->
		<div
			class="absolute inset-0 z-10 bg-gradient-to-r from-background via-background to-transparent"
		></div>

		<!-- Content -->
		<div class="relative z-20 max-w-[1280px] mx-auto px-8 w-full py-20">
			<div class="max-w-2xl">
				<!-- Badges -->
				<div class="flex flex-wrap items-center gap-3 mb-8">
					<div
						class="inline-flex items-center gap-2 bg-background/90 backdrop-blur-sm border border-border px-4 py-1 rounded-full"
					>
						<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
						<span
							class="font-mono text-[12px] leading-[16px] tracking-[0.05em] font-medium text-muted-foreground uppercase"
						>
							{t("hero.badge")}
						</span>
					</div>
					<div
						class="inline-flex items-center gap-2 bg-background/90 backdrop-blur-sm border border-border px-4 py-1 rounded-full"
					>
						<span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
						<span
							class="font-mono text-[12px] leading-4 tracking-wider font-medium text-muted-foreground uppercase"
						>
							{t("hero.badgeMesutronic")}
						</span>
					</div>
				</div>

				<!-- Title -->
				<h1
					class="font-heading text-[40px] md:text-[64px] leading-12 md:leading-18 tracking-[-0.02em] font-semibold mb-8"
				>
					{t("hero.title")}
					<br />
					<span class="text-muted-foreground">{t("hero.titleHighlight")}</span>
				</h1>

				<!-- Description -->
				<p class="text-[18px] leading-7 text-muted-foreground mb-12">
					{t("hero.description")}
				</p>

				<!-- CTA -->
				<div class="flex flex-col sm:flex-row gap-4">
					<a
						href={`/${lang}#catalogue`}
						class="inline-flex items-center justify-center px-8 py-4 bg-primary text-primary-foreground rounded-lg font-medium hover:opacity-90 transition-opacity"
					>
						{t("hero.exploreCta")}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="ml-2"
						>
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Stats Section -->
	<section id="about" class="py-24 border-y border-border bg-card">
		<div class="max-w-[1280px] mx-auto px-8">
			<div
				class="grid grid-cols-1 md:grid-cols-3 gap-12 divide-y md:divide-y-0 md:divide-x divide-border"
			>
				<div
					class="flex flex-col items-center text-center pt-8 md:pt-0 first:pt-0"
				>
					<span class="font-heading font-bold text-[36px] leading-[44px] text-foreground mb-2"
						>50+</span
					>
					<span
						class="font-mono text-[12px] leading-[16px] tracking-[0.05em] font-medium text-muted-foreground uppercase"
						>{lang === "ua" ? "Обслужених клієнтів" : "Clients Served"}</span
					>
				</div>
				<div class="flex flex-col items-center text-center pt-8 md:pt-0">
					<span class="font-heading font-bold text-[36px] leading-[44px] text-foreground mb-2"
						>10+</span
					>
					<span
						class="font-mono text-[12px] leading-[16px] tracking-[0.05em] font-medium text-muted-foreground uppercase"
						>{lang === "ua" ? "Років досвіду" : "Years Experience"}</span
					>
				</div>
				<div class="flex flex-col items-center text-center pt-8 md:pt-0">
					<span class="font-heading font-bold text-[36px] leading-[44px] text-foreground mb-2"
						>500+</span
					>
					<span
						class="font-mono text-[12px] leading-[16px] tracking-[0.05em] font-medium text-muted-foreground uppercase"
						>{lang === "ua" ? "Встановлень" : "Installations"}</span
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Features Section -->
	<section id="catalogue" class="py-24 max-w-[1280px] mx-auto px-8">
		<div class="text-center mb-16">
			<h2
				class="font-heading font-medium text-[36px] leading-[44px] text-foreground mb-4 tracking-tight"
			>
				{
					lang === "ua"
						? "Основні технології контролю"
						: "Core Inspection Technologies"
				}
			</h2>
			<div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Feature 1 -->
			<div
				class="bg-card border border-border rounded-xl overflow-hidden group hover:shadow-lg transition-all"
			>
				<div
					class="h-48 bg-muted relative overflow-hidden flex items-center justify-center"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="64"
						height="64"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="text-primary"
					>
						<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
						<circle cx="9" cy="7" r="4" />
						<path d="M22 21v-2a4 4 0 0 0-3-3.87" />
						<path d="M16 3.13a4 4 0 0 1 0 7.75" />
					</svg>
				</div>
				<div class="p-8">
					<h3 class="font-heading font-medium text-[28px] leading-[36px] text-foreground mb-3">
						{lang === "ua" ? "Чекові ваги" : "Checkweighers"}
					</h3>
					<p class="text-[16px] leading-[24px] text-muted-foreground mb-6">
						{
							lang === "ua"
								? "Високошвидкісне, надточне динамічне зважування для суворого контролю якості та сортування."
								: "High-speed, ultra-precise dynamic weighing for rigorous quality control and sorting operations."
						}
					</p>
					<a
						href="#"
						class="font-mono text-[12px] leading-[16px] tracking-[0.05em] font-medium text-primary uppercase inline-flex items-center gap-2 hover:gap-3 transition-all"
					>
						{lang === "ua" ? "Технічні деталі" : "Technical Details"}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</a>
				</div>
			</div>

			<!-- Feature 2 -->
			<div
				class="bg-card border border-border rounded-xl overflow-hidden group hover:shadow-lg transition-all"
			>
				<div
					class="h-48 bg-muted relative overflow-hidden flex items-center justify-center"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="64"
						height="64"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="text-primary"
					>
						<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
						<circle cx="12" cy="12" r="3" />
					</svg>
				</div>
				<div class="p-8">
					<h3 class="font-heading font-medium text-[28px] leading-[36px] text-foreground mb-3">
						{lang === "ua" ? "Рентгенівська інспекція" : "X-Ray Inspection"}
					</h3>
					<p class="text-[16px] leading-[24px] text-muted-foreground mb-6">
						{
							lang === "ua"
								? "Передове виявлення забруднень, здатне ідентифікувати метал, скло, камінь та щільний пластик."
								: "Advanced contaminant detection capable of identifying metal, glass, stone, and dense plastics."
						}
					</p>
					<a
						href="#"
						class="font-mono text-[12px] leading-[16px] tracking-[0.05em] font-medium text-primary uppercase inline-flex items-center gap-2 hover:gap-3 transition-all"
					>
						{lang === "ua" ? "Технічні деталі" : "Technical Details"}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</a>
				</div>
			</div>

			<!-- Feature 3 -->
			<div
				class="bg-card border border-border rounded-xl overflow-hidden group hover:shadow-lg transition-all"
			>
				<div
					class="h-48 bg-muted relative overflow-hidden flex items-center justify-center"
				>
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="64"
						height="64"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="text-primary"
					>
						<rect width="18" height="18" x="3" y="3" rx="2" />
						<path d="M9 8h6" />
						<path d="M9 12h6" />
						<path d="M9 16h6" />
					</svg>
				</div>
				<div class="p-8">
					<h3 class="font-heading font-medium text-[28px] leading-9 text-foreground mb-3">
						{lang === "ua" ? "Металодетектори" : "Metal Detectors"}
					</h3>
					<p class="text-[16px] leading-[24px] text-muted-foreground mb-6">
						{
							lang === "ua"
								? "Надійне багаточастотне сканування для забезпечення абсолютної чистоти продукції та захисту бренду."
								: "Robust multi-frequency scanning to ensure absolute product purity and brand protection."
						}
					</p>
					<a
						href="#"
						class="font-mono text-[12px] leading-[16px] tracking-[0.05em] font-medium text-primary uppercase inline-flex items-center gap-2 hover:gap-3 transition-all"
					>
						{lang === "ua" ? "Технічні деталі" : "Technical Details"}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M5 12h14" />
							<path d="m12 5 7 7-7 7" />
						</svg>
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact Section -->
	<section id="contact" class="py-24 bg-primary text-primary-foreground">
		<div class="max-w-[1280px] mx-auto px-8 text-center">
			<h2 class="font-heading font-semibold text-[40px] md:text-[64px] leading-[48px] md:leading-[72px] tracking-[-0.02em] mb-6">
				{
					lang === "ua"
						? "Готові підвищити рівень вашої виробничої лінії?"
						: "Ready to Elevate Your Production Line?"
				}
			</h2>
			<p class="text-[18px] leading-[28px] opacity-90 mb-8 max-w-2xl mx-auto">
				{
					lang === "ua"
						? "Зв'яжіться з нашою командою продажів, щоб обговорити ваші потреби у точному контролі та отримати індивідуальне рішення."
						: "Contact our sales team to discuss your precision inspection needs and get a customized solution."
				}
			</p>
			<a
				href="#"
				class="inline-flex items-center justify-center px-8 py-4 bg-background text-foreground rounded-lg text-[16px] leading-[24px] font-medium hover:opacity-90 transition-opacity"
			>
				{lang === "ua" ? "Запланувати консультацію" : "Schedule Consultation"}
			</a>
		</div>
	</section>
</Layout>
