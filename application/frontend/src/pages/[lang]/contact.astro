---
import ContactForm from "@/components/contact/ContactForm.astro";
import ContactHero from "@/components/contact/ContactHero.astro";
import ContactInfoCard from "@/components/contact/ContactInfoCard.astro";
import DocumentsCard from "@/components/contact/DocumentsCard.astro";
import OfficeLocation from "@/components/contact/OfficeLocation.astro";
import companyData from "@/data/company.json";
import { getInlineTranslations, getIsoLang, isValidLang, type Lang } from "@/i18n";
import { languages } from "@/i18n/ui";
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
	return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const langParam = Astro.params.lang;
if (!isValidLang(langParam)) {
	return new Response(null, { status: 404 });
}
const lang: Lang = langParam;
const _ = getInlineTranslations(lang);

const siteUrl = Astro.site ?? "https://ocs.com.ua";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;
const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "ContactPage",
		url: currentUrl,
		inLanguage: getIsoLang(lang),
		name: lang === "en" ? "Contact OS-Technology Ukraine" : "Зв'яжіться з ОС-Технолоджи Україна",
		breadcrumb: {
			"@type": "BreadcrumbList",
			itemListElement: [
				{
					"@type": "ListItem",
					position: 1,
					name: lang === "en" ? "Home" : "Головна",
					item: new URL(`/${lang}`, siteUrl).href,
				},
				{
					"@type": "ListItem",
					position: 2,
					name: lang === "en" ? "Contact Us" : "Зв'яжіться з нами",
					item: currentUrl,
				},
			],
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "LocalBusiness",
		name: lang === "en" ? "OS-Technology Ukraine" : "ОС-Технолоджи Україна",
		url: new URL(`/${lang}`, siteUrl).href,
		telephone: companyData.phone,
		email: companyData.email,
		address: {
			"@type": "PostalAddress",
			streetAddress: address.office ? `${address.street}, ${address.office}` : address.street,
			addressLocality: address.city,
			postalCode: address.postalCode,
			addressCountry: "UA",
		},
		openingHoursSpecification: {
			"@type": "OpeningHoursSpecification",
			dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
			opens: "09:00",
			closes: "18:00",
		},
		areaServed: "UA",
	},
];
---

<Layout
	title={_("Contact Us | OS-Technology Ukraine")}
	description={_(
		"Contact the OS-Technology Ukraine engineering team. Request a quotation, arrange a product demonstration, or get technical support."
	)}
>
	{
		structuredData.map((sd) => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(sd)} />
		))
	}

	<ContactHero lang={lang} />

	{/* Muted band: white form and info cards stand out against it */}
	<section
		class="bg-surface-container border-border-subtle/40 w-full border-b py-16 lg:py-24"
		aria-label={_("Send Us a Message")}
	>
		<div class="px-edge-margin mx-auto max-w-7xl">
			{/* Main grid: form (8 cols) + sidebar (4 cols) */}
			<div class="gap-gutter grid grid-cols-1 items-start lg:grid-cols-12">
				<div class="contact-reveal lg:col-span-8" style="--i:0">
					<ContactForm lang={lang} />
				</div>
				<aside class="gap-gutter flex flex-col lg:col-span-4">
					<div class="contact-reveal" style="--i:1">
						<ContactInfoCard lang={lang} />
					</div>
					<div class="contact-reveal" style="--i:2">
						<DocumentsCard lang={lang} />
					</div>
				</aside>
			</div>
		</div>
	</section>

	{/* White band: office card with map, glow in the corner like the About CTA */}
	<section
		class="bg-background relative w-full overflow-hidden py-16 lg:py-24"
		aria-label={_("Main Office")}
	>
		<div
			class="bg-secondary/10 pointer-events-none absolute -bottom-40 -left-24 size-120 rounded-full blur-3xl"
			aria-hidden="true"
		>
		</div>

		<div class="px-edge-margin relative mx-auto max-w-7xl">
			<div class="contact-reveal" style="--i:0">
				<OfficeLocation lang={lang} />
			</div>
		</div>
	</section>
</Layout>

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* Hidden only once the script has confirmed the animation will run */
		.contact-reveal[data-anim="ready"] {
			opacity: 0;
		}
		.contact-reveal[data-anim="in"] {
			animation: contact-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(var(--i, 0) * 120ms);
		}
	}

	@keyframes contact-rise {
		from {
			opacity: 0;
			transform: translateY(22px);
		}
	}
</style>

<script>
	import { revealOnce } from "@/lib/anims/reveal-once";

	document.querySelectorAll<HTMLElement>(".contact-reveal").forEach((el) => revealOnce(el, 0.1));
</script>
