---
import { getCollection } from "astro:content";
import CatalogueSidebar from "@/components/catalogue/CatalogueSidebar.astro";
import CategoryHeader from "@/components/catalogue/CategoryHeader.astro";
import ProductCard from "@/components/catalogue/ProductCard.astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import {
	getLocale,
	getCategory,
	filterByLocale,
	filterByCategory,
	getCategories,
	getProducts,
	sortByOrder,
	type Locale,
} from "@/lib/content-utils";

export const prerender = true;

export async function getStaticPaths() {
	const allEquipment = await getCollection("equipment");

	// Separate categories and products
	const allCategories = getCategories(allEquipment);
	const allProducts = getProducts(allEquipment);

	// Get unique category slugs
	const uniqueCategories = [...new Set(allCategories.map((c) => getCategory(c)))];

	const paths = [];

	for (const categorySlug of uniqueCategories) {
		for (const lang of ["en", "ua"] as Locale[]) {
			// Find category data for this locale
			const categoryEntry = allCategories.find(
				(c) => getCategory(c) === categorySlug && getLocale(c) === lang
			);

			if (!categoryEntry) continue;

			// Get products for this category and locale
			const localeProducts = filterByLocale(allProducts, lang);
			const categoryProducts = filterByCategory(localeProducts, categorySlug);

			// Get all categories for sidebar (in this locale)
			const categoriesForSidebar = filterByLocale(allCategories, lang);

			paths.push({
				params: { lang, category: categorySlug },
				props: {
					categoryData: categoryEntry.data,
					categorySlug,
					products: categoryProducts || [],
					allCategories: categoriesForSidebar || [],
					lang,
				},
			});
		}
	}

	return paths;
}

const { categoryData, categorySlug, products = [], allCategories = [], lang } = Astro.props;
const _ = getInlineTranslations(lang as Lang);

// Sort products and categories by order field
const sortedProducts = Array.isArray(products) ? sortByOrder(products) : [];
const sortedCategories = Array.isArray(allCategories) ? sortByOrder(allCategories) : [];

// Page metadata (clean field names!) - with fallback for missing categoryData
const pageTitle = `${categoryData?.label || "Equipment"} | OS-Technology`;
const pageDescription = categoryData?.description || "";

// Structured data for SEO
const siteUrl = Astro.site || "https://ocs.com.ua";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "CollectionPage",
	name: categoryData?.label || "Equipment",
	description: categoryData?.description || "",
	url: currentUrl,
	inLanguage: lang,
	breadcrumb: {
		"@type": "BreadcrumbList",
		itemListElement: [
			{
				"@type": "ListItem",
				position: 1,
				name: lang === "en" ? "Home" : "Головна",
				item: `${siteUrl}/${lang}/`,
			},
			{
				"@type": "ListItem",
				position: 2,
				name: lang === "en" ? "Catalogue" : "Каталог",
				item: `${siteUrl}/${lang}/catalogue/`,
			},
			{
				"@type": "ListItem",
				position: 3,
				name: categoryData?.label || categorySlug,
				item: currentUrl,
			},
		],
	},
	mainEntity: {
		"@type": "ItemList",
		numberOfItems: sortedProducts.length,
		itemListElement: sortedProducts.map((product, index) => {
			const productSlug = product.id.split("/")[1].replace(/\.(en|ua)$/, "");
			const productUrl = `${siteUrl}/${lang}/catalogue/${categorySlug}/${productSlug}`;
			return {
				"@type": "ListItem",
				position: index + 1,
				url: productUrl,
				name: product.data.title,
				description: product.data.description,
			};
		}),
	},
};
---

<Layout title={pageTitle} description={pageDescription}>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	<!-- Generous container with maximum width constraint -->
	<div class="mx-auto flex max-w-[1600px] gap-8 px-8 py-16">
		<!-- Sidebar Navigation -->
		<CatalogueSidebar
			allCategories={sortedCategories}
			currentCategory={categorySlug}
			lang={lang as Lang}
		/>

		<main class="min-w-0 flex-1">
			<CategoryHeader categoryData={categoryData} lang={lang as Lang} />

			<section aria-label={_("Products")}>
				{
					sortedProducts.length > 0 ? (
						<div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
							{sortedProducts.map((product) => (
								<ProductCard product={product} lang={lang as Lang} />
							))}
						</div>
					) : (
						<div class="text-muted-foreground py-24 text-center">
							<p class="text-lg">{_("No products available in this category")}</p>
						</div>
					)
				}
			</section>

			<div class="h-32"></div>
		</main>
	</div>
</Layout>
