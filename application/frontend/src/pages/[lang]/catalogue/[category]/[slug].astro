---
import { getCollection } from "astro:content";
import { marked } from "marked";
import ProductGallery from "@/components/catalogue/ProductGallery.astro";
import ProductSidebar from "@/components/catalogue/ProductSidebar.astro";
import ProductSpecsTable from "@/components/catalogue/ProductSpecsTable.astro";
import RelatedEquipment from "@/components/catalogue/RelatedEquipment.astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import {
	type EquipmentEntry,
	filterByCategory,
	filterByLocale,
	getCategoriesForLocale,
	getCategory,
	getLocale,
	getProducts,
	getSlug,
	type Locale,
	sortByOrder,
} from "@/lib/content-utils";

export async function getStaticPaths() {
	const allEquipment = await getCollection("equipment");
	const allProducts = getProducts(allEquipment);

	const paths = [];

	for (const product of allProducts) {
		const locale = getLocale(product);
		const category = getCategory(product);
		const slug = getSlug(product);
		const allCategories = getCategoriesForLocale(locale);

		const localeProducts = filterByLocale(allProducts, locale);
		const categoryProducts = filterByCategory(localeProducts, category);
		const relatedProducts = sortByOrder(
			categoryProducts.filter((p) => getSlug(p) !== slug)
		).slice(0, 3);

		paths.push({
			params: { lang: locale, category, slug },
			props: { product, lang: locale, allCategories, relatedProducts },
		});
	}

	return paths;
}

interface Props {
	product: EquipmentEntry;
	lang: Locale;
	allCategories: ReturnType<typeof getCategoriesForLocale>;
	relatedProducts: EquipmentEntry[];
}

const { product, lang, allCategories, relatedProducts = [] } = Astro.props;
const _ = getInlineTranslations(lang as Lang);
const category = getCategory(product);

const title = product.data.title ?? "";
const description = product.data.description ?? "";
const bodyMarkdown = product.body ?? "";
const body = await marked.parse(bodyMarkdown);

const categoryObj = allCategories.find((c) => c.slug === category);
const categoryTitle = categoryObj?.title ?? category;

const siteUrl = Astro.site || "https://ocs.com.ua";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: title,
	description,
	url: currentUrl,
	inLanguage: lang,
	image: product.data.gallery?.[0] ?? undefined,
};
---

<Layout title={`${title} | ${lang === "en" ? "OS-Technology" : "ОС-Технолоджи"}`} description={description} article={true}>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	<div class="mx-auto max-w-container-max px-edge-margin pt-10 pb-section-gap-lg">
		<!-- Breadcrumbs -->
		<nav aria-label={_("Breadcrumb")} class="text-industrial-gray mb-8 flex items-center space-x-2 text-sm font-medium">
			<a href={`/${lang}/catalogue/${category}`} class="hover:text-foreground transition-colors">
				{_("Catalogue")}
			</a>
			<span class="material-symbols-outlined text-[16px]">chevron_right</span>
			<a href={`/${lang}/catalogue/${category}`} class="hover:text-foreground transition-colors">
				{categoryTitle}
			</a>
			<span class="material-symbols-outlined text-[16px]">chevron_right</span>
			<span class="text-foreground font-semibold">{title}</span>
		</nav>

		<!-- 12-Column Grid Layout -->
		<div class="relative grid grid-cols-1 gap-gutter lg:grid-cols-12">
			<!-- Main Content Column (8 Cols) -->
			<div class="space-y-12 lg:col-span-8">
				<!-- Hero Section -->
				<section>
					{
						product.data.industries && product.data.industries.length > 0 && (
							<div class="mb-4 flex flex-wrap gap-2">
								{product.data.industries.map((ind) => (
									<span class="bg-surface-muted text-industrial-gray font-label-caps rounded-md px-2.5 py-1 text-[11px] font-semibold tracking-wider uppercase border border-border-subtle">
										{ind}
									</span>
								))}
							</div>
						)
					}

					<h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-foreground mb-8">
						{title}
					</h1>

					<!-- Interactive Multi-Image Gallery -->
					<div class="mb-8">
						<ProductGallery images={product.data.gallery} title={title} lang={lang as Lang} />
					</div>

					<!-- Overview Lead Text -->
					{
						description && (
							<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl leading-relaxed">
								{description}
							</p>
						)
					}
				</section>

				<!-- Technical Specifications -->
				<ProductSpecsTable specs={product.data.specs} lang={lang as Lang} />

				<!-- Markdown Documentation Body -->
				{
					body && (
						<section class="prose prose-neutral dark:prose-invert max-w-none">
							<div set:html={body} />
						</section>
					)
				}

				<!-- Related Equipment -->
				<RelatedEquipment products={relatedProducts} lang={lang as Lang} />
			</div>

			<!-- Sticky Technical Sales Sidebar (4 Cols) -->
			<ProductSidebar title={title} datasheet={product.data.datasheet} lang={lang as Lang} />
		</div>
	</div>
</Layout>
