---
import { getCollection } from "astro:content";
import { marked } from "marked";
import CatalogueSidebar from "@/components/catalogue/CatalogueSidebar.astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import {
	type EquipmentEntry,
	getCategoriesForLocale,
	getCategory,
	getLocale,
	getProducts,
	getSlug,
	type Locale,
} from "@/lib/content-utils";

export async function getStaticPaths() {
	const allEquipment = await getCollection("equipment");
	const allProducts = getProducts(allEquipment);

	const paths = [];

	for (const product of allProducts) {
		const locale = getLocale(product);
		const category = getCategory(product);
		const slug = getSlug(product);
		const allCategories = getCategoriesForLocale(locale);

		paths.push({
			params: { lang: locale, category, slug },
			props: { product, lang: locale, allCategories },
		});
	}

	return paths;
}

interface Props {
	product: EquipmentEntry;
	lang: Locale;
	allCategories: ReturnType<typeof getCategoriesForLocale>;
}

const { product, lang, allCategories } = Astro.props;
const _ = getInlineTranslations(lang as Lang);
const category = getCategory(product);

const title = product.data.title ?? "";
const description = product.data.description ?? "";
const bodyMarkdown = product.body ?? "";
const body = await marked.parse(bodyMarkdown);

const siteUrl = Astro.site || "https://ocs.com.ua";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: title,
	description,
	url: currentUrl,
	inLanguage: lang,
	image: product.data.gallery?.[0] ?? undefined,
};
---

<Layout title={`${title} | ${lang === "en" ? "OS-Technology" : "ОС-Технолоджи"}`} description={description} article={true}>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	<div class="mx-auto flex max-w-[1600px] gap-8 px-8 py-16">
		<CatalogueSidebar
			allCategories={allCategories}
			currentCategory={category}
			lang={lang as Lang}
		/>

		<main class="min-w-0 flex-1">
			<!-- Breadcrumb -->
			<nav class="text-muted-foreground mb-8 flex items-center gap-2 font-mono text-xs">
				<a href={`/${lang}/catalogue/${category}`} class="hover:text-foreground transition-colors">
					{allCategories.find((c) => c.slug === category)?.title ?? category}
				</a>
				<span class="material-symbols-outlined text-[14px]">chevron_right</span>
				<span class="text-foreground">{title}</span>
			</nav>

			<!-- Header -->
			<header class="mb-10">
				<h1
					class="font-heading text-foreground mb-4 text-4xl leading-tight font-semibold tracking-tight md:text-5xl"
				>
					{title}
				</h1>
				{
					description && (
						<p class="text-muted-foreground max-w-3xl text-sm leading-relaxed md:text-base">
							{description}
						</p>
					)
				}
			</header>

			<!-- Gallery -->
			{
				product.data.gallery && product.data.gallery.length > 0 && (
					<section class="mb-10">
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
							{product.data.gallery.map((img: string) => (
								<div class="bg-background border-border aspect-[4/3] overflow-hidden rounded-lg border">
									<img
										src={img}
										alt={title}
										class="h-full w-full object-contain p-4"
										loading="lazy"
									/>
								</div>
							))}
						</div>
					</section>
				)
			}

			<!-- Specifications -->
			{
				product.data.specs && product.data.specs.length > 0 && (
					<section class="mb-10">
						<h2 class="font-heading text-foreground mb-4 text-xl font-semibold">
							{_("Key Specifications")}
						</h2>
						<div class="border-border divide-border divide-y rounded-lg border">
							{product.data.specs.map((spec: { label: string; value: string }) => (
								<div class="flex items-center justify-between px-4 py-3">
									<span class="text-muted-foreground font-mono text-xs tracking-wider uppercase">
										{spec.label}
									</span>
									<span class="text-foreground font-mono text-sm font-medium">{spec.value}</span>
								</div>
							))}
						</div>
					</section>
				)
			}

			<!-- Industries -->
			{
				product.data.industries && product.data.industries.length > 0 && (
					<section class="mb-10">
						<h2 class="font-heading text-foreground mb-4 text-xl font-semibold">
							{_("Industries")}
						</h2>
						<div class="flex flex-wrap gap-2">
							{product.data.industries.map((industry: string) => (
								<span class="bg-muted text-muted-foreground rounded-full px-3 py-1 font-mono text-xs tracking-wider uppercase">
									{industry}
								</span>
							))}
						</div>
					</section>
				)
			}

			<!-- Body content -->
			{
				body && (
					<section class="mb-10">
						<div class="prose prose-sm max-w-none" set:html={body} />
					</section>
				)
			}

			<!-- Consultation & Inquiry CTA -->
			<section class="border-border bg-card/60 mt-12 rounded-xl border p-6 md:p-8">
				<div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
					<div class="space-y-2">
						<h3 class="font-heading text-foreground text-xl font-semibold">
							{_("Need help choosing the right configuration?")}
						</h3>
						<p class="text-muted-foreground text-sm max-w-xl leading-relaxed">
							{_(
								"Contact our engineering team to get tailored technical specifications, custom integration solutions, and equipment pricing for your production line."
							)}
						</p>
					</div>
					<a
						href={`/${lang}#contact`}
						class="bg-primary text-primary-foreground hover:opacity-90 inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-medium transition-opacity whitespace-nowrap"
					>
						{_("Contact Us")}
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="lucide lucide-arrow-right"
						>
							<path d="M5 12h14"></path>
							<path d="m12 5 7 7-7 7"></path>
						</svg>
					</a>
				</div>
			</section>
		</main>
	</div>
</Layout>
