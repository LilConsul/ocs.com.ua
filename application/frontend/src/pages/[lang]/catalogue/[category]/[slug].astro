---
import { getCollection } from "astro:content";
import { marked } from "marked";
import CatalogueSidebar from "@/components/catalogue/CatalogueSidebar.astro";
import ProductGallery from "@/components/catalogue/ProductGallery.astro";
import ProductSpecsTable from "@/components/catalogue/ProductSpecsTable.astro";
import RelatedEquipment from "@/components/catalogue/RelatedEquipment.astro";
import companyData from "@/data/company.json";
import { getInlineTranslations, getIsoLang, type Lang } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import {
	type EquipmentEntry,
	filterByCategory,
	filterByLocale,
	getCategoriesForLocale,
	getCategory,
	getLocale,
	getProducts,
	getSlug,
	type Locale,
	sortByOrder,
} from "@/lib/content-utils";

export async function getStaticPaths() {
	const allEquipment = await getCollection("equipment");
	const allProducts = getProducts(allEquipment);

	const paths = [];

	for (const product of allProducts) {
		const locale = getLocale(product);
		const category = getCategory(product);
		const slug = getSlug(product);
		const allCategories = getCategoriesForLocale(locale);

		const localeProducts = filterByLocale(allProducts, locale);
		const categoryProducts = filterByCategory(localeProducts, category);
		const relatedProducts = sortByOrder(categoryProducts.filter((p) => getSlug(p) !== slug)).slice(
			0,
			3
		);

		paths.push({
			params: { lang: locale, category, slug },
			props: { product, lang: locale, allCategories, relatedProducts },
		});
	}

	return paths;
}

interface Props {
	product: EquipmentEntry;
	lang: Locale;
	allCategories: ReturnType<typeof getCategoriesForLocale>;
	relatedProducts: EquipmentEntry[];
}

const { product, lang, allCategories, relatedProducts = [] } = Astro.props;
const _ = getInlineTranslations(lang as Lang);
const category = getCategory(product);

const title = product.data.title ?? "";
const description = product.data.description ?? "";
const bodyMarkdown = product.body ?? "";
const body = await marked.parse(bodyMarkdown);

const categoryObj = allCategories.find((c) => c.slug === category);
const categoryTitle = categoryObj?.title ?? category;

const contactPerson =
	companyData.contactPerson[lang as "en" | "ua"] || companyData.contactPerson.en;
const workingHours = companyData.workingHours[lang as "en" | "ua"] || companyData.workingHours.en;

const siteUrl = Astro.site || "https://ocs.com.ua";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

const structuredData = {
	"@context": "https://schema.org",
	"@type": "Product",
	name: title,
	description,
	url: currentUrl,
	inLanguage: getIsoLang(lang as Lang),
	image: product.data.gallery?.[0] ?? undefined,
};
---

<Layout
	title={`${title} | ${lang === "en" ? "OS-Technology" : "ОС-Технолоджи"}`}
	description={description}
	article={true}
>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	<div class="mx-auto flex max-w-[1600px] gap-8 px-8 py-12">
		{/* Left Catalogue Sidebar Navigation */}
		<CatalogueSidebar
			allCategories={allCategories}
			currentCategory={category}
			lang={lang as Lang}
		/>

		{/* Right Product Detail Content */}
		<main class="min-w-0 flex-1 space-y-12">
			{/* Breadcrumb Navigation */}
			<nav
				aria-label={_("Breadcrumb")}
				class="text-muted-foreground flex items-center space-x-2 font-mono text-xs"
			>
				<a href={`/${lang}/catalogue/${category}`} class="hover:text-foreground transition-colors">
					{_("Catalogue")}
				</a>
				<span class="material-symbols-outlined text-[14px]">chevron_right</span>
				<a href={`/${lang}/catalogue/${category}`} class="hover:text-foreground transition-colors">
					{categoryTitle}
				</a>
				<span class="material-symbols-outlined text-[14px]">chevron_right</span>
				<span class="text-foreground font-medium">{title}</span>
			</nav>

			{/* Header & Title */}
			<header>
				<h1
					class="font-heading text-foreground text-3xl font-semibold tracking-tight md:text-4xl lg:text-5xl"
				>
					{title}
				</h1>
			</header>

			{/* Product Hero Grid: Gallery (2/3) + Description & Sales Card (1/3) */}
			<section
				class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12"
				aria-label={_("Product Overview")}
			>
				{/* Left 7 cols: Interactive Gallery */}
				<div class="lg:col-span-7">
					<ProductGallery images={product.data.gallery} title={title} lang={lang as Lang} />
				</div>

				{/* Right 5 cols: Description & Sales Consultation Card */}
				<div class="flex flex-col gap-6 lg:col-span-5">
					{
						description && (
							<p class="text-muted-foreground text-sm leading-relaxed md:text-base">
								{description}
							</p>
						)
					}

					{/* Sticky / Floating Consultation Box */}
					<div
						class="border-border/80 from-card via-card/90 to-muted/20 space-y-5 rounded-2xl border bg-gradient-to-b p-6 shadow-xs"
					>
						<div>
							<h3 class="font-heading text-foreground mb-1.5 text-lg font-semibold">
								{_("Planning to upgrade your production line?")}
							</h3>
							<p class="text-muted-foreground text-xs leading-relaxed">
								{
									_(
										"Our engineering team is ready to configure this equipment for your specific production environment."
									)
								}
							</p>
						</div>

						{/* Direct Technical Sales Contact Info */}
						<div class="border-border/60 space-y-2 border-t pt-4">
							<p
								class="font-label-caps text-muted-foreground text-[10px] font-semibold tracking-wider uppercase"
							>
								{_("Direct Technical Sales")}
							</p>
							{
								contactPerson && (
									<p class="text-foreground text-sm font-medium">{contactPerson.name}</p>
								)
							}
							<div class="flex items-center gap-2">
								<span class="material-symbols-outlined text-primary text-[18px]">call</span>
								<a
									href={`tel:${companyData.phone.replace(/[^\d+]/g, "")}`}
									class="text-foreground hover:text-primary font-mono text-sm font-semibold transition-colors"
								>
									{companyData.phone}
								</a>
							</div>
							{
								companyData.email && (
									<div class="flex items-center gap-2">
										<span class="material-symbols-outlined text-primary text-[18px]">mail</span>
										<a
											href={`mailto:${companyData.email}`}
											class="text-muted-foreground hover:text-primary font-mono text-xs font-medium transition-colors"
										>
											{companyData.email}
										</a>
									</div>
								)
							}
							<p class="text-muted-foreground text-[11px]">
								{workingHours}
							</p>
						</div>

						{/* Action CTAs */}
						<div class="flex flex-col gap-2.5 pt-1">
							<a
								href={`/${lang}/contact`}
								class="bg-primary text-primary-foreground inline-flex w-full items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-medium shadow-xs transition-all hover:opacity-90 active:scale-95"
							>
								{_("Request Consultation")}
								<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
							</a>

							{
								product.data.datasheet && (
									<a
										href={product.data.datasheet}
										target="_blank"
										rel="noopener noreferrer"
										class="border-border bg-background text-foreground hover:bg-muted inline-flex w-full items-center justify-center gap-2 rounded-xl border px-4 py-2.5 text-xs font-medium shadow-2xs transition-all active:scale-95"
									>
										<span class="material-symbols-outlined text-[16px]">download</span>
										{_("Technical Datasheet")}
									</a>
								)
							}
						</div>
					</div>
				</div>
			</section>

			{/* Technical Specifications Table */}
			<ProductSpecsTable specs={product.data.specs} lang={lang as Lang} />

			{/* Markdown Documentation Body */}
			{
				body && (
					<section class="prose prose-neutral dark:prose-invert max-w-none">
						<div set:html={body} />
					</section>
				)
			}

			{/* Related Equipment */}
			<RelatedEquipment products={relatedProducts} lang={lang as Lang} />
		</main>
	</div>
</Layout>
