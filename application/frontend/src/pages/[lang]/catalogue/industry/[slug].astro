---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import CatalogueBand from "@/components/catalogue/CatalogueBand.astro";
import CategoryHeader from "@/components/catalogue/CategoryHeader.astro";
import ProductCard from "@/components/catalogue/ProductCard.astro";
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { productUrl } from "@/lib/catalogue-urls";
import {
	filterByIndustry,
	filterByLocale,
	getCategoriesForLocale,
	getCategory,
	getGallery,
	getIndustriesForLocale,
	getProducts,
	getSlug,
	groupByCategory,
	type Locale,
} from "@/lib/content-utils";
import { collectionPageSchema, createPageGraph } from "@/lib/structured-data";

export async function getStaticPaths() {
	const allProducts = getProducts(await getCollection("equipment"));

	return (["en", "ua"] as Locale[]).flatMap((lang) => {
		const allIndustries = getIndustriesForLocale(lang);
		const allCategories = getCategoriesForLocale(lang);
		const localeProducts = filterByLocale(allProducts, lang);

		return allIndustries.flatMap((industry) => {
			const products = filterByIndustry(localeProducts, industry.slug, allProducts);
			// No empty pages: an industry only gets a route when the locale has a product for it
			if (products.length === 0) return [];

			const galleries = Object.fromEntries(
				products.map((p) => [p.id, getGallery(p, allProducts) ?? []])
			);
			const allGalleries = Object.fromEntries(
				localeProducts.map((p) => [p.id, getGallery(p, allProducts) ?? []])
			);

			return [
				{
					params: { lang, slug: industry.slug },
					props: {
						industry,
						groups: groupByCategory(products, allCategories),
						allCategories,
						allIndustries,
						lang,
						galleries,
						localeProducts,
						allGalleries,
					},
				},
			];
		});
	});
}

const {
	industry,
	groups,
	allCategories,
	allIndustries,
	lang,
	galleries = {},
	localeProducts = [],
	allGalleries = {},
} = Astro.props;
const _ = getInlineTranslations(lang as Lang);

const pageTitle = `${industry.title} | ${companyData.shortName[lang as "en" | "ua"] ?? companyData.shortName.en}`;

const siteUrl = Astro.site || "https://ocs.com.ua";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

// Minimal product index for cross-category search
const productSearchIndex = localeProducts.map((p) => ({
	title: p.data.title ?? "",
	description: p.data.description ?? "",
	url: productUrl(lang as Lang, getCategory(p), getSlug(p)),
	image: (allGalleries as Record<string, ImageMetadata[]>)[p.id]?.[0]?.src ?? "",
}));

// Flat list in the same order the groups are shown
const listedProducts = groups.flatMap((group) => group.products);

const { itemList, subLists } = collectionPageSchema({
	lang: lang as Lang,
	url: currentUrl,
	site: siteUrl,
	title: industry.title,
	description: industry.description,
	items: listedProducts.map((product) => ({
		name: product.data.title ?? "",
		description: product.data.description ?? undefined,
		url: new URL(productUrl(lang as Lang, getCategory(product), getSlug(product)), siteUrl).href,
	})),
	about: {
		"@type": "Specialty",
		name: industry.title,
		description: industry.description,
	},
	keywords: [
		industry.title,
		...groups.map((g) => g.category.title),
		...listedProducts.map((p) => p.data.title).filter(Boolean),
	].join(", "),
	subGroups: groups.map((group) => ({
		name: group.category.title,
		items: group.products.map((product) => ({
			name: product.data.title ?? "",
			description: product.data.description ?? undefined,
			url: new URL(productUrl(lang as Lang, getCategory(product), getSlug(product)), siteUrl).href,
		})),
	})),
});

const structuredData = createPageGraph({
	lang: lang as Lang,
	url: currentUrl,
	site: siteUrl,
	title: pageTitle,
	description: industry.description,
	pageType: "CollectionPage",
	breadcrumbs: [
		{ name: _("Home"), url: new URL(`/${lang}/`, siteUrl).href },
		{ name: industry.title, url: currentUrl },
	],
	mainEntities: [itemList, ...subLists],
});
---

<Layout title={pageTitle} description={industry.description} structuredData={structuredData}>
	<CategoryHeader categoryData={industry} lang={lang as Lang} />

	<CatalogueBand
		allCategories={allCategories}
		allIndustries={allIndustries}
		section="industry"
		activeSlug={industry.slug}
		lang={lang as Lang}
		productSearchIndex={productSearchIndex}
	>
		<section aria-label={_("Products")} class="space-y-12">
			{
				groups.map(({ category, products }, groupIndex) => (
					<section aria-labelledby={`industry-group-${category.slug}`}>
						<h2
							id={`industry-group-${category.slug}`}
							class="font-headline-lg text-foreground mb-6 flex items-center gap-3 text-xl font-semibold tracking-tight"
						>
							<span class="material-symbols-outlined text-secondary text-[22px]" aria-hidden="true">
								{category.icon || "category"}
							</span>
							{category.title}
						</h2>
						<div
							data-product-grid
							class="gap-gutter grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3"
						>
							{products.map((product, index) => (
								<ProductCard
									product={product}
									lang={lang as Lang}
									index={index}
									eager={groupIndex === 0 && index < 3}
									gallery={galleries[product.id]}
								/>
							))}
						</div>
					</section>
				))
			}
		</section>
	</CatalogueBand>
</Layout>
