---
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import CatalogueBand from "@/components/catalogue/CatalogueBand.astro";
import CategoryHeader from "@/components/catalogue/CategoryHeader.astro";
import ProductCard from "@/components/catalogue/ProductCard.astro";
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Layout.astro";
import { productUrl } from "@/lib/catalogue-urls";
import {
	filterByCategory,
	filterByLocale,
	getCategoriesForLocale,
	getCategory,
	getGallery,
	getIndustriesForLocale,
	getProducts,
	getSlug,
	type Locale,
	sortByOrder,
} from "@/lib/content-utils";
import { collectionPageSchema, createPageGraph } from "@/lib/structured-data";

export async function getStaticPaths() {
	const allEquipment = await getCollection("equipment");
	const allProducts = getProducts(allEquipment);

	// Categories are sourced from JSON, not _index entries
	const enCategories = getCategoriesForLocale("en");
	const uaCategories = getCategoriesForLocale("ua");

	const paths = [];

	for (const cat of enCategories) {
		for (const lang of ["en", "ua"] as Locale[]) {
			const localeCategories = lang === "en" ? enCategories : uaCategories;
			const categoryData = localeCategories.find((c) => c.slug === cat.slug);
			if (!categoryData) continue;

			const localeProducts = filterByLocale(allProducts, lang);
			const categoryProducts = filterByCategory(localeProducts, cat.slug);
			const galleries = Object.fromEntries(
				(categoryProducts || []).map((p) => [p.id, getGallery(p, allProducts) ?? []])
			);
			const allGalleries = Object.fromEntries(
				localeProducts.map((p) => [p.id, getGallery(p, allProducts) ?? []])
			);

			paths.push({
				params: { lang, category: cat.slug },
				props: {
					categoryData,
					categorySlug: cat.slug,
					products: categoryProducts || [],
					allCategories: localeCategories,
					allIndustries: getIndustriesForLocale(lang),
					lang,
					galleries,
					localeProducts,
					allGalleries,
				},
			});
		}
	}

	return paths;
}

const {
	categoryData,
	categorySlug,
	products = [],
	allCategories = [],
	allIndustries = [],
	lang,
	galleries = {},
	localeProducts = [],
	allGalleries = {},
} = Astro.props;
const _ = getInlineTranslations(lang as Lang);

// Sort products by order field; categories keep their JSON array order
const sortedProducts = Array.isArray(products) ? sortByOrder(products) : [];
const sortedCategories = Array.isArray(allCategories) ? allCategories : [];

// Minimal product index for cross-category search (title + description + url + first image)
const productSearchIndex = localeProducts.map((p) => ({
	title: p.data.title ?? "",
	description: p.data.description ?? "",
	url: productUrl(lang as Lang, getCategory(p), getSlug(p)),
	image: (allGalleries as Record<string, ImageMetadata[]>)[p.id]?.[0]?.src ?? "",
}));

// Page metadata - with fallback for missing categoryData
const pageTitle = `${categoryData?.title || "Equipment"} | ${companyData.shortName[lang as "en" | "ua"] ?? companyData.shortName.en}`;
const pageDescription = categoryData?.description || "";

// Structured data for SEO
const siteUrl = Astro.site || "https://ocs.com.ua";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

const { itemList } = collectionPageSchema({
	lang: lang as Lang,
	url: currentUrl,
	site: siteUrl,
	title: pageTitle,
	description: pageDescription,
	items: sortedProducts.map((product) => ({
		name: product.data.title ?? "",
		description: product.data.description ?? undefined,
		url: new URL(productUrl(lang as Lang, categorySlug, getSlug(product)), siteUrl).href,
	})),
	about: categoryData
		? {
				"@type": "Thing",
				name: categoryData.title,
				description: categoryData.description,
			}
		: undefined,
	keywords: [categoryData?.title, ...sortedProducts.map((p) => p.data.title).filter(Boolean)]
		.filter(Boolean)
		.join(", "),
});

const structuredData = createPageGraph({
	lang: lang as Lang,
	url: currentUrl,
	site: siteUrl,
	title: pageTitle,
	description: pageDescription,
	pageType: "CollectionPage",
	breadcrumbs: [
		{ name: _("Home"), url: new URL(`/${lang}/`, siteUrl).href },
		{ name: categoryData?.title || categorySlug, url: currentUrl },
	],
	mainEntities: [itemList],
});
---

<Layout title={pageTitle} description={pageDescription} structuredData={structuredData}>
	<CategoryHeader categoryData={categoryData} lang={lang as Lang} />

	<CatalogueBand
		allCategories={sortedCategories}
		allIndustries={allIndustries}
		section="equipment"
		activeSlug={categorySlug}
		lang={lang as Lang}
		productSearchIndex={productSearchIndex}
	>
		<section aria-label={_("Products")}>
			{
				sortedProducts.length > 0 ? (
					<div data-product-grid class="gap-gutter grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
						{sortedProducts.map((product, index) => (
							<ProductCard
								product={product}
								lang={lang as Lang}
								index={index}
								eager={index < 3}
								gallery={galleries[product.id]}
							/>
						))}
					</div>
				) : (
					<div class="text-industrial-gray py-24 text-center">
						<p class="text-lg">{_("No products available in this category")}</p>
					</div>
				)
			}
		</section>
	</CatalogueBand>
</Layout>
