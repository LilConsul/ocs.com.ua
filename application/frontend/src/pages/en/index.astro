---
import Layout from '@/layouts/Layout.astro';

const locale = 'en';
---

<Layout title="Hello World">
	<main class="min-h-screen flex flex-col items-center justify-center p-8">
		<h1 class="text-4xl font-bold mb-4">Hello World!</h1>
		<p class="text-xl mb-8">This is the English version of the page</p>
		<a href="/ua" class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
			Перейти на Українську
		</a>
	</main>
</Layout>
