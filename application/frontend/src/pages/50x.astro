---
import ServerErrorContent from "@/components/errors/ServerErrorContent.astro";
import { defaultLang, getInlineTranslations } from "@/i18n";
import ErrorPageLayout from "@/layouts/ErrorPageLayout.astro";

const _ = getInlineTranslations(defaultLang);
---

<ErrorPageLayout
	title={`5xx | ${_("Something Went Wrong")}`}
	description={_("Something Went Wrong")}
>
	<ServerErrorContent lang="ua" />
	<ServerErrorContent lang="en" />
</ErrorPageLayout>
