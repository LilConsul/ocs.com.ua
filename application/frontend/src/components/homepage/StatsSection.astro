---
import { getInlineTranslations, type Lang } from "@/i18n";
import { formatApprox, type SiteStats } from "@/lib/about/partners-data";

interface Props {
	lang: Lang;
	siteStats: SiteStats;
}

const { lang, siteStats } = Astro.props;
const _ = getInlineTranslations(lang);

const stats = [
	{ value: formatApprox(siteStats.clients), label: _("Clients") },
	{ value: `${siteStats.years}+`, label: _("Years in Ukraine") },
	{ value: formatApprox(siteStats.systems), label: _("Systems Installed") },
];
---

<section class="border-border bg-muted/30 border-y py-24">
	<div class="mx-auto max-w-7xl px-8">
		<div
			class="divide-border grid grid-cols-1 gap-12 divide-y md:grid-cols-3 md:divide-x md:divide-y-0"
		>
			{
				stats.map((stat, index) => (
					<div
						class={`flex flex-col items-center text-center ${index === 0 ? "pt-8 first:pt-0 md:pt-0" : "pt-8 md:pt-0"}`}
					>
						<span class="font-heading text-primary mb-2 text-[36px] leading-[44px] font-bold">
							{stat.value}
						</span>
						<span class="text-muted-foreground font-mono text-[12px] leading-[16px] font-medium tracking-widest uppercase">
							{stat.label}
						</span>
					</div>
				))
			}
		</div>
	</div>
</section>
