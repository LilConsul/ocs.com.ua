---
import { Pill, Sparkles, Utensils, Warehouse } from "@lucide/astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import { industryUrl } from "@/lib/catalogue-urls";
import { getIndustriesForLocale } from "@/lib/content-utils";
import IndustryCard from "./atoms/IndustryCard.astro";
import IndustryCardCTA from "./atoms/IndustryCardCTA.astro";
import IndustryCardSmall from "./atoms/IndustryCardSmall.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const url = (slug: string) => industryUrl(lang, slug);
const firstIndustry = getIndustriesForLocale(lang)[0].slug;
---

<section
	id="industries"
	aria-labelledby="industries-heading"
	class="section-block relative w-full scroll-mt-[calc(6rem+var(--banner-h,0px))] overflow-hidden py-16 lg:py-24"
>
	<div class="px-edge-margin mx-auto max-w-7xl">
		<header class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div>
				<p
					class="font-label-caps text-secondary m-0 flex items-center gap-3 text-xs font-semibold tracking-widest uppercase"
				>
					<span class="eyebrow-rule bg-secondary h-px w-8" aria-hidden="true"></span>
					{_("Industries We Serve")}
				</p>
				<h2
					id="industries-heading"
					class="reveal-heading font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
				>
					{_("Solutions for Every Industry")}
				</h2>
			</div>
			<p
				class="font-body-md text-industrial-gray max-w-lg text-sm leading-relaxed md:text-right lg:max-w-xl"
			>
				{
					_(
						"Checkweighers and inspection systems meeting FDA, IFS, BRC, and GMP standards — engineered for Ukrainian manufacturers."
					)
				}
			</p>
		</header>

		<div class="gap-gutter grid grid-cols-1 md:grid-cols-12">
			<div class="reveal md:col-span-6" style="--i:0">
				<IndustryCard
					title={_("Food & Beverage")}
					description={_(
						"Hygienic checkweighers meeting food safety standards (FDA, IFS, BRC). Built for production lines."
					)}
					icon={Utensils}
					ctaText={_("Learn More")}
					href={url("food-beverage")}
				/>
			</div>

			<div class="reveal md:col-span-6" style="--i:1">
				<IndustryCard
					title={_("Pharmaceutical")}
					description={_(
						"Precision checkweighers with Track & Trace serialization. GMP-compliant and audit-ready."
					)}
					icon={Pill}
					ctaText={_("Learn More")}
					href={url("pharmaceutical")}
				/>
			</div>

			<div class="reveal md:col-span-4" style="--i:2">
				<IndustryCardSmall
					title={_("Cosmetics")}
					description={_("Quality control and filling inspection systems.")}
					icon={Sparkles}
					href={url("cosmetics")}
				/>
			</div>

			<div class="reveal md:col-span-4" style="--i:3">
				<IndustryCardSmall
					title={_("Logistics & Distribution")}
					description={_("High-speed checkweighers for warehouses and fulfillment centers.")}
					icon={Warehouse}
					href={url("logistics")}
				/>
			</div>

			<div class="reveal md:col-span-4" style="--i:4">
				<IndustryCardCTA
					title={_("All Industries")}
					subtitle={_("Explore industry-specific solutions")}
					href={url(firstIndustry)}
				/>
			</div>
		</div>
	</div>
</section>
