---
import { getInlineTranslations } from "@/i18n";
import IndustryCard from "./atoms/IndustryCard.astro";
import IndustryCardCTA from "./atoms/IndustryCardCTA.astro";
import IndustryCardSmall from "./atoms/IndustryCardSmall.astro";

interface Props {
	lang: "en" | "ua";
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);
---

<section class="relative mx-auto max-w-7xl overflow-hidden px-8 py-24 md:py-32">
	<div class="relative z-10 mb-16">
		<div
			class="text-primary font-mono mb-4 flex items-center gap-2 text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase"
		>
			<span class="bg-primary h-[1px] w-8"></span>
			{_("Industries We Serve")}
		</div>
		<div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
			<div class="max-w-2xl">
				<h2
					class="font-heading text-foreground mb-4 text-[32px] leading-[40px] font-semibold tracking-tight md:text-[48px] md:leading-[56px] md:tracking-[-0.02em]"
				>
					{_("Equipment for Every Industry")}
				</h2>
				<p class="text-muted-foreground text-[14px] leading-[22px]">
					{_("Weighing and inspection systems that meet FDA, IFS, BRC, and GMP standards for Ukrainian manufacturers.")}
				</p>
			</div>
		</div>
	</div>

	<div class="bento-grid grid grid-cols-1 gap-6 md:grid-cols-12">
		<!-- Food - Large Card (6 cols) -->
		<div class="md:col-span-6">
			<IndustryCard
				title={_("Food Production")}
				description={_("Hygienic checkweighers and inspection systems for food safety compliance (FDA, IFS, BRC).")}
				icon="utensils"
				ctaText={_("Learn More")}
			/>
		</div>

		<!-- Pharma - Large Card (6 cols) -->
		<div class="md:col-span-6">
			<IndustryCard
				title={_("Pharmaceutical")}
				description={_("Precision weighing and Track & Trace serialization systems for pharma industry compliance.")}
				icon="pill"
				ctaText={_("Learn More")}
			/>
		</div>

		<!-- Cosmetics - Small Card (4 cols) -->
		<div class="md:col-span-4">
			<IndustryCardSmall
				title={_("Cosmetics")}
				description={_("Filling control and quality inspection systems.")}
				icon="sparkles"
			/>
		</div>

		<!-- Logistics - Small Card (4 cols) -->
		<div class="md:col-span-4">
			<IndustryCardSmall
				title={_("Logistics")}
				description={_("High-speed weighing for distribution centers.")}
				icon="warehouse"
			/>
		</div>

		<!-- View All CTA - Small Card (4 cols) -->
		<div class="md:col-span-4">
			<IndustryCardCTA
				title={_("All Industries")}
				subtitle={_("View specialized solutions")}
			/>
		</div>
	</div>
</section>
