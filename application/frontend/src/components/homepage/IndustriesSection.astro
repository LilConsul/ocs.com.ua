---
import { Pill, Sparkles, Utensils, Warehouse } from "lucide-react";
import { getInlineTranslations, type Lang } from "@/i18n";
import IndustryCard from "./atoms/IndustryCard.astro";
import IndustryCardCTA from "./atoms/IndustryCardCTA.astro";
import IndustryCardSmall from "./atoms/IndustryCardSmall.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);
---

<section
	id="industries"
	aria-labelledby="industries-heading"
	class="bg-background w-full scroll-mt-24 py-16 lg:py-24"
>
	<div class="px-edge-margin mx-auto max-w-[1280px]">
		<header class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div>
				<p
					class="font-label-caps text-secondary m-0 flex items-center gap-3 text-xs font-semibold tracking-widest uppercase"
				>
					<span class="bg-secondary h-px w-8" aria-hidden="true"></span>
					{_("Industries We Serve")}
				</p>
				<h2
					id="industries-heading"
					class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
				>
					{_("Solutions for Every Industry")}
				</h2>
			</div>
			<p class="font-body-md text-industrial-gray max-w-md text-sm leading-relaxed md:text-right">
				{
					_(
						"Checkweighers and inspection systems meeting FDA, IFS, BRC, and GMP standards — engineered for Ukrainian manufacturers."
					)
				}
			</p>
		</header>

		<div class="gap-gutter grid grid-cols-1 md:grid-cols-12" data-bento>
			<div class="bento-item md:col-span-6" style="--i:0">
				<IndustryCard
					title={_("Food & Beverage")}
					description={_(
						"Hygienic checkweighers meeting food safety standards (FDA, IFS, BRC). Built for production lines."
					)}
					icon={Utensils}
					ctaText={_("Learn More")}
				/>
			</div>

			<div class="bento-item md:col-span-6" style="--i:1">
				<IndustryCard
					title={_("Pharmaceutical")}
					description={_(
						"Precision checkweighers with Track & Trace serialization. GMP-compliant and audit-ready."
					)}
					icon={Pill}
					ctaText={_("Learn More")}
				/>
			</div>

			<div class="bento-item md:col-span-4" style="--i:2">
				<IndustryCardSmall
					title={_("Cosmetics")}
					description={_("Quality control and filling inspection systems.")}
					icon={Sparkles}
				/>
			</div>

			<div class="bento-item md:col-span-4" style="--i:3">
				<IndustryCardSmall
					title={_("Logistics & Distribution")}
					description={_("High-speed checkweighers for warehouses and fulfillment centers.")}
					icon={Warehouse}
				/>
			</div>

			<div class="bento-item md:col-span-4" style="--i:4">
				<IndustryCardCTA
					title={_("All Industries")}
					subtitle={_("Explore industry-specific solutions")}
				/>
			</div>
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* Hidden only once the script has confirmed the animation will run */
		[data-bento][data-anim="ready"] .bento-item {
			opacity: 0;
		}
		[data-bento][data-anim="in"] .bento-item {
			animation: bento-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(var(--i, 0) * 100ms);
		}
	}

	@keyframes bento-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}
</style>

<script>
	import { revealOnce } from "@/lib/anims/reveal-once";

	const grid = document.querySelector<HTMLElement>("[data-bento]");
	if (grid) revealOnce(grid, 0.15);
</script>
