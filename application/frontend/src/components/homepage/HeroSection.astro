---
import { Image } from "astro:assets";
import { Badge } from "@/components/ui/badge";
import { getTranslations } from "@/i18n";

interface Props {
	lang: "en" | "ua";
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="relative flex min-h-180 items-center overflow-hidden pt-20">
	<!-- Background Image -->
	<div class="absolute inset-0 z-0">
		<div
			class="from-background via-background absolute inset-0 z-10 bg-linear-to-r to-transparent"
		>
		</div>
		<Image
			src="/images/main_page.webp"
			alt={t("hero.imageAlt")}
			class="ml-8 h-full w-full object-cover object-right"
			loading="eager"
			width={1920}
			height={1080}
		/>
	</div>

	<!-- Content -->
	<div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-12 gap-6 px-8">
		<div class="col-span-12 flex flex-col gap-6 md:col-span-8 lg:col-span-7">
			<!-- Badges -->
			<div class="inline-flex w-fit flex-col items-start gap-2.5">
				<Badge
					variant="outline"
					className="border-border bg-background/90 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 backdrop-blur-sm"
				>
					<span class="bg-primary h-2 w-2 animate-pulse rounded-full"></span>
					<span
						class="text-muted-foreground font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase"
					>
						{t("hero.badge")}
					</span>
				</Badge>
				<Badge
					variant="outline"
					className="border-border bg-background/90 inline-flex items-center gap-2 rounded-full border px-4 py-1.5 backdrop-blur-sm"
				>
					<span class="bg-primary h-2 w-2 animate-pulse rounded-full"></span>
					<span
						class="text-muted-foreground font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase"
					>
						{t("hero.badgeMesutronic")}
					</span>
				</Badge>
			</div>

			<!-- Title -->
			<h1
				class="font-heading text-foreground text-[36px] leading-[44px] font-semibold tracking-[-0.02em] md:text-[56px] md:leading-[64px]"
			>
				{t("hero.title")}
				<br />
				<span class="text-muted-foreground">{t("hero.titleHighlight")}</span>
			</h1>

			<!-- Description -->
			<p class="text-muted-foreground max-w-xl text-[15px] leading-[22px]">
				{t("hero.description")}
			</p>

			<!-- CTA Buttons -->
			<div class="flex flex-col gap-3 pt-2 sm:flex-row">
				<a
					href={`/${lang}#contact`}
					class="bg-primary text-primary-foreground inline-flex items-center justify-center gap-2 rounded-lg px-7 py-3.5 text-[15px] leading-[22px] font-medium transition-opacity hover:opacity-90"
				>
					{t("hero.contactSales")}
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="18"
						height="18"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						class="lucide lucide-arrow-right"
					>
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
				<a
					href={`/${lang}#catalogue`}
					class="border-secondary text-secondary hover:bg-secondary/5 inline-flex items-center justify-center gap-2 rounded-lg border-2 px-7 py-3.5 text-[15px] leading-[22px] font-medium transition-colors"
				>
					{t("hero.exploreCta")}
				</a>
			</div>
		</div>
	</div>
</section>
