---
interface Props {
	value: string;
	label: string;
}

const { value, label } = Astro.props;
---

<div class="py-4 text-center">
	<div class="pt-8 md:pt-0">
		<span class="font-heading text-primary mb-2 block text-[36px] leading-11 font-bold">
			{value}
		</span>
		<span
			class="text-muted-foreground font-mono text-[12px] leading-4 font-medium tracking-wider uppercase"
		>
			{label}
		</span>
	</div>
</div>
