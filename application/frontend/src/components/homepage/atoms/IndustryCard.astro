---
import type { LucideIcon } from "lucide-react";
import { Card, CardContent } from "@/components/ui/card";

interface Props {
	title: string;
	description: string;
	icon: LucideIcon;
	ctaText: string;
}

const { title, description, icon: Icon, ctaText } = Astro.props;
---

<Card
	className="bg-card/80 border-border hover:border-primary/50 group relative min-h-[320px] overflow-hidden rounded-xl border p-8 backdrop-blur-xl transition-all duration-500 hover:shadow-xl"
>
	<CardContent className="relative z-10 flex h-full flex-col justify-between p-0">
		<div>
			<div
				class="bg-primary/10 group-hover:bg-primary mb-8 flex h-16 w-16 items-center justify-center rounded-lg transition-colors duration-300"
			>
				<div class="text-primary group-hover:text-primary-foreground h-10 w-10 transition-colors">
					<Icon className="h-10 w-10" />
				</div>
			</div>
			<h3 class="font-heading text-foreground mb-3 text-[20px] leading-[28px] font-medium">
				{title}
			</h3>
			<p class="text-muted-foreground max-w-md text-[14px] leading-[20px]">
				{description}
			</p>
		</div>
		<div
			class="text-primary mt-6 flex items-center gap-2 font-mono text-[12px] leading-[16px] font-medium tracking-[0.05em] uppercase opacity-0 transition-opacity group-hover:opacity-100"
		>
			{ctaText}
		</div>
	</CardContent>
</Card>
