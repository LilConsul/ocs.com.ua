---
import { ArrowRight } from "lucide-react";

interface Props {
	title: string;
	subtitle: string;
	href?: string;
}

const { title, subtitle, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
	href={href}
	class="group/card bg-primary text-primary-foreground focus-visible:outline-secondary flex h-full min-h-32 items-center justify-between gap-4 rounded-xl p-5 shadow-xs transition-[translate,box-shadow,opacity] duration-300 hover:opacity-95 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:hover:-translate-y-0.5 sm:p-6"
>
	<div class="min-w-0">
		<h3 class="font-headline-lg m-0 text-lg font-semibold tracking-tight">{title}</h3>
		<p class="font-body-md text-primary-foreground/80 m-0 mt-1.5 text-sm leading-relaxed">
			{subtitle}
		</p>
	</div>
	<span
		class="border-primary-foreground/30 group-hover/card:bg-primary-foreground/15 shrink-0 rounded-full border p-3 transition-colors duration-300"
		aria-hidden="true"
	>
		<ArrowRight className="size-5 transition-transform duration-200 group-hover/card:translate-x-1" />
	</span>
</Tag>
