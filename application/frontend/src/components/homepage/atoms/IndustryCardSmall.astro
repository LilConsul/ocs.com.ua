---
import type { AstroComponent } from "@lucide/astro";

interface Props {
	title: string;
	description: string;
	icon: AstroComponent;
	href?: string;
}

const { title, description, icon: Icon, href } = Astro.props;
const Tag = href ? "a" : "article";
---

<Tag
	href={href}
	class="group/card bg-surface-container border-border-subtle/70 hover:border-secondary/40 focus-visible:outline-secondary flex h-full items-start gap-4 rounded-xl border p-5 shadow-xs transition-[translate,box-shadow,border-color] duration-300 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:hover:-translate-y-0.5 sm:p-6"
>
	<div
		class="bg-background text-secondary border-border-subtle/50 group-hover/card:bg-secondary group-hover/card:text-background group-hover/card:border-secondary shrink-0 rounded-lg border p-3 transition-colors duration-300"
		aria-hidden="true"
	>
		<Icon class="h-5 w-5" />
	</div>
	<div class="min-w-0">
		<h3 class="font-headline-lg text-foreground m-0 text-base leading-snug font-semibold">
			{title}
		</h3>
		<p class="font-body-md text-industrial-gray m-0 mt-1.5 text-sm leading-relaxed">
			{description}
		</p>
	</div>
</Tag>
