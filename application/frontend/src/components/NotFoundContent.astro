---
import { ArrowRight, House, LayoutGrid } from "lucide-react";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);
---

<section
	data-locale={lang}
	data-title={`404 | ${_("Page Not Found")}`}
	class="relative isolate flex min-h-[75vh] items-center overflow-hidden px-5 py-24 md:px-8 md:py-32"
>
	{/* Technical dot-grid background */}
	<div
		aria-hidden="true"
		class="absolute inset-0 -z-10 bg-[radial-gradient(var(--border)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)] bg-size-[24px_24px]"
	>
	</div>

	<div class="mx-auto flex w-full max-w-3xl flex-col items-center text-center">
		{/* Glass 404 panel: brand glows behind a frosted surface, same treatment as the header */}
		<div aria-hidden="true" class="relative mb-10 select-none">
			<div class="absolute inset-0 -z-10 flex items-center justify-center">
				<span class="bg-secondary/15 absolute -left-4 size-24 rounded-full blur-3xl md:size-32"></span>
				<span class="bg-primary/10 absolute -right-4 size-20 rounded-full blur-3xl md:size-28"></span>
			</div>
			<div
				class="bg-background/60 border-border/60 rounded-2xl border px-8 py-4 shadow-[0_8px_40px_-12px_oklch(0_0_0/0.15)] backdrop-blur-xl md:px-14 md:py-6"
			>
				<p
					class="text-foreground/80 font-mono text-[96px] leading-none font-medium tracking-tighter md:text-[168px]"
				>
					404
				</p>
			</div>
		</div>

		<h1
			class="font-heading text-foreground mb-4 text-[28px] leading-[36px] font-semibold tracking-[-0.02em] md:text-[42px] md:leading-[50px]"
		>
			{_("Page Not Found")}
		</h1>

		<p class="text-muted-foreground mb-6 max-w-xl text-[15px] leading-[22px]">
			{
				_(
					"The page you are looking for does not exist or has been moved. Explore our catalogue or return to the homepage."
				)
			}
		</p>

		<div
			class="border-border-subtle bg-surface-muted mb-10 inline-flex max-w-full items-center gap-3 rounded-lg border px-4 py-2"
		>
			<span class="text-industrial-gray shrink-0 font-mono text-[11px] tracking-[0.05em] uppercase">
				{_("Requested path")}
			</span>
			<code data-requested-path class="text-foreground truncate font-mono text-[13px]">/</code>
		</div>

		<div class="flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
			<a
				href={`/${lang}`}
				class="bg-primary text-primary-foreground inline-flex items-center justify-center gap-2 rounded-lg px-7 py-3.5 text-[15px] leading-[22px] font-medium transition-opacity hover:opacity-90"
			>
				<House className="size-[18px]" strokeWidth={1.5} />
				{_("Back to Home")}
			</a>
			<a
				href={`/${lang}/catalogue/checkweigher`}
				class="border-secondary text-secondary hover:bg-secondary/5 inline-flex items-center justify-center gap-2 rounded-lg border-2 px-7 py-3.5 text-[15px] leading-[22px] font-medium transition-colors"
			>
				<LayoutGrid className="size-[18px]" strokeWidth={1.5} />
				{_("Browse Catalogue")}
			</a>
		</div>

		<p class="text-muted-foreground mt-10 text-[14px] leading-[22px]">
			{_("Need help finding equipment?")}{" "}
			<a
				href={`/${lang}#contact`}
				class="text-foreground group inline-flex items-center gap-1 font-medium underline-offset-4 hover:underline"
			>
				{_("Contact Us")}
				<ArrowRight
					className="size-4 transition-transform group-hover:translate-x-0.5"
					strokeWidth={1.5}
				/>
			</a>
		</p>
	</div>
</section>
