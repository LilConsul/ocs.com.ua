---
import { Image } from "astro:assets";
import { ArrowRight, Clock } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import { getWikiSlug, type WikiEntry } from "@/lib/wiki-utils";

interface Props {
	entry: WikiEntry;
	lang: Lang;
	readMinutes: number;
	coverImage?: ImageMetadata;
	/** Position in the grid, used to stagger the scroll reveal. */
	index?: number;
}

const { entry, lang, readMinutes, coverImage, index = 0 } = Astro.props;
const _ = getInlineTranslations(lang);
const slug = getWikiSlug(entry);
const title = entry.data.title;
const description = entry.data.description;
// coverImage comes from getWikiCoverImage(), which drops a cover missing from src/assets/
const image = coverImage;
---

<a
	href={`/${lang}/wiki/${slug}/`}
	class="card-hover reveal group/card bg-surface-lowest border-border-subtle focus-visible:outline-secondary flex h-full flex-col overflow-hidden rounded-xl border p-5 shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 sm:p-6"
	style={`--i:${index % 3}`}
	data-wiki-item
	data-wiki-text={`${title} ${description ?? ""}`.toLowerCase()}
>
	{
		image && (
			<div class="skeleton border-border-subtle/60 bg-surface-container mb-5 aspect-video w-full overflow-hidden rounded-lg border">
				<Image
					src={image}
					alt={title}
					width={image.width}
					height={image.height}
					widths={[480, 960]}
					sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
					decoding="async"
					loading="lazy"
					class="size-full object-cover transition-transform duration-(--dur-slow) group-hover/card:scale-105"
				/>
			</div>
		)
	}

	<div class="mb-3 flex items-center justify-between gap-3">
		<span
			class="font-technical-data text-industrial-gray inline-flex items-center gap-1.5 text-xs font-medium"
		>
			<Clock class="text-secondary size-3.5" aria-hidden="true" />
			{readMinutes}
			{" " + _("min read")}
		</span>
	</div>

	<h3
		class="font-headline-lg text-foreground group-hover/card:text-secondary m-0 text-lg font-semibold tracking-tight transition-colors"
	>
		{title}
	</h3>

	{
		description && (
			<p class="font-body-md text-industrial-gray m-0 mt-2 line-clamp-3 text-sm leading-relaxed">
				{description}
			</p>
		)
	}

	<span
		class="text-secondary font-technical-data mt-auto inline-flex items-center gap-2 pt-4 text-sm font-semibold"
	>
		{_("Read article")}
		<ArrowRight
			class="size-4 transition-transform duration-(--dur-fast) group-hover/card:translate-x-1"
			aria-hidden="true"
		/>
	</span>
</a>
