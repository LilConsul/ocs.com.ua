---
import { Image } from "astro:assets";
import { ArrowRight, BookOpen } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import { summarize } from "@/lib/featured-equipment";
import { articleExcerpt, getWikiSlug, type WikiEntry } from "@/lib/wiki-utils";

interface Props {
	entry: WikiEntry;
	lang: Lang;
	readMinutes: number;
	coverImage?: ImageMetadata;
	/** Position in the grid, used to stagger the scroll reveal. */
	index?: number;
}

const { entry, lang, readMinutes, coverImage, index = 0 } = Astro.props;
const _ = getInlineTranslations(lang);
const slug = getWikiSlug(entry);
const title = entry.data.title;
const description = entry.data.description;
// Whole sentences, never cut; an article without a description falls back to its first paragraph
const summary = summarize(description?.trim() || articleExcerpt(entry.body), 160);
// Inline code (`d`) is shown as code, not as raw backticks
const summaryParts = summary.split(/`([^`]+)`/);

// Dates are parsed as UTC midnight (YAML dates), so format in UTC to avoid off-by-one days
const updated = entry.data.dateModified ?? entry.data.datePublished;
const updatedIso = updated ? updated.toISOString().slice(0, 10) : undefined;
const updatedText = updated
	? new Intl.DateTimeFormat(lang === "ua" ? "uk-UA" : "en-GB", {
			day: "numeric",
			month: "short",
			year: "numeric",
			timeZone: "UTC",
		}).format(updated)
	: undefined;
---

{/* Four rows shared with the other cards of the grid row (subgrid), so the links line up */}
<a
	href={`/${lang}/wiki/${slug}/`}
	class="card-hover catalogue-trace reveal group bg-background border-border-subtle/70 focus-visible:outline-secondary relative row-span-4 grid grid-rows-subgrid gap-y-0 overflow-hidden rounded-xl border shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2"
	style={`--i:${index % 3}`}
	data-wiki-item
	data-wiki-text={`${title} ${description ?? ""}`.toLowerCase()}
>
	{coverImage ? (
		<div class="skeleton border-border-subtle/40 bg-surface-container aspect-video w-full overflow-hidden border-b">
			<Image
				src={coverImage}
				alt=""
				width={coverImage.width}
				height={coverImage.height}
				widths={[480, 960]}
				sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
				decoding="async"
				loading="lazy"
				class="size-full object-cover"
			/>
		</div>
	) : (
		<div
			class="border-border-subtle/40 bg-surface-container/60 text-industrial-gray/60 flex aspect-video w-full items-center justify-center border-b"
			aria-hidden="true"
		>
			<BookOpen class="size-8" />
		</div>
	)}

	<div class="px-5 pt-5 sm:px-6">
		<p class="font-body-md text-industrial-gray m-0 text-[13px]">
			{readMinutes}
			{" " + _("min read")}
			{updatedText && (
				<>
					<span class="px-1.5" aria-hidden="true">
						/
					</span>
					{_("Updated")} <time datetime={updatedIso}>{updatedText}</time>
				</>
			)}
		</p>
		<h3 class="font-headline-lg text-foreground m-0 mt-2 text-lg leading-snug font-semibold tracking-tight text-pretty">
			{title}
		</h3>
	</div>

	<p class="font-body-md text-industrial-gray m-0 px-5 pt-2.5 text-sm leading-relaxed text-pretty sm:px-6">
		{summaryParts.map((part, i) => (i % 2 === 1 ? <code class="inline-code">{part}</code> : part))}
	</p>

	<div class="text-secondary flex items-end px-5 pt-4 pb-5 text-[15px] font-medium sm:px-6 sm:pb-6">
		<span class="inline-flex items-center gap-2">
			{_("Read article")}
			<ArrowRight
				class="size-4 transition-transform duration-(--dur-fast) group-hover:translate-x-1"
				aria-hidden="true"
			/>
		</span>
	</div>
</a>
