---
import ShareButtons from "@/components/ShareButtons.astro";
import companyData from "@/data/company.json";
import { getInlineTranslations, getLangFromUrl } from "@/i18n";

interface Props {
	// Share links are shown only when the page provides what to share (not on error pages)
	share?: { title: string; description: string };
}

const { share } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const _ = getInlineTranslations(lang);

const currentYear = new Date().getFullYear();
const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;
const phoneHref = `tel:${companyData.phone.replace(/[^\d+]/g, "")}`;
---

<footer class="border-border-subtle bg-background border-t">
	<div class="container mx-auto max-w-7xl px-6">
		{/* Equal outer columns keep the middle block centered on the page (and over the credit row) */}
		<div
			class="text-industrial-gray flex flex-col items-center gap-5 py-8 text-sm xl:grid xl:grid-cols-[1fr_auto_1fr] xl:gap-6 xl:py-6"
		>
			{/* Always rendered so the grid keeps its columns on pages without share links */}
			<div
				class:list={[
					"border-border-subtle/60 w-full justify-center border-b pb-5 xl:w-auto xl:justify-self-start xl:border-0 xl:pb-0",
					share ? "flex" : "hidden xl:block",
				]}
			>
				{share && <ShareButtons title={share.title} description={share.description} />}
			</div>

			<div class="flex flex-col items-center gap-1.5 text-center font-sans text-balance hyphens-none">
				<p>
					&copy; {currentYear}{" "}{companyData.name[lang as "en" | "ua"] ?? companyData.name.en}. {
						_("All rights reserved")
					}.
				</p>
				<address
					class="text-industrial-gray/80 flex flex-wrap items-center justify-center gap-x-3 gap-y-0.5 text-xs not-italic"
				>
					<span>{address.street}, {address.city}, {address.postalCode}, {address.country}</span>
					<span class="hidden size-[3px] rounded-full bg-current opacity-50 sm:block" aria-hidden="true"></span>
					<a href={phoneHref} class="hover:text-foreground whitespace-nowrap transition-colors">
						{companyData.phone}
					</a>
				</address>
			</div>

			<nav class="flex flex-wrap items-center justify-center gap-x-8 gap-y-1 xl:justify-self-end">
				<a
					href={`/${lang}/privacy/`}
					class="hover:text-foreground py-1.5 font-sans whitespace-nowrap transition-colors"
				>
					{_("Privacy Policy")}
				</a>
				<a
					href={`/${lang}/terms/`}
					class="hover:text-foreground py-1.5 font-sans whitespace-nowrap transition-colors"
				>
					{_("Terms of Use")}
				</a>
			</nav>
		</div>

		{/* Credit sits in its own row so it reads as separate from the company details */}
		<div
			class="border-border-subtle/60 text-industrial-gray/70 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 border-t py-4 text-xs"
		>
			<span>{_("Website by")} Denys Shevchenko</span>
			<span class="size-[3px] rounded-full bg-current opacity-50" aria-hidden="true"></span>
			<a
				href="https://www.linkedin.com/in/lilconsul/"
				target="_blank"
				rel="noopener noreferrer author"
				class="hover:text-foreground underline-offset-2 transition-colors hover:underline"
			>
				LinkedIn
			</a>
			<span class="size-[3px] rounded-full bg-current opacity-50" aria-hidden="true"></span>
			<a
				href="https://github.com/LilConsul"
				target="_blank"
				rel="noopener noreferrer author"
				class="hover:text-foreground underline-offset-2 transition-colors hover:underline"
			>
				GitHub
			</a>
		</div>
	</div>
</footer>
