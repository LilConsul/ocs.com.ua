---
import ShareButtons from "@/components/ShareButtons.astro";
import companyData from "@/data/company.json";
import { getInlineTranslations, getLangFromUrl } from "@/i18n";

interface Props {
	// Share links are shown only when the page provides what to share (not on error pages)
	share?: { title: string; description: string };
}

const { share } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const _ = getInlineTranslations(lang);

const currentYear = new Date().getFullYear();
---

<footer class="border-border-subtle bg-background border-t">
	<div class="container mx-auto max-w-7xl px-6">
		<div
			class="text-industrial-gray flex flex-col items-center justify-between gap-5 py-8 text-sm md:flex-row md:gap-4 md:py-6"
		>
			{
				share && (
					<div class="border-border-subtle/60 flex w-full justify-center border-b pb-5 md:w-auto md:border-0 md:pb-0">
						<ShareButtons title={share.title} description={share.description} />
					</div>
				)
			}

			<p class="text-center font-sans text-balance hyphens-none">
				&copy; {currentYear}{" "}{companyData.name[lang as "en" | "ua"] ?? companyData.name.en}. {
					_("All rights reserved")
				}.
			</p>

			<nav class="flex flex-wrap items-center justify-center gap-x-8 gap-y-1">
				<a
					href={`/${lang}/privacy`}
					class="hover:text-foreground py-1.5 font-sans transition-colors"
				>
					{_("Privacy Policy")}
				</a>
				<a href={`/${lang}/terms`} class="hover:text-foreground py-1.5 font-sans transition-colors">
					{_("Terms of Use")}
				</a>
			</nav>
		</div>
	</div>
</footer>
