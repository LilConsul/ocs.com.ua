---
import { Menu } from "lucide-react";

import { LanguageSwitcher } from "@/components/LanguageSwitcher";
import type { NavigationContent } from "@/types/content";

interface Props {
	navigation: NavigationContent["header"];
	currentPath: string;
}

const { navigation, currentPath } = Astro.props;
---

<a
	href="#main-content"
	class="sr-only absolute left-4 top-4 z-[60] bg-background px-4 py-2 text-sm font-medium text-foreground focus:not-sr-only"
>
	Skip to main content
</a>

<header class="sticky top-0 z-50 border-b border-border/70 bg-background/90 backdrop-blur">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4">
		<a href="/" class="flex items-center gap-4" aria-label={navigation.logo.alt}>
			<img
				src={navigation.logo.src}
				alt={navigation.logo.alt}
				class="h-12 w-auto md:h-16"
			/>
		</a>

		<input id="mobile-menu-toggle" type="checkbox" class="peer hidden" />

		<nav class="hidden items-center gap-2 md:flex" aria-label="Primary navigation">
			{
				navigation.menu.map((item) => {
					const isActive = currentPath === item.url;

					return (
						<a
							href={item.url}
							class:list={[
								"inline-flex h-10 items-center border border-transparent px-4 text-sm font-medium transition-colors hover:border-border hover:bg-muted",
								isActive && "border-border bg-muted",
							]}
							aria-current={isActive ? "page" : undefined}
						>
							{item.label}
						</a>
					);
				})
			}
		</nav>

		<div class="hidden items-center gap-3 md:flex">
			<LanguageSwitcher client:load />
		</div>

		<label
			for="mobile-menu-toggle"
			class="inline-flex size-10 cursor-pointer items-center justify-center border border-border md:hidden"
			aria-label="Toggle navigation menu"
		>
			<Menu className="size-5" />
		</label>

		<div class="absolute inset-x-0 top-full hidden border-b border-border/70 bg-background peer-checked:block md:hidden">
			<nav class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-4" aria-label="Mobile navigation">
				{
					navigation.menu.map((item) => {
						const isActive = currentPath === item.url;

						return (
							<a
								href={item.url}
								class:list={[
									"inline-flex min-h-11 items-center border border-transparent px-4 text-sm font-medium transition-colors hover:border-border hover:bg-muted",
									isActive && "border-border bg-muted",
								]}
								aria-current={isActive ? "page" : undefined}
							>
								{item.label}
							</a>
						);
					})
				}
				<div class="pt-2">
					<LanguageSwitcher client:load className="w-full justify-center" />
				</div>
			</nav>
		</div>
	</div>
</header>
