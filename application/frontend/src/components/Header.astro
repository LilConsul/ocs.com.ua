---
import { Mail, MapPin, Menu, Phone, X } from "lucide-react";
import mesutronicLogo from "@/assets/mesutronic-logo.svg";
import wipotecLogo from "@/assets/wipotec-logo.svg";
import { LanguageSwitcher } from "@/components/LanguageSwitcher";
import { Button, buttonVariants } from "@/components/ui/button";
import { ButtonGroup } from "@/components/ui/button-group";
import { cn } from "@/lib/utils";
import type { NavigationContent, SiteConfig } from "@/types/content";

const { navigation, currentPath, siteConfig } = Astro.props;
---

<!-- ================= HEADER ================= -->
<header class="w-full bg-background">

	<!-- TOP HEADER -->
	<div class="border-b border-border">
		<div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-7">

			<!-- BRAND + PARTNERS -->
			<a href="/" class="flex items-start gap-16">

				<!-- BRAND -->
				<div class="flex flex-col gap-1">
					<div class="font-heading text-lg font-semibold tracking-[0.2em] uppercase text-foreground">
						{siteConfig.company.name}
					</div>

					<div class="text-xs text-muted-foreground tracking-wide leading-tight">
						{siteConfig.company.fullName}
					</div>
				</div>

				<!-- PARTNERS -->
				<div class="flex flex-col gap-2">
					<div class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground">
						Partners
					</div>

					<div class="flex items-center gap-7">
						<img src={wipotecLogo.src} alt="Wipotec" class="h-6 w-auto" />
						<img src={mesutronicLogo.src} alt="Mesutronic" class="h-7 w-auto" />
					</div>
				</div>
			</a>


			<!-- RIGHT SIDE -->
			<div class="flex items-start gap-10">

				<!-- CONTACT STACK -->
				<div class="hidden md:flex flex-col text-sm leading-tight gap-2">

					<a href={`tel:${siteConfig.contact.phone}`}
					   class="flex items-center gap-2 text-muted-foreground hover:text-foreground">
						<Phone className="size-4" />
						{siteConfig.contact.phone}
					</a>

					<a href={`mailto:${siteConfig.contact.email}`}
					   class="flex items-center gap-2 text-muted-foreground hover:text-foreground">
						<Mail className="size-4" />
						{siteConfig.contact.email}
					</a>

					<a href={`https://maps.google.com/?q=${encodeURIComponent(
						siteConfig.contact.address.street + ' ' +
						siteConfig.contact.address.city + ' ' +
						siteConfig.contact.address.country
					)}`}
					   target="_blank"
					   class="flex items-center gap-2 text-muted-foreground hover:text-foreground">
						<MapPin className="size-4" />
						{siteConfig.contact.address.city}, {siteConfig.contact.address.country}
					</a>

				</div>

				<!-- LANGUAGE -->
				<div class="hidden md:flex items-center">
					<LanguageSwitcher client:load />
				</div>
			</div>
		</div>
	</div>
</header>

<div id="nav-sentinel"></div>
<div id="sticky-nav"
	class="sticky top-0 z-100 bg-background transition-all duration-200">

	<nav class="mx-auto max-w-7xl px-4 py-3 transition-all duration-200" aria-label="Primary navigation">

		<ButtonGroup className="w-full justify-center transition-all duration-200">

			{navigation.menu.map((item) => {
				const isActive = currentPath === item.url;

				return (
					<Button
						variant={isActive ? "secondary" : "default"}
						size="lg"
						className="flex-1 px-3 py-1.5 text-xs tracking-[0.06em] uppercase transition-all duration-200"
					>
						<a href={item.url} aria-current={isActive ? "page" : undefined}>
							{item.label}
						</a>
					</Button>
				);
			})}

		</ButtonGroup>

	</nav>
</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
	const nav = document.getElementById("sticky-nav");
	const sentinel = document.getElementById("nav-sentinel");

	if (!nav || !sentinel) return;

	const observer = new IntersectionObserver(([entry]) => {
		if (!entry.isIntersecting) {
			nav.classList.add("is-sticky");
		} else {
			nav.classList.remove("is-sticky");
		}
	});

	observer.observe(sentinel);
});
</script>

<style>

#sticky-nav {
	transition: all 200ms ease;
}

#sticky-nav nav {
	transition: padding 200ms ease;
	padding-top: 0.75rem;
	padding-bottom: 0.75rem;
}

#sticky-nav .button-group {
	display: flex !important;
}

#sticky-nav button {
	padding: 0.65rem 1.1rem;
	transition: padding 200ms ease;
}

#sticky-nav button {
	border-right: 1px solid rgba(0, 0, 0, 0.08);
}

#sticky-nav button:last-child {
	border-right: none;
}

#sticky-nav.is-sticky nav {
	padding-top: 0.25rem;
	padding-bottom: 0.25rem;
}

#sticky-nav.is-sticky button {
	padding: 0.3rem 0.7rem;
}

#sticky-nav.is-sticky {
	box-shadow: 0 1px 0 0 rgba(0, 0, 0, 0.15);
}
</style>
