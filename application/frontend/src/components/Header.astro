---
import { Menu, X } from "lucide-react";
import { Button } from "@/components/ui/button";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	currentLang: Lang;
	currentPath?: string;
}

const { currentLang, currentPath } = Astro.props;
// Ensure TypeScript knows this is a Lang, not string | number | symbol
const lang: Lang = currentLang;
const _ = getInlineTranslations(lang);

// Helper to swap language in current path
const getLanguagePath = (targetLang: string) => {
	if (!currentPath) return `/${targetLang}`;
	// Replace the language code at the start of the path
	// e.g., /en/catalogue/checkweigher -> /ua/catalogue/checkweigher
	const pathWithoutLang = currentPath.replace(/^\/(en|ua)/, "");
	return `/${targetLang}${pathWithoutLang}`;
};

const navLinks = [
	{ href: `/${lang}/catalogue/checkweigher`, label: _("Catalogue"), pattern: "/catalogue" },
	{ href: `/${lang}/catalogue`, label: _("Industries"), pattern: "/industries" },
	{ href: `/${lang}/wiki`, label: _("Wiki"), pattern: "/wiki" },
	{ href: `/${lang}/about`, label: _("About Us"), pattern: "/about" },
];

const languageOptions = [
	{ code: "en" as const, name: "English", flag: "🇬🇧" },
	{ code: "ua" as const, name: "Українська", flag: "🇺🇦" },
];

// Helper to check if nav link is active
const isActive = (pattern: string) => {
	if (!currentPath) return false;
	return currentPath.includes(pattern);
};
---

<header
	id="main-header"
	class="bg-background/70 fixed top-0 right-0 left-0 z-50 backdrop-blur-md transition-all duration-300"
	data-scrolled="false"
>
	<!-- Top Development Notice Bar -->
	<aside
		id="dev-notice-banner"
		class="border-b border-amber-500/20 bg-amber-500/10 px-4 py-1.5 text-xs text-amber-950 transition-all duration-300 dark:bg-amber-950/40 dark:text-amber-200"
		role="status"
	>
		<div class="mx-auto flex max-w-[1280px] items-center justify-between gap-3">
			<div class="flex items-center gap-2">
				<span class="inline-block h-2 w-2 animate-pulse rounded-full bg-amber-500"></span>
				<p class="text-[11px] font-medium sm:text-xs">
					{
						_(
							"Website in active development: Information and specifications may not be accurate, pages are still being completed, and all content is subject to change."
						)
					}
				</p>
			</div>
			<button
				type="button"
				id="dev-notice-close"
				class="rounded p-0.5 text-amber-900/70 transition-colors hover:bg-amber-500/20 hover:text-amber-950 dark:text-amber-300/70 dark:hover:text-amber-100"
				aria-label={_("Close notification")}
			>
				<span class="material-symbols-outlined text-[16px]">close</span>
			</button>
		</div>
	</aside>

	<nav class="mx-auto flex h-20 max-w-[1280px] items-center justify-between px-8">
		{/* Logo (per-language SVG) */}
		<a href={`/${lang}`} class="transition-opacity hover:opacity-80">
			<img
				src={`/assets/icons/logo-${lang}.svg`}
				alt={lang === "en" ? "OS-Technology Ukraine" : "ОС-Технолоджи Україна"}
				width="220"
				height="40"
				class="h-8 w-auto md:h-10"
			/>
		</a>

		{/* Desktop Navigation */}
		<div class="hidden items-center gap-8 md:flex">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class={`relative text-sm font-medium transition-colors ${
							isActive(link.pattern)
								? "text-foreground after:bg-primary after:absolute after:right-0 after:bottom-[-8px] after:left-0 after:h-0.5 after:content-['']"
								: "text-muted-foreground hover:text-foreground"
						}`}
					>
						{link.label}
					</a>
				))
			}
		</div>

		{/* Right Side Actions */}
		<div class="flex items-center gap-4">
			{/* Language Switcher - Desktop */}
			<div
				class="bg-muted/50 border-border/50 hidden items-center gap-1 rounded-lg border p-1 md:flex"
			>
				{
					languageOptions.map((langOption) => (
						<a
							href={getLanguagePath(langOption.code)}
							class={`flex items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium transition-all duration-200 ${
								lang === langOption.code
									? "bg-primary text-primary-foreground shadow-sm"
									: "text-muted-foreground hover:text-foreground hover:bg-background/50"
							}`}
						>
							<span class="text-base leading-none">{langOption.flag}</span>
							<span class="font-mono text-xs tracking-wider uppercase">{langOption.code}</span>
						</a>
					))
				}
			</div>

			{/* Mobile Menu Toggle - using shadcn Button */}
			<Button
				variant="ghost"
				size="icon"
				className="md:hidden"
				id="mobile-menu-toggle"
				aria-label={_("Toggle menu")}
			>
				<Menu className="h-5 w-5" id="menu-open-icon" />
				<X className="hidden h-5 w-5" id="menu-close-icon" />
			</Button>
		</div>
	</nav>

	{/* Mobile Menu */}
	<div
		id="mobile-menu"
		class="border-border bg-background/95 hidden border-t backdrop-blur-xl md:hidden"
	>
		<div class="space-y-4 px-8 py-6">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class={`block py-2 text-base font-medium transition-colors ${
							isActive(link.pattern)
								? "text-foreground border-primary border-l-2 pl-3 font-semibold"
								: "text-muted-foreground hover:text-foreground"
						}`}
					>
						{link.label}
					</a>
				))
			}

			<div class="border-border space-y-2 border-t pt-4">
				<div class="text-muted-foreground mb-3 font-mono text-xs uppercase">{_("Language")}</div>
				{
					languageOptions.map((langOption) => (
						<a
							href={getLanguagePath(langOption.code)}
							class={`flex w-full items-center gap-3 rounded-lg px-3 py-2 transition-colors ${
								lang === langOption.code ? "bg-accent text-accent-foreground" : "hover:bg-accent/50"
							}`}
						>
							<span class="text-xl">{langOption.flag}</span>
							<span class="font-medium">{langOption.name}</span>
						</a>
					))
				}
			</div>
		</div>
	</div>
</header>

<script>
	// Scroll effect
	const header = document.getElementById("main-header");

	const handleScroll = () => {
		if (!header) return;

		if (window.scrollY > 10) {
			header.classList.add(
				"bg-background/80",
				"border-b",
				"border-border",
				"shadow-sm",
				"backdrop-blur-xl"
			);
			header.classList.remove("bg-background/70", "backdrop-blur-md");
			header.dataset.scrolled = "true";
		} else {
			header.classList.remove(
				"bg-background/80",
				"border-b",
				"border-border",
				"shadow-sm",
				"backdrop-blur-xl"
			);
			header.classList.add("bg-background/70", "backdrop-blur-md");
			header.dataset.scrolled = "false";
		}
	};

	window.addEventListener("scroll", handleScroll);

	// Development notice banner dismissal
	const devBanner = document.getElementById("dev-notice-banner");
	const devBannerClose = document.getElementById("dev-notice-close");

	if (sessionStorage.getItem("dev_banner_dismissed") === "true") {
		devBanner?.classList.add("hidden");
	}

	devBannerClose?.addEventListener("click", () => {
		devBanner?.classList.add("hidden");
		sessionStorage.setItem("dev_banner_dismissed", "true");
	});

	// Mobile menu toggle
	const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
	const mobileMenu = document.getElementById("mobile-menu");
	const menuOpenIcon = document.getElementById("menu-open-icon");
	const menuCloseIcon = document.getElementById("menu-close-icon");

	mobileMenuToggle?.addEventListener("click", () => {
		const isOpen = !mobileMenu?.classList.contains("hidden");

		if (isOpen) {
			mobileMenu?.classList.add("hidden");
			menuOpenIcon?.classList.remove("hidden");
			menuCloseIcon?.classList.add("hidden");
		} else {
			mobileMenu?.classList.remove("hidden");
			menuOpenIcon?.classList.add("hidden");
			menuCloseIcon?.classList.remove("hidden");
		}
	});

	// Close mobile menu when clicking on a link
	const mobileMenuLinks = mobileMenu?.querySelectorAll("a");
	mobileMenuLinks?.forEach((link) => {
		link.addEventListener("click", () => {
			mobileMenu?.classList.add("hidden");
			menuOpenIcon?.classList.remove("hidden");
			menuCloseIcon?.classList.add("hidden");
		});
	});
</script>
