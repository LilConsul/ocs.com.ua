---
import { Mail, Menu, Phone, X } from "lucide-react";
import mesutronicLogo from "@/assets/mesutronic-logo.svg";
import wipotecLogo from "@/assets/wipotec-logo.svg";
import { LanguageSwitcher } from "@/components/LanguageSwitcher";
import { Button, buttonVariants } from "@/components/ui/button";
import { ButtonGroup } from "@/components/ui/button-group";
import { cn } from "@/lib/utils";
import type { NavigationContent, SiteConfig } from "@/types/content";

interface Props {
	navigation: NavigationContent["header"];
	siteConfig: SiteConfig;
	currentPath: string;
}

const { navigation, currentPath, siteConfig } = Astro.props;
---

<a
	href="#main-content"
	class="sr-only absolute left-4 top-4 z-[60] bg-background px-4 py-2 text-sm font-medium text-foreground focus:not-sr-only"
>
	Skip to main content
</a>

<header class="relative z-40 w-full border-b border-border bg-background">
	<input id="mobile-menu-toggle" type="checkbox" class="peer hidden" />

	<!-- ─── Identity + contact row ─────────────────────────── -->
	<div class="border-b border-border/60 bg-background relative z-30">
		<div class="mx-auto flex max-w-7xl items-start justify-between gap-6 px-4 py-4 md:py-5">

			<!-- Brand name -->
			<a href="/" class="group flex min-w-0 items-center gap-3">
				<div class="min-w-0">
					<div class="font-heading text-lg font-semibold tracking-[0.18em] text-foreground uppercase transition-colors group-hover:text-primary md:text-xl">
						OC-Technology Ukraine
					</div>
					<div class="text-xs text-muted-foreground md:text-sm">
						Industrial equipment solutions
					</div>
				</div>
			</a>

			<!-- Desktop: contacts + logos -->
			<div class="hidden flex-col items-end gap-3 md:flex">
				<div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm">
					<a
						href={`tel:${siteConfig.contact.phone}`}
						class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
					>
						<Phone className="size-4 text-primary" />
						<span>{siteConfig.contact.phone}</span>
					</a>
					<a
						href="mailto:info@ocs.com.ua"
						class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
					>
						<Mail className="size-4 text-primary" />
						<span>info@ocs.com.ua</span>
					</a>
					<LanguageSwitcher client:load />
				</div>
				<div class="flex items-center gap-4">
					<img src={wipotecLogo.src}    alt="Wipotec"    class="h-7 w-auto opacity-90" />
					<img src={mesutronicLogo.src} alt="Mesutronic" class="h-9 w-auto opacity-85" />
				</div>
			</div>

			<!-- Mobile: lang + hamburger -->
			<div class="flex items-center gap-2 md:hidden">
				<LanguageSwitcher client:load />
				<label
					for="mobile-menu-toggle"
					class="inline-flex cursor-pointer rounded-md border border-border bg-card p-2 shadow-sm transition-colors hover:bg-muted"
					aria-label="Toggle navigation"
				>
					<Menu className="size-5 icon-open" />
					<X    className="size-5 icon-close hidden" />
				</label>
			</div>
		</div>

		<!-- Mobile: contacts + logos -->
		<div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 pb-4 md:hidden">
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
				<a href={`tel:${siteConfig.contact.phone}`}
				   class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground">
					<Phone className="size-4 text-primary" />
					<span>{siteConfig.contact.phone}</span>
				</a>
				<a href="mailto:info@ocs.com.ua"
				   class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground">
					<Mail className="size-4 text-primary" />
					<span>info@ocs.com.ua</span>
				</a>
			</div>
			<div class="flex items-center gap-4">
				<img src={wipotecLogo.src}    alt="Wipotec"    class="h-6 w-auto opacity-90" />
				<img src={mesutronicLogo.src} alt="Mesutronic" class="h-8 w-auto opacity-85" />
			</div>
		</div>
	</div>

		<!-- Desktop nav -->
		<div class="hidden w-full py-6 md:flex md:justify-center">
			<nav aria-label="Primary navigation">
				<ButtonGroup className="w-full justify-center shadow-sm">
					{navigation.menu.map((item) => {
						const isActive = currentPath === item.url;
						return (
							<a
								href={item.url}
								aria-current={isActive ? "page" : undefined}
								key={item.url}
								class={cn(
									buttonVariants({ variant: isActive ? "secondary" : "default" }),
									"nav-btn"
								)}
							>
								{item.label}
							</a>
						);
					})}
				</ButtonGroup>
			</nav>
		</div>

		<!-- Mobile nav (checkbox-driven) -->
		<nav class="mx-auto hidden w-full flex-col gap-1 px-3 py-3 peer-checked:flex md:hidden"
		     aria-label="Mobile navigation">
			{navigation.menu.map((item) => {
				const isActive = currentPath === item.url;
				const mobileNavButtonClass = cn(
					buttonVariants({ variant: isActive ? "secondary" : "default", size: "lg" }),
					"mobile-nav-btn"
				);
				return (
					<Button asChild className={mobileNavButtonClass} key={"mobile-" + item.url}>
						<a href={item.url} aria-current={isActive ? "page" : undefined}>
							{item.label}
						</a>
					</Button>
				);
			})}
		</nav>
</header>

<style>
	.nav-btn {
		padding-inline: 2rem;
		min-height: 4.5rem;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-align: center;
		white-space: normal;
	}

	.mobile-nav-btn {
		width: 100%;
		min-height: 3.5rem;
		justify-content: flex-start;
		padding-inline: 1rem;
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		white-space: normal;
	}

	/* ── Hamburger icon swap ─────────────────────────────── */
	#mobile-menu-toggle:checked ~ * .icon-open  { display: none; }
	#mobile-menu-toggle:checked ~ * .icon-close { display: block; }
</style>
