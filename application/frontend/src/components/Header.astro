---
import { Mail, MapPin, Phone } from "lucide-react";
import mesutronicLogo from "@/assets/mesutronic-logo.svg";
import wipotecLogo from "@/assets/wipotec-logo.svg";
import { DesktopNav } from "@/components/DesktopNav";
import { LanguageSwitcher } from "@/components/LanguageSwitcher";
import { MobileMenu } from "@/components/MobileMenu";
import type { NavigationContent, SiteConfig } from "@/types/content";

interface Props {
	navigation: NavigationContent["header"];
	currentPath: string;
	siteConfig: SiteConfig;
}

const { navigation, currentPath, siteConfig } = Astro.props;
---

<header class="w-full bg-background shadow-sm ">

	<!-- TOP HEADER -->
	<div>
		<div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 py-4 sm:py-6 md:py-7">

			<!-- BRAND + PARTNERS -->
			<a href="/" class="flex items-start gap-3 sm:gap-6 lg:gap-12 xl:gap-16 flex-1 min-w-0">

				<!-- BRAND -->
				<div class="flex flex-col gap-0.5 sm:gap-1 min-w-0 shrink-0">
					<div class="font-heading text-xs sm:text-sm lg:text-base xl:text-lg font-semibold tracking-[0.12em] sm:tracking-[0.15em] lg:tracking-[0.2em] uppercase text-foreground whitespace-nowrap">
						{siteConfig.company.name}
					</div>

					<div class="text-[9px] sm:text-[10px] lg:text-xs text-muted-foreground tracking-wide leading-tight hidden sm:block">
						{siteConfig.company.fullName}
					</div>
				</div>

				<!-- PARTNERS -->
				<div class="hidden lg:flex flex-col gap-1.5 xl:gap-2 shrink-0">
					<div class="text-[9px] lg:text-[10px] uppercase tracking-[0.15em] lg:tracking-[0.2em] text-muted-foreground whitespace-nowrap">
						Partners
					</div>

					<div class="flex items-center gap-3 lg:gap-5 xl:gap-7">
						<img src={wipotecLogo.src} alt="Wipotec" class="h-4 lg:h-5 xl:h-6 w-auto opacity-80 hover:opacity-100 transition-opacity" />
						<img src={mesutronicLogo.src} alt="Mesutronic" class="h-5 lg:h-6 xl:h-7 w-auto opacity-80 hover:opacity-100 transition-opacity" />
					</div>
				</div>
			</a>


			<!-- RIGHT SIDE -->
			<div class="flex items-center gap-2 sm:gap-4 lg:gap-6 xl:gap-10 shrink-0">

				<!-- CONTACT STACK -->
				<div class="hidden xl:flex flex-col text-sm leading-tight gap-2">

					<a href={`tel:${siteConfig.contact.phone}`}
					   class="flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors">
						<Phone className="size-4" />
						{siteConfig.contact.phone}
					</a>

					<a href={`mailto:${siteConfig.contact.email}`}
					   class="flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors">
						<Mail className="size-4" />
						{siteConfig.contact.email}
					</a>

					<a href={`https://maps.google.com/?q=${encodeURIComponent(
						siteConfig.contact.address.street + ' ' +
						siteConfig.contact.address.city + ' ' +
						siteConfig.contact.address.country
					)}`}
					   target="_blank"
					   class="flex items-center gap-2 text-muted-foreground hover:text-primary transition-colors">
						<MapPin className="size-4" />
						{siteConfig.contact.address.city}, {siteConfig.contact.address.country}
					</a>

				</div>

				<!-- LANGUAGE SWITCHER -->
				<div class="hidden lg:flex items-center">
					<LanguageSwitcher client:load />
				</div>

				<!-- MOBILE MENU -->
				<div class="lg:hidden">
					<MobileMenu
						navigation={navigation}
						currentPath={currentPath}
						siteConfig={siteConfig}
						client:load
					/>
				</div>
			</div>
		</div>
	</div>
</header>

<div id="nav-sentinel"></div>

<!-- DESKTOP NAVIGATION -->
<div
	id="sticky-nav"
	class="sticky top-0 z-50 border-b border-transparent bg-background/60 backdrop-blur-xl supports-[backdrop-filter]:bg-background/40 transition-all duration-200"
>
	<div class="mx-auto max-w-7xl px-4 sm:px-6 py-3 transition-all duration-200 hidden lg:block">
		<DesktopNav navigation={navigation} currentPath={currentPath} client:load />
	</div>
</div>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
	const nav = document.getElementById("sticky-nav");
	const sentinel = document.getElementById("nav-sentinel");

	if (nav && sentinel) {
		const observer = new IntersectionObserver(([entry]) => {
			if (!entry.isIntersecting) { nav.classList.add("is-sticky"); }
			else { nav.classList.remove("is-sticky");}
		});

		observer.observe(sentinel);
	}
});
</script>

<style>
#sticky-nav {
	transition: all 200ms ease;
}

#sticky-nav > div {
	transition: padding 200ms ease;
}

#sticky-nav.is-sticky > div {
	padding-top: 0.5rem;
	padding-bottom: 0.5rem;
}

button:focus-visible,
a:focus-visible {
	outline: 2px solid hsl(var(--ring));
	outline-offset: 2px;
}
</style>
