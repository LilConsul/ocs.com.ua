---
import { ArrowRight, House, RotateCw } from "lucide-react";
import { getInlineTranslations, type Lang } from "@/i18n";
import ErrorSection from "./ErrorSection.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);
---

<ErrorSection
	lang={lang}
	code="5xx"
	title={_("Something Went Wrong")}
	description={_(
		"The server is temporarily unavailable. Please try again in a few minutes or return to the homepage."
	)}
>
	<Fragment slot="actions">
		<button
			type="button"
			onclick="window.location.reload()"
			class="bg-primary text-primary-foreground inline-flex cursor-pointer items-center justify-center gap-2 rounded-lg px-7 py-3.5 text-[15px] leading-[22px] font-medium transition-opacity hover:opacity-90"
		>
			<RotateCw className="size-[18px]" strokeWidth={1.5} />
			{_("Try Again")}
		</button>
		<a
			href={`/${lang}`}
			class="border-secondary text-secondary hover:bg-secondary/5 inline-flex items-center justify-center gap-2 rounded-lg border-2 px-7 py-3.5 text-[15px] leading-[22px] font-medium transition-colors"
		>
			<House className="size-[18px]" strokeWidth={1.5} />
			{_("Back to Home")}
		</a>
	</Fragment>

	<Fragment slot="footer">
		{_("Still having trouble?")}{" "}
		<a
			href={`/${lang}/contact`}
			class="text-foreground group inline-flex items-center gap-1 font-medium underline-offset-4 hover:underline"
		>
			{_("Contact Us")}
			<ArrowRight
				className="size-4 transition-transform group-hover:translate-x-0.5"
				strokeWidth={1.5}
			/>
		</a>
	</Fragment>
</ErrorSection>
