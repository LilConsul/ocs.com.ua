---
import type { Lang } from "@/i18n";

interface Props {
	lang: Lang;
	/** Large figure in the glass panel, e.g. "404" */
	code: string;
	title: string;
	description: string;
}

const { lang, code, title, description } = Astro.props;
---

<section
	data-locale={lang}
	data-title={`${code} | ${title}`}
	class="relative isolate flex min-h-[75vh] items-center overflow-hidden px-5 py-24 md:px-8 md:py-32"
>
	{/* Technical dot-grid background */}
	<div
		aria-hidden="true"
		class="absolute inset-0 -z-10 bg-[radial-gradient(var(--border)_1px,transparent_1px)] mask-[radial-gradient(ellipse_at_center,black_30%,transparent_75%)] bg-size-[24px_24px]"
	>
	</div>

	<div class="mx-auto flex w-full max-w-3xl flex-col items-center text-center">
		{/* Glass panel: brand glows behind a frosted surface, same treatment as the header */}
		<div aria-hidden="true" class="relative mb-10 select-none">
			<div class="absolute inset-0 -z-10 flex items-center justify-center">
				<span class="bg-secondary/15 absolute -left-4 size-24 rounded-full blur-3xl md:size-32"
				></span>
				<span class="bg-primary/10 absolute -right-4 size-20 rounded-full blur-3xl md:size-28"
				></span>
			</div>
			<div
				class="bg-background/60 border-border/60 rounded-2xl border px-8 py-4 shadow-[0_8px_40px_-12px_oklch(0_0_0/0.15)] backdrop-blur-xl md:px-14 md:py-6"
			>
				<p
					class="text-foreground/80 font-mono text-[96px] leading-none font-medium tracking-tighter md:text-[168px]"
				>
					{code}
				</p>
			</div>
		</div>

		<h1
			class="font-heading text-foreground mb-4 text-[28px] leading-9 font-semibold tracking-[-0.02em] md:text-[42px] md:leading-12.5"
		>
			{title}
		</h1>

		<div class="mb-10 flex flex-col items-center gap-6">
			<p class="text-muted-foreground max-w-xl text-[15px] leading-5.5">{description}</p>
			{/* Optional extra content, e.g. the requested path */}
			<slot />
		</div>

		<div class="flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
			<slot name="actions" />
		</div>

		<p class="text-muted-foreground mt-10 text-[14px] leading-5.5">
			<slot name="footer" />
		</p>
	</div>
</section>
