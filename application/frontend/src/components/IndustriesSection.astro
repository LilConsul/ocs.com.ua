---
import { ArrowRight, Pill, Truck, Utensils } from "lucide-react";

import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import type { HomepageContent } from "@/types/content";

interface Props {
	content: HomepageContent["industries"];
}

const { content } = Astro.props;

const iconMap = {
	utensils: Utensils,
	pill: Pill,
	truck: Truck,
} as const;
---

<section class="py-16 md:py-24">
	<div class="mx-auto max-w-7xl px-4">
		<div class="mx-auto mb-12 max-w-3xl space-y-4 text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">
				Industries
			</p>
			<h2 class="font-heading text-3xl font-semibold md:text-4xl">
				{content.title}
			</h2>
			<p class="text-base text-muted-foreground md:text-lg">
				{content.description}
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
			{
				content.cards.map((card) => {
					const Icon = iconMap[card.icon as keyof typeof iconMap] ?? Utensils;

					return (
						<Card className="h-full border border-border/70 bg-background transition-transform duration-200 hover:-translate-y-1 hover:ring-foreground/20">
							<div class="aspect-[16/10] overflow-hidden border-b border-border/70 bg-muted">
								<img
									src={card.image}
									alt={card.name}
									class="h-full w-full object-cover"
									loading="lazy"
								/>
							</div>
							<CardHeader className="space-y-3">
								<div class="flex items-center gap-3">
									<div class="flex size-12 items-center justify-center border border-border/70 bg-muted text-primary">
										<Icon className="size-6" />
									</div>
									<CardTitle>{card.name}</CardTitle>
								</div>
								<CardDescription>{card.description}</CardDescription>
							</CardHeader>
							<CardContent className="mt-auto">
								<a
									href={card.link}
									class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary/80"
								>
									Learn more
									<ArrowRight className="size-4" />
								</a>
							</CardContent>
						</Card>
					);
				})
			}
		</div>
	</div>
</section>
