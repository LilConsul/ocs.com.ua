---
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;
const contactPerson =
	companyData.contactPerson[lang as "en" | "ua"] ?? companyData.contactPerson.en;
const workingHours = companyData.workingHours[lang as "en" | "ua"] ?? companyData.workingHours.en;
const { street, city, country, postalCode } = companyData.address.en;
const mapsQuery = encodeURIComponent(`${street}, ${city}, ${country} ${postalCode}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const phoneHref = `tel:${companyData.phone.replace(/[^\d+]/g, "")}`;
---

<section class="bg-background border-border-subtle/70 hover:border-secondary/40 before:from-secondary relative space-y-6 overflow-hidden rounded-xl border p-5 shadow-xs transition-[box-shadow,border-color] duration-(--dur-base) before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-linear-to-r before:to-transparent hover:shadow-lg sm:p-8">
	<h2 class="font-label-caps text-secondary flex items-center gap-3 text-xs font-semibold tracking-widest uppercase">
		<span class="eyebrow-rule bg-secondary h-px w-8" aria-hidden="true"></span>
		{_("Contact Information")}
	</h2>

	<dl class="space-y-4">
		{/* Contact person + phone */}
		<div>
			<dt class="font-label-caps text-label-caps text-industrial-gray mb-1 uppercase">
				{_("Phone")}
			</dt>
			<dd class="space-y-1">
				<p class="font-technical-data text-technical-data text-foreground font-semibold wrap-break-word">
					{contactPerson.name}
				</p>
				<a
					href={phoneHref}
					class="font-headline-lg text-foreground hover:text-secondary text-lg font-bold wrap-break-word transition-colors sm:text-2xl"
				>
					{companyData.phone}
				</a>
			</dd>
		</div>

		{/* Email */}
		<div>
			<dt class="font-label-caps text-label-caps text-industrial-gray mb-0.5 flex items-center gap-2 uppercase">
				<span class="material-symbols-outlined text-xl" aria-hidden="true">
					mail
				</span>
				{_("Email")}
			</dt>
			<dd>
				<a
					href={`mailto:${companyData.email}`}
					class="font-technical-data text-technical-data text-foreground hover:text-secondary break-all transition-colors sm:break-normal"
				>
					{companyData.email}
				</a>
			</dd>
		</div>

		{/* Address */}
		<div class="bg-surface-container border-border-subtle/50 font-technical-data text-technical-data text-industrial-gray grid grid-cols-[auto_1fr] grid-rows-[auto_1fr] gap-x-3 gap-y-1 rounded-lg border p-4">
			<dt class="text-foreground col-span-2 col-start-1 row-span-2 row-start-1 grid grid-cols-subgrid grid-rows-subgrid font-medium">
				<a
					href={mapsUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={_("Open in Google Maps")}
					title={_("Open in Google Maps")}
					class="text-secondary hover:text-foreground col-start-1 row-span-2 row-start-1 self-start transition-colors"
				>
					<span class="material-symbols-outlined" aria-hidden="true">
						location_on
					</span>
				</a>
				<span class="col-start-2 row-start-1">{_("Address")}</span>
			</dt>
			<dd class="col-start-2 row-start-2">
				<address class="not-italic">
					{address.street}
					<br />
					{address.office && (
						<>
							{address.office}
							<br />
						</>
					)}
					{address.city}, {address.postalCode}
					<br />
					{address.country}
				</address>
			</dd>
		</div>

		{/* Working hours */}
		<div class="bg-surface-container border-border-subtle/50 font-technical-data text-technical-data text-industrial-gray grid grid-cols-[auto_1fr] grid-rows-[auto_1fr] gap-x-3 gap-y-1 rounded-lg border p-4">
			<dt class="text-foreground col-span-2 col-start-1 row-span-2 row-start-1 grid grid-cols-subgrid grid-rows-subgrid font-medium">
				<span
					class="material-symbols-outlined text-secondary col-start-1 row-span-2 row-start-1 self-start"
					aria-hidden="true"
				>
					schedule
				</span>
				<span class="col-start-2 row-start-1">{_("Working Hours")}</span>
			</dt>
			<dd class="col-start-2 row-start-2">{workingHours}</dd>
		</div>
	</dl>
</section>
