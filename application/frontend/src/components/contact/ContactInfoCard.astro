---
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;
const workingHours = companyData.workingHours[lang as "en" | "ua"] ?? companyData.workingHours.en;
---

<section class="bg-surface-container space-y-6 rounded-xl p-8 shadow-sm">
	<h2 class="font-label-caps text-label-caps text-secondary font-bold uppercase">
		{_("Contact Information")}
	</h2>

	<dl class="space-y-4">
		{/* Phone */}
		<div>
			<dt class="font-label-caps text-label-caps text-industrial-gray mb-1 uppercase">
				{_("Phone")}
			</dt>
			<dd>
				<a
					href={companyData.phone.href}
					class="font-headline-lg text-headline-lg text-foreground hover:text-secondary font-bold transition-colors"
				>
					{companyData.phone.display}
				</a>
			</dd>
		</div>

		{/* Email */}
		<div>
			<dt
				class="font-label-caps text-label-caps text-industrial-gray mb-0.5 flex items-center gap-2 uppercase"
			>
				<span class="material-symbols-outlined text-xl" aria-hidden="true">mail</span>
				{_("Email")}
			</dt>
			<dd>
				<a
					href={`mailto:${companyData.emails.info}`}
					class="font-technical-data text-technical-data text-foreground hover:text-secondary transition-colors"
				>
					{companyData.emails.info}
				</a>
			</dd>
		</div>

		{/* Address */}
		<div>
			<dt
				class="font-label-caps text-label-caps text-industrial-gray mb-0.5 flex items-center gap-2 uppercase"
			>
				<span class="material-symbols-outlined text-xl" aria-hidden="true">location_on</span>
				{_("Address")}
			</dt>
			<dd>
				<address class="font-body-md text-body-md text-foreground not-italic">
					{address.street}<br />{address.city}, {address.postalCode}<br />{address.country}
				</address>
			</dd>
		</div>

		{/* Working hours */}
		<div
			class="bg-surface-container-high font-technical-data text-technical-data text-industrial-gray rounded-lg p-4"
		>
			<dt class="text-foreground mb-1 font-medium">{_("Working Hours")}</dt>
			<dd>{workingHours}</dd>
		</div>
	</dl>
</section>
