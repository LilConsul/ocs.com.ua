---
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;
const contactPerson =
	companyData.contactPerson[lang as "en" | "ua"] ?? companyData.contactPerson.en;
const workingHours = companyData.workingHours[lang as "en" | "ua"] ?? companyData.workingHours.en;
const { street, city, country, postalCode } = companyData.address.en;
const mapsQuery = encodeURIComponent(`${street}, ${city}, ${country} ${postalCode}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const phoneHref = `tel:${companyData.phone.replace(/[^\d+]/g, "")}`;
---

<section class="bg-surface-container space-y-6 rounded-xl p-8 shadow-sm">
	<h2 class="font-label-caps text-label-caps text-secondary font-bold uppercase">
		{_("Contact Information")}
	</h2>

	<dl class="space-y-4">
		{/* Contact person + phone */}
		<div>
			<dt class="font-label-caps text-label-caps text-industrial-gray mb-1 uppercase">
				{_("Phone")}
			</dt>
			<dd class="space-y-1">
				<p class="font-technical-data text-technical-data text-foreground font-semibold">
					{contactPerson.name}
				</p>
				<a
					href={phoneHref}
					class="font-headline-lg text-headline-lg text-foreground hover:text-secondary font-bold transition-colors"
				>
					{companyData.phone}
				</a>
			</dd>
		</div>

		{/* Email */}
		<div>
			<dt
				class="font-label-caps text-label-caps text-industrial-gray mb-0.5 flex items-center gap-2 uppercase"
			>
				<span class="material-symbols-outlined text-xl" aria-hidden="true">mail</span>
				{_("Email")}
			</dt>
			<dd>
				<a
					href={`mailto:${companyData.email}`}
					class="font-technical-data text-technical-data text-foreground hover:text-secondary transition-colors"
				>
					{companyData.email}
				</a>
			</dd>
		</div>

		{/* Address */}
		<div
			class="bg-surface-container-high font-technical-data text-technical-data text-industrial-gray flex items-start gap-3 rounded-lg p-4"
		>
			<a
				href={mapsUrl}
				target="_blank"
				rel="noopener noreferrer"
				aria-label={_("Open in Google Maps")}
				title={_("Open in Google Maps")}
				class="text-secondary hover:text-foreground shrink-0 transition-colors"
			>
				<span class="material-symbols-outlined" aria-hidden="true">location_on</span>
			</a>
			<div>
				<dt class="text-foreground mb-1 font-medium">{_("Address")}</dt>
				<dd>
					<address class="not-italic">
						{address.street}<br />{address.city}, {address.postalCode}<br />{address.country}
					</address>
				</dd>
			</div>
		</div>

		{/* Working hours */}
		<div
			class="bg-surface-container-high font-technical-data text-technical-data text-industrial-gray flex items-start gap-3 rounded-lg p-4"
		>
			<span class="material-symbols-outlined text-secondary shrink-0" aria-hidden="true"
				>schedule</span
			>
			<div>
				<dt class="text-foreground mb-1 font-medium">{_("Working Hours")}</dt>
				<dd>{workingHours}</dd>
			</div>
		</div>
	</dl>
</section>
