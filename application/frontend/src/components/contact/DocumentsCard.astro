---
import documentsData from "@/data/documents.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const documents = [
	{
		icon: "verified_user",
		title: _("Wipotec Authorization Letter"),
		label: _("Authorization Letter — PDF"),
		href: documentsData.wipotec || "#",
	},
	{
		icon: "verified_user",
		title: _("Mesutronic Authorization Letter"),
		label: _("Authorization Letter — PDF"),
		href: documentsData.mesutronic || "#",
	},
];
---

<section
	class="bg-background border-border-subtle/70 hover:border-secondary/40 before:from-secondary relative space-y-4 overflow-hidden rounded-xl border p-5 shadow-xs transition-[box-shadow,border-color] duration-300 before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-linear-to-r before:to-transparent hover:shadow-lg sm:p-8"
>
	<h2 class="font-headline-lg text-foreground text-xl font-semibold tracking-tight break-words">
		{_("Authorized Documentation")}
	</h2>
	<p class="font-body-md text-body-md text-industrial-gray break-words">
		{_("Official distributorship certificates.")}
	</p>
	<ul class="space-y-3 pt-2">
		{
			documents.map((doc) => (
				<li>
					<a
						href={doc.href}
						target={doc.href !== "#" ? "_blank" : undefined}
						rel={doc.href !== "#" ? "noopener noreferrer" : undefined}
						class="group bg-surface-container border-border-subtle/50 hover:border-secondary/40 hover:bg-background focus-visible:outline-secondary flex items-center justify-between gap-3 rounded-lg border p-3.5 transition-[border-color,background-color,box-shadow] hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2"
						aria-label={doc.title}
					>
						<span class="flex min-w-0 items-center gap-3">
							<span class="material-symbols-outlined text-secondary shrink-0" aria-hidden="true">
								{doc.icon}
							</span>
							<span class="min-w-0">
								<span class="font-technical-data text-technical-data text-foreground group-hover:text-secondary block font-semibold transition-colors break-words">
									{doc.title}
								</span>
								<span class="font-label-caps text-label-caps text-industrial-gray uppercase truncate block">
									{doc.label}
								</span>
							</span>
						</span>
						<span
							class="material-symbols-outlined text-industrial-gray group-hover:text-foreground shrink-0 transition-colors"
							aria-hidden="true"
						>
							download
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>
