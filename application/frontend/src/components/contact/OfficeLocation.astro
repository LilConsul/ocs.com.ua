---
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;
const workingHours = companyData.workingHours[lang as "en" | "ua"] ?? companyData.workingHours.en;
const mapsQuery = encodeURIComponent("67 Beresteiskyi Ave, Kyiv, Ukraine 03062");
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapsQuery}`;
// Keyless embed — works without a Maps API key
const embedUrl = `https://maps.google.com/maps?q=${mapsQuery}&output=embed`;
---

<section class="bg-surface-container overflow-hidden rounded-xl shadow-sm">
	<div class="grid grid-cols-1 lg:grid-cols-12">
		{/* Address panel */}
		<div class="flex flex-col justify-between gap-8 p-8 lg:col-span-5">
			<div class="space-y-6">
				<header class="space-y-1">
					<p class="font-label-caps text-label-caps text-secondary font-bold uppercase">
						{_("Kyiv Office")}
					</p>
					<h2 class="font-headline-lg text-headline-lg text-foreground font-bold">
						{_("Main Office")}
					</h2>
				</header>

				<dl class="space-y-4">
					<div
						class="bg-surface-container-high font-technical-data text-technical-data text-industrial-gray flex items-start gap-3 rounded-lg p-4"
					>
						<span class="material-symbols-outlined text-secondary shrink-0" aria-hidden="true"
							>location_on</span
						>
						<div>
							<dt class="text-foreground mb-1 font-medium">{_("Address")}</dt>
							<dd>
								<address class="not-italic">
									{address.street}<br />{address.city}, {address.postalCode}<br />{address.country}
								</address>
							</dd>
						</div>
					</div>

					<div
						class="bg-surface-container-high font-technical-data text-technical-data text-industrial-gray flex items-start gap-3 rounded-lg p-4"
					>
						<span class="material-symbols-outlined text-secondary shrink-0" aria-hidden="true"
							>schedule</span
						>
						<div>
							<dt class="text-foreground mb-1 font-medium">{_("Working Hours")}</dt>
							<dd>{workingHours}</dd>
						</div>
					</div>
				</dl>
			</div>

			<a
				href={routeUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="bg-foreground font-technical-data text-technical-data text-background inline-flex items-center justify-center gap-2 self-start rounded-lg px-5 py-2.5 font-medium transition-opacity hover:opacity-90"
			>
				<span class="material-symbols-outlined text-sm" aria-hidden="true">directions</span>
				{_("Get Route")}
			</a>
		</div>

		{/* Map */}
		<figure class="relative m-0 min-h-[320px] lg:col-span-7 lg:min-h-[420px]">
			<iframe
					src={embedUrl}
					title={_("Map showing OS-Technology Ukraine office location")}
					width="100%"
					height="100%"
					class="absolute inset-0 h-full w-full"
					style="border:0;"
					loading="lazy"
					referrerpolicy="no-referrer-when-downgrade"
					allow="storage-access"></iframe>
		</figure>
	</div>
</section>
