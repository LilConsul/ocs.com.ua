---
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;
const workingHours = companyData.workingHours[lang as "en" | "ua"] ?? companyData.workingHours.en;
const { street, city, country, postalCode } = companyData.address.en;
const mapsQuery = encodeURIComponent(`${street}, ${city}, ${country} ${postalCode}`);
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapsQuery}`;
// Keyless embed — works without a Maps API key
const embedUrl = `https://maps.google.com/maps?q=${mapsQuery}&output=embed`;
---

<section
	class="bg-surface-container border-border-subtle/70 before:from-secondary relative overflow-hidden rounded-xl border shadow-xs before:absolute before:inset-x-0 before:top-0 before:z-10 before:h-0.5 before:bg-linear-to-r before:to-transparent"
>
	<div class="grid grid-cols-1 lg:grid-cols-12">
		{/* Address panel */}
		<div class="flex flex-col justify-between gap-8 p-6 sm:p-8 lg:col-span-5">
			<div class="space-y-6">
				<header>
					<p class="font-label-caps text-secondary text-xs font-semibold tracking-widest uppercase">
						{_("Kyiv Office")}
					</p>
					<h2
						class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight sm:text-3xl"
					>
						{_("Main Office")}
					</h2>
				</header>

				<dl class="space-y-4">
					<div
						class="bg-background border-border-subtle/50 font-technical-data text-technical-data text-industrial-gray flex items-start gap-3 rounded-lg border p-4"
					>
						<span class="material-symbols-outlined text-secondary shrink-0" aria-hidden="true"
							>location_on</span
						>
						<div>
							<dt class="text-foreground mb-1 font-medium">{_("Address")}</dt>
							<dd>
								<address class="not-italic">
									{address.street}<br />
									{address.office && <>{address.office}<br /></>}
									{address.city}, {address.postalCode}<br />{address.country}
								</address>
							</dd>
						</div>
					</div>

					<div
						class="bg-background border-border-subtle/50 font-technical-data text-technical-data text-industrial-gray flex items-start gap-3 rounded-lg border p-4"
					>
						<span class="material-symbols-outlined text-secondary shrink-0" aria-hidden="true"
							>schedule</span
						>
						<div>
							<dt class="text-foreground mb-1 font-medium">{_("Working Hours")}</dt>
							<dd>{workingHours}</dd>
						</div>
					</div>
				</dl>
			</div>

			<a
				href={routeUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="border-secondary text-secondary hover:bg-secondary/5 focus-visible:outline-secondary font-technical-data inline-flex items-center justify-center gap-2 self-start rounded-lg border-2 px-6 py-3 text-[15px] leading-[22px] font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
			>
				<span class="material-symbols-outlined text-base" aria-hidden="true">directions</span>
				{_("Get Route")}
			</a>
		</div>

		{/* Map */}
		<figure
			class="border-border-subtle/60 relative m-0 min-h-[320px] border-t lg:col-span-7 lg:min-h-[420px] lg:border-t-0 lg:border-l"
		>
			<iframe
				src={embedUrl}
				title={_("Map showing OS-Technology Ukraine office location")}
				width="100%"
				height="100%"
				class="absolute inset-0 h-full w-full"
				style="border:0;"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allow="storage-access"></iframe>
		</figure>
	</div>
</section>
