---
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const address = companyData.address[lang as "en" | "ua"] ?? companyData.address.en;
const mapsQuery = encodeURIComponent("67 Beresteiskyi Ave, Kyiv, Ukraine 03062");
const routeUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapsQuery}`;
// Keyless embed URL; no API key is configured for the Maps Embed API yet
const embedUrl = `https://maps.google.com/maps?q=${mapsQuery}&output=embed`;
---

<section class="bg-surface-container overflow-hidden rounded-xl shadow-md">
	<div class="grid grid-cols-1 lg:grid-cols-12">
		{/* Address panel */}
		<div class="bg-surface-container flex flex-col justify-between p-8 lg:col-span-5">
			<div class="space-y-6">
				<header>
					<p class="font-label-caps text-label-caps text-secondary font-bold uppercase">
						{_("Kyiv Office")}
					</p>
					<h2 class="font-heading text-foreground mt-1 text-2xl font-bold">{_("Main Office")}</h2>
				</header>
				<div class="flex items-start gap-3">
					<span class="material-symbols-outlined text-secondary mt-1" aria-hidden="true"
						>pin_drop</span
					>
					<address class="font-body-md text-body-md text-foreground not-italic">
						{address.street}<br />{address.city}, {address.postalCode}<br />{address.country}
					</address>
				</div>
			</div>
			<a
				href={routeUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="bg-foreground font-technical-data text-technical-data text-background mt-8 inline-flex items-center gap-2 self-start rounded-lg px-5 py-2.5 font-medium transition-opacity hover:opacity-90"
			>
				<span class="material-symbols-outlined text-sm" aria-hidden="true">directions</span>
				{_("Get Route")}
			</a>
		</div>

		{/* Map */}
		<figure class="m-0 min-h-[320px] lg:col-span-7 lg:min-h-[380px]">
			<iframe
				src={embedUrl}
				title={_("Map showing OS-Technology Ukraine office location")}
				width="100%"
				height="100%"
				class="h-full min-h-[320px] w-full"
				style="border:0;"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"></iframe>
		</figure>
	</div>
</section>
