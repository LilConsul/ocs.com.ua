---
import type { LegalSection } from "@/lib/legal/document";

interface Props {
	section: LegalSection;
}

const { section } = Astro.props;
---

<section
	id={section.id}
	aria-labelledby={`${section.id}-title`}
	class="bg-background border-border-subtle/70 hover:border-secondary/40 before:from-secondary relative scroll-mt-24 overflow-hidden rounded-xl border p-5 shadow-xs transition-[box-shadow,border-color] duration-(--dur-base) before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-linear-to-r before:to-transparent hover:shadow-lg sm:p-8"
>
	<header class="border-border-subtle/60 mb-5 flex items-center gap-4 border-b pb-5">
		<span
			class="font-technical-data bg-secondary text-primary-foreground flex size-10 shrink-0 items-center justify-center rounded-lg text-sm font-semibold shadow-xs"
			aria-hidden="true">{String(section.number).padStart(2, "0")}</span
		>
		<h2
			id={`${section.id}-title`}
			class="font-headline-lg text-foreground m-0 text-xl font-semibold tracking-tight text-balance wrap-break-word"
		>
			<span class="sr-only">{section.number}. </span>{section.title}
		</h2>
	</header>

	<div class="prose privacy-prose" set:html={section.html} />
</section>

<style is:global>
	.privacy-prose a {
		color: var(--color-secondary);
		text-decoration: underline;
		text-underline-offset: 2px;
		overflow-wrap: anywhere;
	}
	.privacy-prose a:hover {
		color: var(--color-foreground);
	}
	.privacy-prose p:has(+ ul) {
		margin-bottom: 0.5rem;
	}
	.privacy-prose p:last-child,
	.privacy-prose ul:last-child {
		margin-bottom: 0;
	}
</style>
