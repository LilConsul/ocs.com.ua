---
import { geoMercator, geoPath } from "d3-geo";
import { Factory, MapPin } from "lucide-react";
import { feature, mesh } from "topojson-client";
import type { GeometryCollection, Topology } from "topojson-specification";
import { getInlineTranslations, type Lang } from "@/i18n";
import type { CityHub, SectorBreakdown } from "@/lib/about/types";
import oblastsTopo from "@/lib/about/ukraine-oblasts.topo.json";

interface Props {
	lang: Lang;
	cityHubs: CityHub[];
	sectors: SectorBreakdown[];
}

const { lang, cityHubs, sectors } = Astro.props;
const _ = getInlineTranslations(lang);

const metrics = [
	{ key: "cw", label: _("Checkweighers") },
	{ key: "md", label: _("Metal Detectors") },
	{ key: "tqs", label: _("Track & Trace") },
] as const;

const W = 800;
const H = 520;
// 24 oblasts + Crimea, built by src/lib/about/build-ukraine-topo.ts
const topology = oblastsTopo as unknown as Topology;
const oblastsObject = topology.objects.oblasts as GeometryCollection;
const oblasts = feature(topology, oblastsObject);
// Outer border only (shared arcs between neighbouring oblasts are excluded)
const outline = mesh(topology, oblastsObject, (a, b) => a === b);

const projection = geoMercator().fitExtent(
	[
		[24, 24],
		[W - 24, H - 24],
	],
	oblasts
);
const toPath = geoPath(projection);

const oblastPaths = oblasts.features.map((f) => ({
	id: String(f.id),
	d: toPath(f) ?? "",
}));
const outlinePath = toPath(outline) ?? "";

const pins = cityHubs.flatMap((hub) => {
	const point = projection([hub.coords[1], hub.coords[0]]);
	if (!point) return [];
	return [{ hub, left: (point[0] / W) * 100, top: (point[1] / H) * 100 }];
});

const maxSector = Math.max(1, ...sectors.map((s) => s.stats.total));
---

<section
	id="installation-map"
	aria-labelledby="map-section-title"
	class="bg-background w-full scroll-mt-24 py-16 lg:py-24"
>
	<div class="px-edge-margin mx-auto max-w-[1280px]">
		<header class="mb-12 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<span
					class="font-label-caps text-secondary block text-xs font-semibold tracking-widest uppercase"
				>
					{_("Deployment Breakdown")}
				</span>
				<h2
					id="map-section-title"
					class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
				>
					{_("Verified Ukrainian Industrial Footprint")}
				</h2>
			</div>
			<p class="font-technical-data text-industrial-gray m-0 flex items-center gap-2 text-sm">
				<MapPin className="text-secondary h-4 w-4 shrink-0" aria-hidden="true" />
				<span>{_("Active Factory Installations Across Regional Hubs")}</span>
			</p>
		</header>

		<div class="gap-gutter grid grid-cols-1 items-start lg:grid-cols-12">
			<div class="flex flex-col gap-4 lg:col-span-7">
				{/* Map */}
				<figure
					class="bg-surface-container border-border-subtle m-0 overflow-hidden rounded-xl border shadow-xs"
				>
					<div
						class="border-border-subtle/60 flex items-center justify-between gap-3 border-b px-4 py-3 sm:px-5"
					>
						<h3 class="font-headline-lg text-foreground m-0 text-sm font-semibold">
							{_("Installation Map of Ukraine")}
						</h3>
						<span class="font-technical-data text-industrial-gray text-xs">
							{_("Click pins to inspect")}
						</span>
					</div>

					<div
						class="relative w-full"
						style={`aspect-ratio: ${W} / ${H}`}
						data-map-pins
					>
						<svg
							viewBox={`0 0 ${W} ${H}`}
							class="absolute inset-0 h-full w-full"
							role="img"
							aria-label={_("Interactive Map of Ukraine Installations")}
						>
							{
								oblastPaths.map(({ id, d }) => (
									<path
										d={d}
										data-oblast={id}
										class="fill-secondary/10 stroke-secondary/30"
										stroke-width="0.75"
										stroke-linejoin="round"
										vector-effect="non-scaling-stroke"
									/>
								))
							}
							<path
								d={outlinePath}
								fill="none"
								class="stroke-secondary/60"
								stroke-width="1.5"
								stroke-linejoin="round"
								vector-effect="non-scaling-stroke"
							></path>
						</svg>

						{
							pins.map(({ hub, left, top }, i) => (
								<button
									type="button"
									data-hub={hub.id}
									aria-pressed={i === 0 ? "true" : "false"}
									aria-controls={`hub-panel-${hub.id}`}
									aria-label={`${hub.name[lang]}: ${hub.stats.total} ${_("Units")}`}
									class="group focus-visible:outline-secondary absolute flex size-11 -translate-x-1/2 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 aria-pressed:z-10"
									style={`left:${left.toFixed(2)}%;top:${top.toFixed(2)}%`}
								>
									<span
										class="bg-secondary/40 absolute inset-1 rounded-full opacity-0 motion-safe:group-aria-pressed:animate-ping"
										aria-hidden="true"
									/>
									<span
										class="font-technical-data bg-secondary text-background border-background group-aria-pressed:bg-foreground relative flex h-7 min-w-7 items-center justify-center rounded-full border-2 px-1.5 text-[11px] font-bold tabular-nums shadow-md transition-transform group-hover:scale-110 group-aria-pressed:scale-110"
										aria-hidden="true"
									>
										{hub.stats.total}
									</span>
								</button>
							))
						}
					</div>
				</figure>

				{/* Selected hub details */}
				{
					cityHubs.length > 0 && (
						<div
							class="bg-background border-border-subtle/80 rounded-xl border p-5 shadow-xs"
							aria-live="polite"
						>
							{cityHubs.map((hub, i) => (
								<div id={`hub-panel-${hub.id}`} data-hub-panel={hub.id} hidden={i !== 0}>
									<div class="flex flex-wrap items-center justify-between gap-2">
										<h4 class="font-headline-lg text-foreground m-0 text-base font-semibold">
											{hub.name[lang]}
										</h4>
										<span class="bg-secondary/10 text-secondary font-label-caps rounded px-2 py-0.5 text-xs font-bold tabular-nums">
											{hub.stats.total}+ {_("Units")}
										</span>
									</div>

									<dl class="border-border-subtle/50 m-0 mt-4 grid grid-cols-3 gap-3 border-y py-3">
										{metrics.map(({ key, label }) => (
											<div class="flex flex-col-reverse justify-end gap-0.5">
												<dt class="font-label-caps text-industrial-gray text-[11px] uppercase">
													{label}
												</dt>
												<dd class="font-technical-data text-foreground m-0 text-xl font-bold tabular-nums">
													{hub.stats[key]}
												</dd>
											</div>
										))}
									</dl>

									<p class="font-body-md text-industrial-gray m-0 mt-3 text-sm leading-relaxed">
										<strong class="text-foreground font-medium">{_("Active Client Facilities:")}</strong>{" "}
										{hub.clients.map((c) => c[lang]).join(", ") || _("Multiple facilities active")}
									</p>
								</div>
							))}
						</div>
					)
				}
			</div>

			{/* Sector breakdown */}
			<div class="flex flex-col gap-4 lg:col-span-5">
				{
					sectors.map((sector) => (
						<article class="bg-surface-container border-border-subtle/70 rounded-xl border p-5 shadow-xs sm:p-6">
							<header class="flex items-center justify-between gap-3">
								<div class="flex min-w-0 items-center gap-2.5">
									<div
										class="bg-background text-secondary border-border-subtle/50 shrink-0 rounded-lg border p-2"
										aria-hidden="true"
									>
										<Factory className="h-4 w-4" />
									</div>
									<h3 class="font-headline-lg text-foreground m-0 text-sm font-semibold sm:text-base">
										{sector.title[lang]}
									</h3>
								</div>
								<span class="font-technical-data bg-surface-container-high text-foreground shrink-0 rounded px-2.5 py-0.5 text-xs font-bold tabular-nums">
									{sector.stats.total} {_("Units")}
								</span>
							</header>

							<div class="bg-border-subtle/50 mt-4 h-1 overflow-hidden rounded-full" aria-hidden="true">
								<div
									class="bg-secondary h-full rounded-full"
									style={`width:${Math.round((sector.stats.total / maxSector) * 100)}%`}
								/>
							</div>

							<dl class="m-0 mt-4 grid grid-cols-3 gap-2 p-0">
								{metrics.map(({ key, label }) => (
									<div class="bg-background border-border-subtle/40 flex flex-col-reverse justify-end gap-0.5 rounded-lg border p-2.5">
										<dt class="font-label-caps text-industrial-gray text-[11px] uppercase">{label}</dt>
										<dd class="font-technical-data text-foreground m-0 text-lg font-bold tabular-nums">
											{sector.stats[key]}
										</dd>
									</div>
								))}
							</dl>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	const root = document.getElementById("installation-map");
	if (root) {
		const pins = root.querySelectorAll<HTMLButtonElement>("[data-hub]");
		const panels = root.querySelectorAll<HTMLElement>("[data-hub-panel]");

		pins.forEach((pin) => {
			pin.addEventListener("click", () => {
				const id = pin.dataset.hub;
				pins.forEach((p) => p.setAttribute("aria-pressed", String(p === pin)));
				panels.forEach((panel) => {
					panel.hidden = panel.dataset.hubPanel !== id;
				});
			});
		});
	}
</script>
