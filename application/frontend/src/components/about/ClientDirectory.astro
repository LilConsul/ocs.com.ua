---
import { Image } from "astro:assets";
import {
	Building2,
	ExternalLink,
	type LucideIcon,
	MapPin,
	Pill,
	QrCode,
	Scale,
	ScanLine,
	SprayCan,
	Utensils,
} from "lucide-react";
import { getInlineTranslations, type Lang } from "@/i18n";
import { getCityCoordinates } from "@/lib/about/geocoding";
import { formatApprox } from "@/lib/about/partners-data";
import type { PartnerItem } from "@/lib/about/types";

interface Props {
	lang: Lang;
	partners: PartnerItem[];
}

const { lang, partners } = Astro.props;
const _ = getInlineTranslations(lang);

const categoryLabels: Record<PartnerItem["category"], string> = {
	food: _("Food & Beverage"),
	pharma: _("Pharmaceuticals"),
	household: _("Chemicals & Packaging"),
};

const categoryIcons: Record<PartnerItem["category"], LucideIcon> = {
	food: Utensils,
	pharma: Pill,
	household: SprayCan,
};

const metrics = [
	{ key: "cw", Icon: Scale, label: _("Checkweighers") },
	{ key: "md", Icon: ScanLine, label: _("Metal Detectors") },
	{ key: "tqs", Icon: QrCode, label: _("Track & Trace") },
] as const;

// Badge recipe shared with the map and hero; equipment uses full-width rows so long labels never overflow
const rowClass =
	"bg-background border-border-subtle/50 flex h-10 items-center justify-between gap-3 rounded-lg border px-3 transition-colors duration-300";
const badgeClass =
	"font-technical-data bg-secondary/10 text-secondary shrink-0 rounded-full px-2.5 py-0.5 text-xs font-bold tabular-nums";

const countBy = (category: PartnerItem["category"]) =>
	partners.filter((p) => p.category === category).length;

// Pressed state is styled purely through aria-pressed:, so the script only flips the attribute
const tabClass =
	"client-tab font-technical-data border-border-subtle/60 bg-background text-industrial-gray hover:text-foreground hover:border-secondary/40 focus-visible:outline-secondary aria-pressed:bg-foreground aria-pressed:text-background aria-pressed:border-foreground inline-flex cursor-pointer items-center gap-2 rounded-full border px-4 py-2 text-xs shadow-xs transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2";

const tabs = [
	{ filter: "all", label: _("All Sectors"), count: partners.length },
	{ filter: "food", label: categoryLabels.food, count: countBy("food") },
	{ filter: "pharma", label: categoryLabels.pharma, count: countBy("pharma") },
	{ filter: "household", label: categoryLabels.household, count: countBy("household") },
];

const unitsOf = (p: PartnerItem) => (p.equipment?.md ?? 0) + (p.equipment?.cw ?? 0) + (p.equipment?.tqs ?? 0);
const maxUnits = Math.max(1, ...partners.map(unitsOf));

// Clients without unit counts go last (stable sort keeps the original order within each group)
const orderedPartners = [...partners].sort(
	(a, b) => Number(unitsOf(b) > 0) - Number(unitsOf(a) > 0)
);
---

<section
	id="clients"
	aria-labelledby="clients-heading"
	class="bg-surface-container border-border-subtle/40 w-full scroll-mt-24 border-y py-16 lg:py-24"
>
	<div class="px-edge-margin mx-auto max-w-[1280px]">
		<header class="mb-12 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
			<div class="max-w-2xl">
				<span
					class="font-label-caps text-secondary block text-xs font-semibold tracking-widest uppercase"
				>
					{_("Enterprise Reference Directory")}
				</span>
				<h2
					id="clients-heading"
					class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
				>
					{_("Trusted by Ukraine's Industrial Flagships")}
				</h2>
				<p class="font-body-md text-industrial-gray mt-4 text-sm leading-relaxed sm:text-base">
					{
						_(
							"Explore verified German inspection equipment installations across leading food, pharmaceutical, and consumer goods manufacturers in Ukraine."
						)
					}
				</p>
			</div>

			{/* Filter buttons: they toggle a filter, they do not switch tab panels */}
			<div
				role="group"
				aria-label={_("Filter clients by sector")}
				class="flex flex-wrap items-center gap-2 lg:max-w-md lg:justify-end"
				id="clientFilterGroup"
			>
				{
					tabs.map((tab, index) => (
						<button
							type="button"
							aria-pressed={index === 0 ? "true" : "false"}
							aria-controls="clientCardsContainer"
							class={tabClass}
							data-filter={tab.filter}
						>
							<span>{tab.label}</span>
							<span class="bg-secondary/10 text-secondary rounded-full px-1.5 py-px text-[11px] font-bold tabular-nums">
								{tab.count}
							</span>
						</button>
					))
				}
			</div>
		</header>

		{/* Client cards */}
		<div
			class="gap-gutter grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
			id="clientCardsContainer"
			aria-live="polite"
		>
			{
				orderedPartners.map((partner, pi) => {
					const clientName = partner.name[lang];
					const eq = partner.equipment;
					const totalUnits = unitsOf(partner);
					const hasData = totalUnits > 0;
					const CategoryIcon = categoryIcons[partner.category];

					return (
						<article
							class="client-card group/card bg-background border-border-subtle/70 hover:border-secondary/40 flex flex-col overflow-hidden rounded-xl border shadow-xs transition-[translate,box-shadow,border-color] duration-300 hover:shadow-lg motion-safe:hover:-translate-y-0.5"
							data-category={partner.category}
							style={`--i:${pi % 3}`}
						>
							{/* Logo band: fixed height so every card starts the same, logos get room to breathe */}
							<figure class="border-border-subtle/40 m-0 flex h-28 items-center justify-center border-b bg-white px-8 py-4 sm:h-32">
								{partner.logo ? (
									<Image
										src={partner.logo}
										alt={`${clientName} Logo`}
										width={160}
										height={80}
										class="max-h-full max-w-full object-contain"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<Building2 className="text-industrial-gray/60 h-10 w-10" aria-hidden="true" />
								)}
							</figure>

							<div class="flex flex-1 flex-col p-5 sm:p-6">
								<header class="flex items-start justify-between gap-3">
									<div class="min-w-0">
										<h3 class="font-headline-lg text-foreground m-0 text-base leading-snug font-semibold text-balance sm:text-lg">
											{clientName}
										</h3>
										<p class="font-technical-data text-industrial-gray m-0 mt-1.5 flex items-center gap-1.5 text-xs">
											<CategoryIcon className="text-secondary h-3.5 w-3.5 shrink-0" aria-hidden="true" />
											<span>{categoryLabels[partner.category]}</span>
										</p>
									</div>
									{hasData && (
										<span class={badgeClass}>
											{formatApprox(totalUnits)} {_("Units")}
										</span>
									)}
								</header>

								{/* Clients without unit counts simply have no equipment block */}
								{hasData && (
									<div class="mt-auto pt-5">
										<div
											class="bg-border-subtle/50 h-1.5 overflow-hidden rounded-full"
											aria-hidden="true"
										>
											<div
												class="client-bar from-secondary/60 to-secondary h-full origin-left rounded-full bg-linear-to-r"
												style={`width:${Math.max(6, Math.round((totalUnits / maxUnits) * 100))}%`}
											/>
										</div>

										<p class="font-label-caps text-industrial-gray m-0 mt-4 text-[11px] uppercase">
											{_("Installed Equipment:")}
										</p>

										<dl class="m-0 mt-2 flex flex-col gap-2 p-0">
											{metrics.map(({ key, Icon, label }) => {
												const value = eq?.[key] ?? 0;
												return (
													<div
														class:list={[
															rowClass,
															"group-hover/card:border-secondary/30",
															value === 0 && "opacity-50",
														]}
													>
														<dt class="font-body-md text-industrial-gray flex min-w-0 items-center gap-2 text-xs">
															<Icon className="text-secondary h-4 w-4 shrink-0" aria-hidden="true" />
															<span class="truncate">{label}</span>
														</dt>
														<dd class="font-technical-data text-foreground m-0 shrink-0 text-lg leading-none font-bold tabular-nums">
															{formatApprox(value)}
														</dd>
													</div>
												);
											})}
										</dl>
									</div>
								)}
							</div>

							<footer class="bg-surface-container border-border-subtle/40 font-technical-data text-industrial-gray flex items-center justify-between gap-3 border-t px-5 py-3 text-xs sm:px-6">
								<address class="flex min-w-0 items-center gap-1.5 not-italic">
									<MapPin className="text-secondary h-3.5 w-3.5 shrink-0" aria-hidden="true" />
									<span class="truncate">
										{partner.adres && partner.adres.length > 0
											? partner.adres.map((city) => getCityCoordinates(city)?.name[lang] ?? city).join(", ")
											: _("Ukraine")}
									</span>
								</address>
								{partner.website && (
									<a
										href={partner.website}
										target="_blank"
										rel="noopener noreferrer"
										class="text-foreground hover:text-secondary focus-visible:outline-secondary inline-flex shrink-0 items-center gap-1 font-medium transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
										aria-label={`${clientName} Website`}
									>
										<span>{_("Site")}</span>
										<ExternalLink className="text-secondary h-3 w-3" aria-hidden="true" />
									</a>
								)}
							</footer>
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* Hidden only once the script has confirmed the animation will run */
		[data-anim="ready"] .client-card {
			opacity: 0;
		}
		[data-anim="ready"] .client-bar {
			scale: 0 1;
		}

		[data-anim="in"] .client-card {
			animation: client-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(var(--i, 0) * 100ms);
		}
		[data-anim="in"] .client-bar {
			animation: client-bar-fill 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(0.3s + var(--i, 0) * 100ms);
		}
	}

	@keyframes client-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}
	@keyframes client-bar-fill {
		from {
			scale: 0 1;
		}
	}
</style>

<script>
	import { revealOnce } from "@/lib/anims/reveal-once";

	function setupClientFilters() {
		const buttons = document.querySelectorAll<HTMLButtonElement>(
			"#clientFilterGroup [data-filter]"
		);
		const cards = document.querySelectorAll<HTMLElement>("#clientCardsContainer .client-card");

		for (const button of buttons) {
			button.addEventListener("click", () => {
				const filter = button.dataset.filter;

				for (const other of buttons) {
					other.setAttribute("aria-pressed", String(other === button));
				}
				for (const card of cards) {
					card.hidden = !(filter === "all" || card.dataset.category === filter);
				}
			});
		}

		const grid = document.getElementById("clientCardsContainer");
		if (grid) revealOnce(grid, 0.1);
	}

	setupClientFilters();
</script>
