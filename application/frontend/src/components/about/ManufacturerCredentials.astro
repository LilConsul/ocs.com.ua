---
import { CheckCircle2, Download, FileCheck } from "lucide-react";
import documentsData from "@/data/documents.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const manufacturers = [
	{
		id: "wipotec",
		name: "WIPOTEC GmbH",
		location: "Kaiserslautern, Germany",
		tier: _("Tier 1 Distributor"),
		description: _(
			"Global innovation leader in high-speed Electro-Magnetic Force Restoration (EMFR) dynamic weighing technology, industrial X-Ray scanners, and pharmaceutical Track & Trace serialization lines."
		),
		features: [
			_("EMFR High-Precision Dynamic Weighing Cells (up to 600 pcs/min)"),
			_("SC Series High-Resolution Industrial X-Ray Inspection Scanners"),
			_("Pharma Serialization & Aggregation Systems (EU FMD, GS1)"),
		],
		documentTitle: _("Official Distributor Authorization"),
		documentSub: _("Direct Factory Endorsement • Valid Nationwide"),
		pdfUrl: documentsData.wipotec,
		serviceLabel: _("Service: Nationwide Ukraine"),
		hubLabel: _("Factory Certified Hub"),
	},
	{
		id: "mesutronic",
		name: "MESUTRONIC Gerätebau GmbH",
		location: "Kirchberg im Wald, Germany",
		tier: _("Authorized Partner"),
		description: _(
			"Pioneering German metal detection systems built for rigorous industrial environments. Multi-segment digital signal evaluation detecting ferrous, non-ferrous, and stainless steel contaminants."
		),
		features: [
			_("Meatline & Pipeline Metal Inspection For Pumped Products"),
			_("Quicktron & Pharma Freefall Gravity Contaminant Separators"),
			_("Metron FlatLine & Transtron High-Sensitivity Conveyor Systems"),
		],
		documentTitle: _("Official Partner Certificate"),
		documentSub: _("Direct Factory Authorization • Genuine OEM Parts"),
		pdfUrl: documentsData.mesutronic,
		serviceLabel: _("Standard: HACCP / IFS Compliant"),
		hubLabel: _("Direct OEM Spare Parts"),
	},
];
---

<section
	id="credentials"
	aria-labelledby="credentials-title"
	class="bg-surface-container border-border-subtle/40 w-full border-y py-16 lg:py-24"
>
	<div class="px-edge-margin mx-auto max-w-[1280px]">
		<header class="mb-12 flex flex-col justify-between md:flex-row md:items-end">
			<div>
				<span
					class="font-label-caps text-secondary block text-xs font-semibold tracking-wider uppercase"
					>{_("Manufacturer Alliances")}</span
				>
				<h2
					id="credentials-title"
					class="font-headline-lg text-foreground mt-2 text-2xl font-semibold sm:text-3xl"
				>
					{_("Official German Engineering Credentials")}
				</h2>
			</div>
			<p class="font-technical-data text-industrial-gray mt-2 text-xs md:mt-0">
				{_("Direct Factory Partnership & Certified Distribution")}
			</p>
		</header>

		<div class="gap-gutter grid grid-cols-1 lg:grid-cols-2">
			{
				manufacturers.map((m) => (
					<article class="bg-background border-border-subtle/80 flex flex-col justify-between rounded-xl border p-6 shadow-xs sm:p-8">
						<div>
							<header class="bg-surface-container border-border-subtle/40 mb-6 flex items-center justify-between rounded-lg border p-4 pb-4">
								<div>
									<h3 class="font-headline-lg text-foreground text-xl font-bold tracking-tight">
										{m.name}
									</h3>
									<address class="font-technical-data text-industrial-gray text-xs not-italic">
										{m.location}
									</address>
								</div>
								<span class="bg-surface-container-high text-foreground font-label-caps border-border-subtle rounded border px-3 py-1 text-xs font-medium">
									{m.tier}
								</span>
							</header>

							<p class="font-body-md text-industrial-gray mb-6 text-sm leading-relaxed">
								{m.description}
							</p>

							<ul class="font-technical-data text-foreground mb-6 list-none space-y-3 p-0 text-xs">
								{m.features.map((feature) => (
									<li class="flex items-center gap-2">
										<CheckCircle2 className="text-secondary h-4 w-4 shrink-0" aria-hidden="true" />
										<span>{feature}</span>
									</li>
								))}
							</ul>
						</div>

						<footer>
							<div class="bg-surface-container border-border-subtle rounded-lg border p-4">
								<div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
									<div class="flex items-start gap-3">
										<div
											class="bg-background text-secondary border-border-subtle/40 shrink-0 rounded border p-2"
											aria-hidden="true"
										>
											<FileCheck className="h-5 w-5" />
										</div>
										<div>
											<h4 class="font-headline-lg text-foreground m-0 text-sm font-semibold">
												{m.documentTitle}
											</h4>
											<p class="font-technical-data text-industrial-gray m-0 mt-0.5 text-[11px]">
												{m.documentSub}
											</p>
										</div>
									</div>
									<a
										href={m.pdfUrl}
										target="_blank"
										rel="noopener noreferrer"
										class="bg-foreground hover:bg-secondary font-technical-data inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-xs whitespace-nowrap text-white shadow-xs transition-colors"
									>
										<Download className="h-3.5 w-3.5" aria-hidden="true" />
										<span>{_("Authorization Letter (PDF)")}</span>
									</a>
								</div>
							</div>
							<div class="border-border-subtle/50 text-industrial-gray font-label-caps mt-4 flex items-center justify-between border-t pt-3 text-[11px]">
								<span>{m.serviceLabel}</span>
								<span class="font-technical-data text-foreground font-medium">{m.hubLabel}</span>
							</div>
						</footer>
					</article>
				))
			}
		</div>
	</div>
</section>
