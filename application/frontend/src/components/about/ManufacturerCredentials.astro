---
import { CheckCircle2, Download, ExternalLink, MapPin, ShieldCheck } from "lucide-react";
import documentsData from "@/data/documents.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const manufacturers = [
	{
		id: "wipotec",
		name: "WIPOTEC GmbH",
		location: "Kaiserslautern, Germany",
		mapUrl: "https://maps.app.goo.gl/ZqNMtgiGWXLLzL8Y6",
		websiteUrl: "https://www.wipotec.com",
		websiteLabel: "wipotec.com",
		description: _(
			"Dynamic checkweighers with EMFR weighing technology, industrial X-Ray inspection scanners and Track & Trace serialization lines for pharmaceuticals."
		),
		details: _(
			"Our partner WIPOTEC-OCS GmbH is a subsidiary of WIPOTEC GmbH. Its weighing and inspection systems have been a quality standard for over 30 years, and all key components are developed and built in-house in Kaiserslautern."
		),
		features: [
			_("EMFR High-Precision Dynamic Weighing Cells (up to 600 pcs/min)"),
			_("SC Series High-Resolution Industrial X-Ray Inspection Scanners"),
			_("Pharma Serialization & Aggregation Systems (EU FMD, GS1)"),
		],
		pdfUrl: documentsData.wipotec,
	},
	{
		id: "mesutronic",
		name: "MESUTRONIC Gerätebau GmbH",
		location: "Kirchberg im Wald, Germany",
		mapUrl: "https://maps.app.goo.gl/7Xa7imQJKJw3Lagi8",
		websiteUrl: "https://www.mesutronic.de",
		websiteLabel: "mesutronic.de",
		description: _(
			"Metal detectors for food and pharmaceutical production lines. They detect ferrous, non-ferrous and stainless steel contaminants."
		),
		details: _(
			"MESUTRONIC Gerätebau GmbH develops and builds its metal detectors and contaminant separators in Kirchberg im Wald, Germany."
		),
		features: [
			_("Meatline & Pipeline Metal Inspection For Pumped Products"),
			_("Quicktron & Pharma Freefall Gravity Contaminant Separators"),
			_("Metron FlatLine & Transtron High-Sensitivity Conveyor Systems"),
		],
		pdfUrl: documentsData.mesutronic,
	},
];
---

<section
	id="credentials"
	aria-labelledby="credentials-title"
	class="bg-surface-container border-border-subtle/40 w-full scroll-mt-24 border-y py-16 lg:py-24"
>
	<div class="px-edge-margin mx-auto max-w-[1280px]">
		<header class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div>
				<span
					class="font-label-caps text-secondary block text-xs font-semibold tracking-widest uppercase"
				>
					{_("Manufacturers")}
				</span>
				<h2
					id="credentials-title"
					class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
				>
					{_("Official German Engineering Credentials")}
				</h2>
			</div>
			<p class="font-technical-data text-industrial-gray max-w-sm text-sm md:text-right">
				{_("Direct Factory Partnership & Certified Distribution")}
			</p>
		</header>

		<div class="gap-gutter grid grid-cols-1 lg:grid-cols-2">
			{
				manufacturers.map((m) => (
					<article class="bg-background border-border-subtle/80 border-t-secondary flex h-full flex-col rounded-xl border border-t-4 p-6 shadow-xs sm:p-8">
						<header>
							<h3 class="font-headline-lg text-foreground text-xl font-bold tracking-tight sm:text-2xl">
								{m.name}
							</h3>
							<div class="font-technical-data mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
								<a
									href={m.mapUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${_("Open in Google Maps")}: ${m.location}`}
									class="text-industrial-gray hover:text-secondary focus-visible:outline-secondary inline-flex items-center gap-1.5 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
								>
									<MapPin className="text-secondary h-3.5 w-3.5 shrink-0" aria-hidden="true" />
									{m.location}
								</a>
								<a
									href={m.websiteUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${_("Visit website")}: ${m.websiteLabel}`}
									class="text-industrial-gray hover:text-secondary focus-visible:outline-secondary inline-flex items-center gap-1.5 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
								>
									<ExternalLink
										className="text-secondary h-3.5 w-3.5 shrink-0"
										aria-hidden="true"
									/>
									{m.websiteLabel}
								</a>
							</div>
						</header>

						<div class="mt-6 space-y-4">
							<p class="font-body-md text-industrial-gray text-base leading-relaxed">
								{m.description}
							</p>
							{m.details && (
								<p class="font-body-md text-industrial-gray border-secondary/40 border-l-2 pl-4 text-sm leading-relaxed">
									{m.details}
								</p>
							)}
						</div>

						<ul class="font-body-md text-foreground divide-border-subtle/60 mt-6 mb-8 list-none divide-y p-0 text-sm">
							{m.features.map((feature) => (
								<li class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
									<CheckCircle2
										className="text-secondary mt-0.5 h-4 w-4 shrink-0"
										aria-hidden="true"
									/>
									<span>{feature}</span>
								</li>
							))}
						</ul>

						<footer class="mt-auto">
							<div class="border-secondary/30 bg-secondary/5 rounded-lg border border-dashed p-4">
								<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
									<div class="flex items-center gap-3">
										<div
											class="bg-secondary/10 text-secondary shrink-0 rounded-lg p-2"
											aria-hidden="true"
										>
											<ShieldCheck className="h-5 w-5" />
										</div>
										<h4 class="font-headline-lg text-foreground m-0 text-sm font-semibold">
											{_("Authorization Letter")}
										</h4>
									</div>
									<a
										href={m.pdfUrl}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${_("Download PDF")} — ${m.name}`}
										class="bg-primary text-primary-foreground font-technical-data focus-visible:outline-secondary inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-xs whitespace-nowrap shadow-xs transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
									>
										<Download className="h-3.5 w-3.5" aria-hidden="true" />
										<span>{_("Download PDF")}</span>
									</a>
								</div>
							</div>
						</footer>
					</article>
				))
			}
		</div>
	</div>
</section>
