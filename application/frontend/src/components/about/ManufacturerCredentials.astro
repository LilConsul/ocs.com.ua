---
import { CircleCheck, Download, ExternalLink, MapPin, ShieldCheck } from "@lucide/astro";
import documentsData from "@/data/documents.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);

const manufacturers = [
	{
		id: "wipotec",
		name: "WIPOTEC GmbH",
		location: "Kaiserslautern, Germany",
		mapUrl: "https://maps.app.goo.gl/ZqNMtgiGWXLLzL8Y6",
		websiteUrl: "https://www.wipotec.com",
		websiteLabel: "wipotec.com",
		description: _(
			"Dynamic checkweighers with electromagnetic force compensation technology, X-Ray scanners, and Track & Trace serialization and aggregation systems for the pharmaceutical industry."
		),
		details: _(
			"Weighing and inspection systems have been a quality standard for over 30 years, and 95% of components are developed and manufactured in-house in one location in Kaiserslautern."
		),
		features: [
			_("High-precision dynamic checkweighers (up to 600 - 1000 pcs/min)"),
			_("High-resolution industrial X-Ray scanners"),
			_("Track & Trace serialization and aggregation systems"),
		],
		pdfUrl: documentsData.wipotec,
	},
	{
		id: "mesutronic",
		name: "MESUTRONIC Gerätebau GmbH",
		location: "Kirchberg im Wald, Germany",
		mapUrl: "https://maps.app.goo.gl/7Xa7imQJKJw3Lagi8",
		websiteUrl: "https://www.mesutronic.de",
		websiteLabel: "mesutronic.de",
		description: _(
			"Metal detectors for food and pharmaceutical production lines. They detect ferrous, non-ferrous and stainless steel contaminants."
		),
		details: _(
			"MESUTRONIC Gerätebau GmbH develops and manufactures metal detectors in Kirchberg im Wald, Germany."
		),
		features: [
			_("Meatline & Pipeline Metal Inspection For Pumped Products"),
			_("Quicktron & Pharma Freefall Gravity Contaminant Separators"),
			_("Metron FlatLine & Transtron High-Sensitivity Conveyor Systems"),
		],
		pdfUrl: documentsData.mesutronic,
	},
];
---

<section
	id="credentials"
	aria-labelledby="credentials-title"
	class="bg-surface-container border-border-subtle/40 w-full scroll-mt-[calc(6rem+var(--banner-h,0px))] border-y py-16 lg:py-24"
>
	<div class="px-edge-margin mx-auto max-w-7xl">
		<header class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
			<div>
				<p
					class="font-label-caps text-secondary m-0 flex items-center gap-3 text-xs font-semibold tracking-widest uppercase"
				>
					<span class="eyebrow-rule bg-secondary h-px w-8" aria-hidden="true"></span>
					{_("Manufacturers")}
				</p>
				<h2
					id="credentials-title"
					class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
				>
					{_("Official German Engineering Credentials")}
				</h2>
			</div>
			<p class="font-technical-data text-industrial-gray max-w-sm text-sm md:text-right">
				{_("Direct Factory Partnership & Certified Distribution")}
			</p>
		</header>

		<div class="gap-gutter grid grid-cols-1 lg:grid-cols-2" data-credentials-grid>
			{
				manufacturers.map((m, mi) => (
					<article
						class="cred-card bg-background border-border-subtle/80 border-t-secondary flex h-full flex-col rounded-xl border border-t-4 p-5 shadow-xs transition-[translate,box-shadow] duration-300 hover:shadow-lg motion-safe:hover:-translate-y-0.5 sm:p-8"
						style={`--i:${mi}`}
					>
						<header>
							<h3 class="font-headline-lg text-foreground text-xl font-bold tracking-tight wrap-break-word sm:text-2xl">
								{m.name}
							</h3>
							<div class="font-technical-data mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs">
								<a
									href={m.mapUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${_("Open in Google Maps")}: ${m.location}`}
									class="text-industrial-gray hover:text-secondary focus-visible:outline-secondary inline-flex max-w-full min-w-0 items-center gap-1.5 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
								>
									<MapPin class="text-secondary h-3.5 w-3.5 shrink-0" aria-hidden="true" />
									<span class="truncate">{m.location}</span>
								</a>
								<a
									href={m.websiteUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${_("Visit website")}: ${m.websiteLabel}`}
									class="text-industrial-gray hover:text-secondary focus-visible:outline-secondary inline-flex max-w-full min-w-0 items-center gap-1.5 transition-colors hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
								>
									<ExternalLink class="text-secondary h-3.5 w-3.5 shrink-0" aria-hidden="true" />
									<span class="truncate">{m.websiteLabel}</span>
								</a>
							</div>
						</header>

						<div class="mt-6 space-y-4">
							<p class="font-body-md text-industrial-gray text-sm leading-relaxed wrap-break-word sm:text-base">
								{m.description}
							</p>
							{m.details && (
								<p class="font-body-md text-industrial-gray border-secondary/40 border-l-2 pl-4 text-xs leading-relaxed wrap-break-word sm:text-sm">
									{m.details}
								</p>
							)}
						</div>

						<ul class="font-body-md text-foreground divide-border-subtle/60 mt-6 mb-8 list-none divide-y p-0 text-sm">
							{m.features.map((feature, fi) => (
								<li
									class="cred-feature group/feature flex items-start gap-3 py-3 first:pt-0 last:pb-0"
									style={`--fi:${fi}`}
								>
									<CircleCheck
										class="text-secondary mt-0.5 h-4 w-4 shrink-0 transition-transform duration-300 group-hover/feature:scale-125"
										aria-hidden="true"
									/>
									<span class="min-w-0 wrap-break-word">{feature}</span>
								</li>
							))}
						</ul>

						<footer class="mt-auto">
							<div class="border-secondary/30 bg-secondary/5 rounded-lg border border-dashed p-4">
								<div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
									<div class="flex items-center gap-3">
										<div
											class="bg-secondary/10 text-secondary shrink-0 rounded-lg p-2"
											aria-hidden="true"
										>
											<ShieldCheck class="h-5 w-5" />
										</div>
										<h4 class="font-headline-lg text-foreground m-0 text-sm font-semibold wrap-break-word">
											{_("Authorization Letter")}
										</h4>
									</div>
									<a
										href={m.pdfUrl}
										target="_blank"
										rel="noopener noreferrer"
										aria-label={`${_("Download PDF")} — ${m.name}`}
										class="group/dl bg-primary text-primary-foreground font-technical-data focus-visible:outline-secondary inline-flex w-full items-center justify-center gap-2 rounded-lg px-4 py-2.5 text-xs whitespace-nowrap shadow-xs transition-[opacity,box-shadow] hover:opacity-90 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 sm:w-auto"
									>
										<Download
											class="h-3.5 w-3.5 transition-transform duration-200 group-hover/dl:translate-y-0.5"
											aria-hidden="true"
										/>
										<span>{_("Download PDF")}</span>
									</a>
								</div>
							</div>
						</footer>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* Hidden only once the script has confirmed the animation will run */
		[data-anim="ready"] .cred-card,
		[data-anim="ready"] .cred-feature {
			opacity: 0;
		}

		[data-anim="in"] .cred-card {
			animation: cred-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(var(--i, 0) * 150ms);
		}
		[data-anim="in"] .cred-feature {
			animation: cred-slide 0.5s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(0.35s + var(--i, 0) * 150ms + var(--fi, 0) * 90ms);
		}
	}

	/* --i lives on the card, so the features inherit it through the cascade */
	@keyframes cred-rise {
		from {
			opacity: 0;
			transform: translateY(24px);
		}
	}
	@keyframes cred-slide {
		from {
			opacity: 0;
			transform: translateX(-12px);
		}
	}
</style>

<script>
	import { revealOnce } from "@/lib/anims/reveal-once";

	const grid = document.querySelector<HTMLElement>("[data-credentials-grid]");
	if (grid) revealOnce(grid, 0.2);
</script>
