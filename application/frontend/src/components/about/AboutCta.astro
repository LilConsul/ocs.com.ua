---
import { ArrowRight, PhoneCall } from "@lucide/astro";
import companyData from "@/data/company.json";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const _ = getInlineTranslations(lang);
---

<section
	aria-labelledby="cta-heading"
	class="from-background to-surface-container/60 relative w-full overflow-hidden bg-linear-to-b py-16 lg:py-24"
>
	<div
		class="reveal-glow bg-secondary/10 pointer-events-none absolute -bottom-40 -left-24 size-120 rounded-full blur-3xl"
		aria-hidden="true"
	>
	</div>

	<div class="px-edge-margin relative mx-auto max-w-7xl">
		<div
			class="reveal bg-background border-border-subtle/70 rounded-xl border p-5 shadow-sm sm:p-10 lg:p-12"
		>
			<div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
				<div class="max-w-2xl min-w-0">
					<span
						class="reveal font-label-caps text-secondary flex items-center gap-3 text-xs font-semibold tracking-widest uppercase"
						style="--i:1"
					>
						<span class="eyebrow-rule bg-secondary h-px w-8" aria-hidden="true"></span>
						{_("Contact Us")}
					</span>
					<h2
						id="cta-heading"
						class="reveal font-headline-lg text-foreground mt-3 text-2xl font-semibold tracking-tight text-balance wrap-break-word sm:text-3xl lg:text-4xl"
						style="--i:2"
					>
						{_("Let's Talk About Your Production Line")}
					</h2>
					<p
						class="reveal font-body-md text-industrial-gray mt-4 text-sm leading-relaxed wrap-break-word sm:text-base"
						style="--i:3"
					>
						{
							_(
								"Tell us what you produce and what you need to inspect. We will recommend suitable equipment and prepare a quote."
							)
						}
					</p>
				</div>

				<div class="reveal flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col" style="--i:4">
					<a href={`/${lang}/contact/`} class="btn-primary press group w-full sm:w-auto">
						<span>{_("Request a quote")}</span>
						<ArrowRight
							class="size-4.5 transition-transform duration-(--dur-fast) group-hover:translate-x-1"
							aria-hidden="true"
						/>
					</a>
					<a
						href={`tel:${companyData.phone.replace(/\s+/g, "")}`}
						class="btn-secondary press w-full sm:w-auto"
					>
						<PhoneCall class="size-4.5" aria-hidden="true" />
						<span>{companyData.phone}</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
