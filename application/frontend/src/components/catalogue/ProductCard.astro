---
import { Image } from "astro:assets";
import { getInlineTranslations, type Lang } from "@/i18n";
import { productUrl } from "@/lib/catalogue-urls";
import { type EquipmentEntry, flattenSpecs, getCategory, getSlug } from "@/lib/content-utils";

interface Props {
	product: EquipmentEntry;
	lang: Lang;
	index?: number;
	gallery?: string[];
}

const { product, lang, index = 0, gallery } = Astro.props;
const _ = getInlineTranslations(lang);

// Extract fields using clean names (no prefixes!)
const title = product.data.title ?? "";
const description = product.data.description;
const specs = flattenSpecs(product.data.specs)
	.slice(0, 2)
	.map((spec) => ({ ...spec, value: spec.value.split(",")[0].trim() }));
const firstImage = gallery?.[0] || product.data.gallery?.[0] || "/placeholder.svg";

// Build product URL
const href = productUrl(lang, getCategory(product), getSlug(product));
---

<article
	class="product-card group bg-background border-border-subtle/70 hover:border-secondary/40 flex flex-col overflow-hidden rounded-xl border shadow-xs transition-[translate,box-shadow,border-color] duration-300 hover:shadow-lg motion-safe:hover:-translate-y-0.5"
	style={`--i:${index % 3}`}
>
	<div
		class="border-border-subtle/40 relative flex aspect-[4/3] items-center justify-center border-b bg-white p-4"
	>
		<Image
			src={firstImage}
			alt={title}
			width={800}
			height={600}
			class="h-full w-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105"
			loading="eager"
		/>
	</div>

	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<h3
			class="font-headline-lg text-foreground m-0 mb-2 text-lg leading-snug font-semibold text-balance break-words"
		>
			{title}
		</h3>
		<p class="font-body-md text-industrial-gray m-0 mb-5 line-clamp-2 text-sm leading-relaxed break-words">
			{description}
		</p>

		<div class="mt-auto">
			{
				specs.length > 0 && (
					<dl class="m-0 mb-5 grid grid-cols-2 gap-2 p-0">
						{specs.map((spec: { label: string; value: string }) => (
							<div class="bg-surface-container border-border-subtle/50 min-w-0 rounded-lg border px-2.5 sm:px-3 py-2">
								<dt class="font-label-caps text-industrial-gray mb-0.5 truncate text-[10px] uppercase">
									{spec.label}
								</dt>
								<dd class="font-technical-data text-foreground m-0 text-xs sm:text-sm font-bold truncate">
									{spec.value}
								</dd>
							</div>
						))}
					</dl>
				)
			}

			<a
				href={href}
				class="border-secondary/40 text-secondary group-hover:border-secondary group-hover:bg-secondary/5 focus-visible:outline-secondary font-technical-data flex w-full items-center justify-center gap-2 rounded-lg border py-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
			>
				{_("Technical Details")}
				<span
					class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1"
					>arrow_forward</span
				>
			</a>
		</div>
	</div>
</article>

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* The ancestor lives in the page, so it must be matched globally */
		:global([data-anim="ready"]) .product-card {
			opacity: 0;
		}
		:global([data-anim="in"]) .product-card {
			animation: product-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(var(--i, 0) * 100ms);
		}
	}

	@keyframes product-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}
</style>
