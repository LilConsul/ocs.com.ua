---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import { productUrl } from "@/lib/catalogue-urls";
import { containScale } from "@/lib/contain-scale";
import {
	type EquipmentEntry,
	flattenSpecs,
	getCategoriesForLocale,
	getCategory,
	getSlug,
} from "@/lib/content-utils";
import { shortTitle, summarize } from "@/lib/featured-equipment";
import { PLACEHOLDER_IMAGE } from "@/lib/placeholder";

interface Props {
	product: EquipmentEntry;
	lang: Lang;
	index?: number;
	gallery?: ImageMetadata[];
	/** First row of the grid: load right away (the first card with high priority) and show from the
	 * first frame (no scroll reveal), everything else lazily and revealed on scroll */
	eager?: boolean;
}

const { product, lang, index = 0, gallery, eager = false } = Astro.props;
const _ = getInlineTranslations(lang);

const title = product.data.title ?? "";
const description = product.data.description;
const model = getSlug(product).toUpperCase();
const subtitle = shortTitle(title, model);
const summary =
	summarize(description, 160) ||
	_("Full specifications and configurations are on the product page.");
const categorySlug = getCategory(product);
const categoryTitle =
	getCategoriesForLocale(lang).find((c) => c.slug === categorySlug)?.title ?? categorySlug;
// First value of each spec ("1500 g, 3000 g" shows "1500 g"); with no specs, the category
const specs = flattenSpecs(product.data.specs)
	.slice(0, 2)
	.map((spec) => ({ label: spec.label, value: spec.value.split(",")[0].trim() }));
const cells = specs.length > 0 ? specs : [{ label: _("Category"), value: categoryTitle }];
// gallery comes from getGallery(), which already left out images missing from src/assets/
const firstImage = gallery?.[0] || PLACEHOLDER_IMAGE;
// The picture is object-contain in a box of about 1.37:1, so a square photo fills only 73% of the
// box width. sizes is the content box (card width minus padding) times that share, one entry per
// layout: 1 column, 2 columns, 2 columns beside the sidebar, 3 columns beside the sidebar
const share = containScale(firstImage, 1.37);
const sizes = [
	`(min-width: 1280px) calc(min(355px, 33.33vw - 11.1rem) * ${share})`,
	`(min-width: 1024px) calc((50vw - 14.9rem) * ${share})`,
	`(min-width: 768px) calc((50vw - 4.75rem) * ${share})`,
	`calc((100vw - 4rem) * ${share})`,
].join(", ");
const href = productUrl(lang, categorySlug, getSlug(product));
---

{/* Five rows shared with the other cards of the grid row (subgrid), so links and specs line up */}
<a
	href={href}
	class:list={[
		"card-hover product-card group bg-background border-border-subtle/70 focus-visible:outline-secondary row-span-5 grid grid-rows-subgrid gap-y-0 overflow-hidden rounded-xl border shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2",
		!eager && "reveal",
	]}
	style={`--i:${index % 3}`}
	data-product-item
	data-product-text={`${title} ${description ?? ""}`.toLowerCase()}
>
	<div class="skeleton border-border-subtle/40 bg-surface-container/60 relative flex aspect-4/3 items-center justify-center border-b p-4">
		<Image
			src={firstImage}
			alt={title}
			widths={[280, 440, 640, 800]}
			sizes={sizes}
			format="webp"
			class="h-full w-full object-contain mix-blend-multiply dark:mix-blend-normal"
			loading={eager ? "eager" : "lazy"}
			fetchpriority={eager && index === 0 ? "high" : undefined}
		/>
		{product.data.manufacturer && (
			<span class="bg-background text-secondary border-border-subtle/60 font-label-caps absolute top-4 left-4 rounded-full border px-3 py-1 text-[11px] font-semibold tracking-widest uppercase shadow-xs">
				{product.data.manufacturer}
			</span>
		)}
	</div>

	<div class="px-5 pt-5 sm:px-6 sm:pt-6">
		<h3 class="font-headline-lg text-foreground m-0 text-2xl leading-tight font-semibold tracking-tight [overflow-wrap:anywhere]">
			{model}
		</h3>
		<span class="font-body-md text-industrial-gray mt-2 block text-[15px] leading-snug font-medium text-balance">
			{subtitle}
		</span>
	</div>

	<p class="font-body-md text-industrial-gray m-0 px-5 pt-3 text-sm leading-relaxed text-pretty sm:px-6">
		{summary}
	</p>

	<div class="text-secondary flex items-end px-5 pt-4 pb-5 text-[15px] font-medium sm:px-6 sm:pb-6">
		<span class="inline-flex items-center gap-2">
			{_("Technical Details")}
			<ArrowRight
				class="size-4 transition-transform duration-(--dur-fast) group-hover:translate-x-1"
				aria-hidden="true"
			/>
		</span>
	</div>

	<dl
		class:list={[
			"border-border-subtle/50 bg-border-subtle/50 m-0 grid gap-px border-t p-0",
			cells.length > 1 ? "grid-cols-2" : "grid-cols-1",
		]}
	>
		{cells.map((cell) => (
			<div class="bg-background min-w-0 px-4 py-3 sm:px-5">
				<dt class="font-label-caps text-industrial-gray mb-1 text-[10px] tracking-wider uppercase">
					{cell.label}
				</dt>
				<dd class="font-headline-lg text-foreground m-0 text-base font-semibold tracking-tight [overflow-wrap:anywhere]">
					{cell.value}
				</dd>
			</div>
		))}
	</dl>
</a>
