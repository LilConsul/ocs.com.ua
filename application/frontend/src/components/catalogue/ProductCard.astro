---
import { Image } from "astro:assets";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	product: any;
	lang: Lang;
}

const { product, lang } = Astro.props;
const _ = getInlineTranslations(lang);

// Extract multilingual fields
const title = product.data[`${lang}-title`];
const description = product.data[`${lang}-description`];
const specs = product.data.specs?.slice(0, 2) || []; // Max 2 specs for cleaner layout
const firstImage = product.data.gallery?.[0] || "/placeholder.jpg";

// Build product URL
const categorySlug = product.id.split("/")[0];
const productSlug = product.id.split("/")[1].replace(".md", "");
const productUrl = `/${lang}/catalogue/${categorySlug}/${productSlug}`;
---

<article
	class="bg-card border-border group flex flex-col overflow-hidden rounded-lg border transition-all duration-300 hover:shadow-md"
>
	<div
		class="bg-background border-border relative flex aspect-[4/3] items-center justify-center border-b p-4"
	>
		<Image
			src={firstImage}
			alt={title}
			width={800}
			height={600}
			class="h-full w-full object-contain mix-blend-multiply transition-transform duration-500 group-hover:scale-105"
			loading="lazy"
		/>
	</div>

	<!-- Content - Compact spacing, clear hierarchy -->
	<div class="flex flex-1 flex-col p-4">
		<h3 class="font-heading text-foreground mb-2 text-xl leading-tight font-medium">
			{title}
		</h3>
		<p class="text-muted-foreground mb-4 line-clamp-2 text-sm leading-relaxed">
			{description}
		</p>

		<!-- Specs grid - Technical precision aesthetic -->
		{
			specs.length > 0 && (
				<div class="border-border mt-auto mb-4 grid grid-cols-2 gap-4 border-t pt-3">
					{specs.map((spec: { "en-label": string; "ua-label": string; value: string }) => (
						<div>
							<p class="text-muted-foreground mb-1 font-mono text-[10px] tracking-[0.05em] uppercase">
								{spec[`${lang}-label`]}
							</p>
							<p class="text-foreground font-mono text-sm font-medium">{spec.value}</p>
						</div>
					))}
				</div>
			)
		}

		<!-- CTA - Reserved accent color -->
		<a
			href={productUrl}
			class="bg-background border-border text-foreground hover:bg-muted group-hover:border-primary flex w-full items-center justify-center gap-2 rounded border py-2.5 text-sm font-medium transition-colors"
		>
			{_("Technical Details")}
			<span
				class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1"
				>arrow_forward</span
			>
		</a>
	</div>
</article>
