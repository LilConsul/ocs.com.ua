---
import { Image } from "astro:assets";
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	images?: string[];
	title: string;
	lang: Lang;
}

const { images = [], title, lang } = Astro.props;
const _ = getInlineTranslations(lang);

const galleryImages = images.length > 0 ? images : ["/placeholder.jpg"];
const hasMultiple = galleryImages.length > 1;
---

<div
	class="product-gallery-container w-full select-none"
	data-images={JSON.stringify(galleryImages)}
>
	{/* Main Interactive Viewer Card */}
	<div
		class="group border-border-subtle/70 hover:border-secondary/40 before:from-secondary relative aspect-[4/3] w-full overflow-hidden rounded-xl border bg-white shadow-xs transition-[box-shadow,border-color] duration-300 before:absolute before:inset-x-0 before:top-0 before:z-10 before:h-0.5 before:bg-linear-to-r before:to-transparent hover:shadow-lg md:aspect-[16/10]"
	>
		{/* Top Badges Bar */}
		<div
			class="pointer-events-none absolute inset-x-0 top-0 z-10 flex items-center justify-between p-4"
		>
			{
				hasMultiple ? (
					<span
						id="gallery-badge-counter"
						class="border-border/60 bg-background/80 text-muted-foreground pointer-events-auto inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 font-mono text-[11px] font-medium shadow-2xs backdrop-blur-md"
					>
						<span class="bg-secondary inline-block h-1.5 w-1.5 rounded-full" />
						<span id="gallery-badge-text">
							01 / {galleryImages.length < 10 ? `0${galleryImages.length}` : galleryImages.length}
						</span>
					</span>
				) : (
					<span />
				)
			}

			<button
				type="button"
				id="gallery-expand-btn"
				class="border-border/60 bg-background/80 text-muted-foreground hover:bg-background hover:text-foreground pointer-events-auto inline-flex h-8 w-8 items-center justify-center rounded-lg border shadow-2xs backdrop-blur-md transition-all hover:scale-105 active:scale-95"
				aria-label={_("Expand image")}
				title={_("Expand image")}
			>
				<span class="material-symbols-outlined text-[18px]">zoom_out_map</span>
			</button>
		</div>

		{/* Main Image Frame */}
		<div class="flex h-full w-full items-center justify-center p-6 md:p-8">
			<Image
				id="gallery-main-image"
				src={galleryImages[0]}
				alt={title}
				width={800}
				height={600}
				class="max-h-full max-w-full cursor-zoom-in object-contain drop-shadow-sm transition-transform duration-300 ease-out group-hover:scale-[1.02]"
				loading="eager"
			/>
		</div>

		{/* Hover Prev/Next Navigation Controls */}
		{
			hasMultiple && (
				<>
					<button
						type="button"
						id="gallery-card-prev"
						class="border-border/70 bg-background/85 text-muted-foreground hover:bg-background hover:text-foreground absolute top-1/2 left-3 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border opacity-0 shadow-sm backdrop-blur-md transition-all duration-200 group-hover:opacity-100 hover:scale-105 active:scale-95"
						aria-label={_("Previous image")}
					>
						<span class="material-symbols-outlined text-[20px]">chevron_left</span>
					</button>
					<button
						type="button"
						id="gallery-card-next"
						class="border-border/70 bg-background/85 text-muted-foreground hover:bg-background hover:text-foreground absolute top-1/2 right-3 flex h-9 w-9 -translate-y-1/2 items-center justify-center rounded-full border opacity-0 shadow-sm backdrop-blur-md transition-all duration-200 group-hover:opacity-100 hover:scale-105 active:scale-95"
						aria-label={_("Next image")}
					>
						<span class="material-symbols-outlined text-[20px]">chevron_right</span>
					</button>
				</>
			)
		}
	</div>

	{/* Thumbnail Rail (shadcn Tabs / Selector Style) */}
	{
		hasMultiple && (
			<div
				class="mt-3.5 flex items-center gap-2.5 overflow-x-auto p-1"
				role="tablist"
				aria-label={_("Product image thumbnails")}
			>
				{galleryImages.map((img, idx) => (
						<button
							type="button"
							class={`gallery-thumb group bg-white relative aspect-[4/3] h-18 shrink-0 cursor-pointer overflow-hidden rounded-lg border p-1.5 transition-all duration-200 ${
								idx === 0
									? "border-secondary ring-secondary/20 ring-offset-background opacity-100 shadow-xs ring-2 ring-offset-2"
									: "border-border/60 hover:border-border opacity-60 hover:opacity-100"
							}`}
							data-index={idx}
							aria-label={`${_("View image")} ${idx + 1}`}
							role="tab"
							aria-selected={idx === 0 ? "true" : "false"}
						>
							<Image
								src={img}
								alt={`${title} - ${idx + 1}`}
								width={160}
								height={120}
								class="h-full w-full object-contain transition-transform duration-200 group-hover:scale-105"
								loading="eager"
							/>
						</button>
					))}
			</div>
		)
	}

	{/* Lightbox Modal (shadcn Dialog style) */}
	<dialog
		id="gallery-lightbox"
		class="bg-background/90 backdrop:bg-background/90 animate-in fade-in-0 fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none p-0 backdrop-blur-xl duration-200 open:flex open:flex-col open:items-center open:justify-center"
		aria-label={_("Image lightbox")}
	>
		<div
			class="relative flex h-full w-full max-w-6xl flex-col items-center justify-between p-4 md:p-6"
		>
			{/* Lightbox Header */}
			<div class="border-border/40 flex w-full items-center justify-between border-b pb-4">
				<div class="flex min-w-0 items-center gap-3">
					<span class="font-heading text-foreground text-sm font-semibold truncate md:text-base"
						>{title}</span
					>
					<span
						id="lightbox-counter"
						class="border-border/60 bg-muted/60 text-muted-foreground rounded-full border px-2.5 py-0.5 font-mono text-xs"
					>
						01 / {galleryImages.length < 10 ? `0${galleryImages.length}` : galleryImages.length}
					</span>
				</div>

				<div class="flex items-center gap-2">
					<kbd
						class="border-border/60 bg-muted/50 text-muted-foreground hidden rounded border px-2 py-0.5 font-mono text-[11px] md:inline-block"
					>
						ESC
					</kbd>
					<button
						type="button"
						id="lightbox-close-btn"
						class="border-border/60 bg-background text-muted-foreground hover:bg-muted hover:text-foreground flex h-9 w-9 items-center justify-center rounded-lg border transition-all active:scale-95"
						aria-label={_("Close preview")}
					>
						<span class="material-symbols-outlined text-[20px]">close</span>
					</button>
				</div>
			</div>

			{/* Main Lightbox Image Viewport */}
			<div class="relative flex max-h-[75vh] w-full flex-1 items-center justify-center p-4">
				<Image
					id="lightbox-image"
					src={galleryImages[0]}
					alt={title}
					width={1200}
					height={900}
					class="max-h-[70vh] max-w-full object-contain drop-shadow-md transition-all duration-200"
					loading="lazy"
				/>

				{/* Navigation Buttons in Lightbox */}
				{
					hasMultiple && (
						<>
							<button
								type="button"
								id="lightbox-prev-btn"
								class="border-border/80 bg-background/90 text-foreground hover:bg-background absolute top-1/2 left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border shadow-md backdrop-blur-md transition-all hover:scale-105 active:scale-95"
								aria-label={_("Previous image")}
							>
								<span class="material-symbols-outlined text-[24px]">chevron_left</span>
							</button>
							<button
								type="button"
								id="lightbox-next-btn"
								class="border-border/80 bg-background/90 text-foreground hover:bg-background absolute top-1/2 right-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border shadow-md backdrop-blur-md transition-all hover:scale-105 active:scale-95"
								aria-label={_("Next image")}
							>
								<span class="material-symbols-outlined text-[24px]">chevron_right</span>
							</button>
						</>
					)
				}
			</div>

			{/* Lightbox Bottom Thumbnail Bar */}
			{
				hasMultiple && (
					<div class="border-border/40 flex items-center gap-2 overflow-x-auto border-t pt-4 pb-2">
						{galleryImages.map((img, idx) => (
								<button
									type="button"
									class="lightbox-thumb bg-muted/40 aspect-[4/3] h-14 shrink-0 cursor-pointer overflow-hidden rounded-lg border p-1 transition-all"
									data-index={idx}
									aria-label={`${_("View image")} ${idx + 1}`}
								>
									<Image
										src={img}
										alt={`${title} - ${idx + 1}`}
										width={100}
										height={75}
										class="h-full w-full object-contain"
									/>
								</button>
							))}
					</div>
				)
			}
		</div>
	</dialog>
</div>

<script>
	function setupGallery() {
		const container = document.querySelector<HTMLElement>(".product-gallery-container");
		if (!container) return;

		const imagesData = container.dataset.images;
		if (!imagesData) return;

		let images: string[] = [];
		try {
			images = JSON.parse(imagesData);
		} catch {
			return;
		}

		let activeIndex = 0;
		const total = images.length;
		const padNum = (num: number) => (num < 10 ? `0${num}` : `${num}`);

		const mainImg = container.querySelector<HTMLImageElement>("#gallery-main-image");
		const badgeText = container.querySelector<HTMLElement>("#gallery-badge-text");
		const thumbs = container.querySelectorAll<HTMLButtonElement>(".gallery-thumb");
		const expandBtn = container.querySelector<HTMLButtonElement>("#gallery-expand-btn");
		const cardPrev = container.querySelector<HTMLButtonElement>("#gallery-card-prev");
		const cardNext = container.querySelector<HTMLButtonElement>("#gallery-card-next");

		const lightbox = container.querySelector<HTMLDialogElement>("#gallery-lightbox");
		const lightboxImg = container.querySelector<HTMLImageElement>("#lightbox-image");
		const lightboxCounter = container.querySelector<HTMLElement>("#lightbox-counter");
		const lightboxClose = container.querySelector<HTMLButtonElement>("#lightbox-close-btn");
		const lightboxPrev = container.querySelector<HTMLButtonElement>("#lightbox-prev-btn");
		const lightboxNext = container.querySelector<HTMLButtonElement>("#lightbox-next-btn");
		const lightboxThumbs = container.querySelectorAll<HTMLButtonElement>(".lightbox-thumb");

		function setActiveImage(index: number) {
			if (index < 0 || index >= images.length) return;
			activeIndex = index;

			if (mainImg) {
				mainImg.src = images[activeIndex];
			}
			if (badgeText) {
				badgeText.textContent = `${padNum(activeIndex + 1)} / ${padNum(total)}`;
			}
			if (lightboxImg) {
				lightboxImg.src = images[activeIndex];
			}
			if (lightboxCounter) {
				lightboxCounter.textContent = `${padNum(activeIndex + 1)} / ${padNum(total)}`;
			}

			thumbs.forEach((thumb, i) => {
				const isCurrent = i === activeIndex;
				thumb.setAttribute("aria-selected", isCurrent ? "true" : "false");
				if (isCurrent) {
					thumb.classList.add(
						"border-secondary",
						"ring-2",
						"ring-secondary/20",
						"ring-offset-2",
						"opacity-100",
						"shadow-xs"
					);
					thumb.classList.remove("border-border/60", "opacity-60");
				} else {
					thumb.classList.remove(
						"border-secondary",
						"ring-2",
						"ring-secondary/20",
						"ring-offset-2",
						"opacity-100",
						"shadow-xs"
					);
					thumb.classList.add("border-border/60", "opacity-60");
				}
			});

			lightboxThumbs.forEach((thumb, i) => {
				const isCurrent = i === activeIndex;
				if (isCurrent) {
					thumb.classList.add("border-secondary", "ring-2", "ring-secondary/20", "opacity-100");
					thumb.classList.remove("border-border/60", "opacity-50");
				} else {
					thumb.classList.remove("border-secondary", "ring-2", "ring-secondary/20", "opacity-100");
					thumb.classList.add("border-border/60", "opacity-50");
				}
			});
		}

		thumbs.forEach((thumb) => {
			thumb.addEventListener("click", () => {
				const idx = Number.parseInt(thumb.dataset.index || "0", 10);
				setActiveImage(idx);
			});
		});

		lightboxThumbs.forEach((thumb) => {
			thumb.addEventListener("click", () => {
				const idx = Number.parseInt(thumb.dataset.index || "0", 10);
				setActiveImage(idx);
			});
		});

		cardPrev?.addEventListener("click", (e) => {
			e.stopPropagation();
			const prev = (activeIndex - 1 + total) % total;
			setActiveImage(prev);
		});

		cardNext?.addEventListener("click", (e) => {
			e.stopPropagation();
			const next = (activeIndex + 1) % total;
			setActiveImage(next);
		});

		function openLightbox() {
			if (!lightbox) return;
			setActiveImage(activeIndex);
			lightbox.showModal();
			document.body.style.overflow = "hidden";
		}

		function closeLightbox() {
			if (!lightbox) return;
			lightbox.close();
			document.body.style.overflow = "";
		}

		mainImg?.addEventListener("click", openLightbox);
		expandBtn?.addEventListener("click", openLightbox);
		lightboxClose?.addEventListener("click", closeLightbox);

		lightbox?.addEventListener("click", (e) => {
			if (e.target === lightbox) {
				closeLightbox();
			}
		});

		lightboxPrev?.addEventListener("click", (e) => {
			e.stopPropagation();
			const prev = (activeIndex - 1 + total) % total;
			setActiveImage(prev);
		});

		lightboxNext?.addEventListener("click", (e) => {
			e.stopPropagation();
			const next = (activeIndex + 1) % total;
			setActiveImage(next);
		});

		window.addEventListener("keydown", (e) => {
			if (!lightbox || !lightbox.open) return;
			if (e.key === "Escape") {
				closeLightbox();
			} else if (e.key === "ArrowLeft") {
				const prev = (activeIndex - 1 + total) % total;
				setActiveImage(prev);
			} else if (e.key === "ArrowRight") {
				const next = (activeIndex + 1) % total;
				setActiveImage(next);
			}
		});
	}

	setupGallery();
	document.addEventListener("astro:page-load", setupGallery);
</script>
