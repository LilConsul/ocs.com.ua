---
import { getInlineTranslations, type Lang } from "@/i18n";
import { categoryUrl, industryUrl } from "@/lib/catalogue-urls";
import type { EquipmentType, Industry, ProductSearchEntry } from "@/lib/content-utils";

interface Props {
	allCategories: EquipmentType[];
	allIndustries: Industry[];
	/** Which accordion section renders open */
	section: "equipment" | "industry";
	/** Slug of the active category (equipment) or industry (industry) */
	activeSlug: string;
	lang: Lang;
	/** All locale products for cross-category search */
	productSearchIndex?: ProductSearchEntry[];
}

const {
	allCategories,
	allIndustries,
	section,
	activeSlug,
	lang,
	productSearchIndex = [],
} = Astro.props;
const _ = getInlineTranslations(lang);

// Array order is the display order
const sections = [
	{
		id: "equipment",
		label: _("Equipment Categories"),
		navLabel: _("Category navigation"),
		items: allCategories,
		hrefFor: (slug: string) => categoryUrl(lang, slug),
	},
	{
		id: "industry",
		label: _("Industries"),
		navLabel: _("Industry navigation"),
		items: allIndustries,
		hrefFor: (slug: string) => industryUrl(lang, slug),
	},
];
---

{/* Mobile Filter Button */}
<button
	id="mobile-filter-toggle"
	class="bg-background border-border-subtle text-foreground hover:border-secondary/40 focus-visible:outline-secondary fixed right-6 bottom-6 z-40 flex items-center gap-2 rounded-full border px-6 py-3 shadow-lg transition-[box-shadow,border-color] hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 lg:hidden"
	aria-label={_("Open filters")}
>
	<span class="material-symbols-outlined text-[20px]">filter_list</span>
	<span class="text-sm font-medium">{_("Filters")}</span>
</button>

{/* Mobile Filter Overlay */}
<div
	id="mobile-filter-overlay"
	class="fixed inset-0 z-50 hidden bg-black/50 backdrop-blur-sm lg:hidden"
	aria-hidden="true"
>
</div>

{/* Desktop Sidebar & Mobile Drawer */}
<aside
	id="catalogue-sidebar"
	class="fixed inset-y-0 left-0 z-50 w-80 -translate-x-full transition-transform duration-(--dur-base) lg:sticky lg:top-[calc(6rem+var(--banner-h,0px))] lg:z-10 lg:h-fit lg:w-72 lg:shrink-0 lg:translate-x-0"
>
	<div
		class="bg-background border-border-subtle/70 before:from-secondary relative h-full w-full overflow-y-auto rounded-none border-r px-5 py-8 shadow-xs before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-linear-to-r before:to-transparent lg:rounded-xl lg:border lg:px-6"
	>
		{/* Close button (mobile only) */}
		<button
			id="mobile-filter-close"
			class="text-muted-foreground hover:text-foreground absolute top-4 right-4 transition-colors lg:hidden"
			aria-label={_("Close filters")}
		>
			<span class="material-symbols-outlined text-[24px]">close</span>
		</button>
		{/* Header with generous spacing */}
		<div class="mb-6 px-2">
			<h2 class="font-headline-lg text-foreground mb-1 text-xl font-semibold tracking-tight">
				{_("Catalogue Filters")}
			</h2>
			<p class="font-technical-data text-industrial-gray text-xs tracking-wide">
				{_("Technical Specs")}
			</p>
		</div>

		{/* Product search */}
		<div class="mb-5 px-1">
			<div class="relative">
				<span
					class="material-symbols-outlined text-industrial-gray pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-[18px]"
					aria-hidden="true">search</span
				>
				<input
					type="search"
					class="font-body-md text-foreground placeholder:text-industrial-gray/70 border-border-subtle bg-surface-container focus-visible:outline-secondary h-10 w-full rounded-lg border pr-3 pl-9 text-sm shadow-xs transition-shadow focus-visible:outline-2 focus-visible:outline-offset-2"
					placeholder={_("Search products…")}
					aria-label={_("Search products…")}
					data-product-search-input
					data-label-technical-details={_("Technical Details")}
					data-label-no-results={_("No products match your search. Try browsing another category.")}
				/>
			</div>
		</div>

		{/* JSON index for cross-category search — read by the sidebar script */}
		<script
			is:inline
			type="application/json"
			data-product-index
			set:html={JSON.stringify(productSearchIndex)}
		/>

		{/* Exclusive accordion: opening one section closes the other */}
		<div class="space-y-3">
			{
				sections.map((s) => {
					const open = s.id === section;

					return (
						<div data-sidebar-section={s.id} data-open={open ? "true" : "false"}>
							<h3 class="m-0">
								<button
									type="button"
									id={`sidebar-trigger-${s.id}`}
									data-sidebar-toggle
									aria-expanded={open ? "true" : "false"}
									aria-controls={`sidebar-body-${s.id}`}
									class="font-label-caps text-secondary focus-visible:outline-secondary flex w-full cursor-pointer items-center gap-3 rounded-lg px-2 py-2 text-left text-xs font-semibold tracking-widest uppercase focus-visible:outline-2 focus-visible:outline-offset-2"
								>
									<span class="eyebrow-rule bg-secondary h-px w-6" aria-hidden="true" />
									<span class="flex-1">{s.label}</span>
									<svg
										xmlns="http://www.w3.org/2000/svg"
										width="16"
										height="16"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="sidebar-chevron"
										aria-hidden="true"
									>
										<path d="m6 9 6 6 6-6" />
									</svg>
								</button>
							</h3>

							{/* Grid-rows transition: 0fr (closed) to 1fr (open); the body is `hidden` when closed */}
							<div class="sidebar-panel">
								<div
									id={`sidebar-body-${s.id}`}
									data-sidebar-body
									class="min-h-0 overflow-hidden"
									hidden={!open}
								>
									<nav aria-label={s.navLabel} class="space-y-1.5 px-0.5 py-1">
										{s.items.map((item) => {
											const isActive = open && item.slug === activeSlug;

											return (
												<a
													href={s.hrefFor(item.slug)}
													aria-current={isActive ? "page" : undefined}
													class={`focus-visible:outline-secondary flex cursor-pointer items-center gap-3 rounded-lg border px-4 py-3 transition-[background-color,border-color,color,translate] focus-visible:outline-2 focus-visible:outline-offset-2 ${
														isActive
															? "border-secondary/30 bg-secondary/10 text-secondary font-bold"
															: "text-industrial-gray hover:bg-surface-container hover:border-border-subtle/60 border-transparent hover:translate-x-1"
													}`}
												>
													<span class="material-symbols-outlined text-[20px]">
														{item.icon || "category"}
													</span>
													<span class="font-technical-data text-xs tracking-wider uppercase">
														{item.title}
													</span>
												</a>
											);
										})}
									</nav>
								</div>
							</div>
						</div>
					);
				})
			}
		</div>

		{/* CTA button */}
		<div class="border-border-subtle/60 mt-8 border-t px-2 pt-6">
			<a href={`/${lang}/contact`} class="btn-primary press group w-full">
				{_("Contact Us")}
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="lucide lucide-arrow-right transition-transform duration-(--dur-fast) group-hover:translate-x-1"
					aria-hidden="true"
				>
					<path d="M5 12h14"></path>
					<path d="m12 5 7 7-7 7"></path>
				</svg>
			</a>
		</div>
	</div>
</aside>

<style>
	.sidebar-panel {
		display: grid;
		grid-template-rows: 0fr;
	}
	[data-open="true"] > .sidebar-panel {
		grid-template-rows: 1fr;
	}
	.sidebar-chevron {
		transition: none;
	}
	[data-open="true"] .sidebar-chevron {
		rotate: 180deg;
	}

	@media (prefers-reduced-motion: no-preference) {
		.sidebar-panel {
			transition: grid-template-rows 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		}
		.sidebar-chevron {
			transition: rotate 0.3s cubic-bezier(0.22, 1, 0.36, 1);
		}
	}
</style>

<script>
	import { observeReveals } from "@/lib/anims/reveal";

	const toggleBtn = document.getElementById("mobile-filter-toggle");
	const closeBtn = document.getElementById("mobile-filter-close");
	const overlay = document.getElementById("mobile-filter-overlay");
	const sidebar = document.getElementById("catalogue-sidebar");

	function openFilters() {
		sidebar?.classList.remove("-translate-x-full");
		overlay?.classList.remove("hidden");
		document.body.style.overflow = "hidden";
	}

	function closeFilters() {
		sidebar?.classList.add("-translate-x-full");
		overlay?.classList.add("hidden");
		document.body.style.overflow = "";
	}

	toggleBtn?.addEventListener("click", openFilters);
	closeBtn?.addEventListener("click", closeFilters);
	overlay?.addEventListener("click", closeFilters);

	const trimSlash = (path: string) => path.replace(/\/+$/, "");
	const getResults = () => document.querySelector<HTMLElement>("[data-catalogue-results]");

	function getSearchQuery(): string {
		return new URLSearchParams(location.search).get("q") ?? "";
	}

	function setSearchQuery(q: string): void {
		const url = new URL(location.href);
		if (q) {
			url.searchParams.set("q", q);
		} else {
			url.searchParams.delete("q");
		}
		history.replaceState(history.state, "", url);
	}

	const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	const getSections = () =>
		Array.from(sidebar?.querySelectorAll<HTMLElement>("[data-sidebar-section]") ?? []);

	/*
	 * Accordion. A section is open when data-open="true"; the CSS grid-rows transition animates
	 * the height. The body keeps the `hidden` attribute while closed, so its links are not
	 * reachable by keyboard or screen readers. It is removed before opening and set again once
	 * the closing transition has finished.
	 */
	const hideTimers = new WeakMap<HTMLElement, number>();

	function setSectionOpen(section: HTMLElement, open: boolean) {
		if ((section.dataset.open === "true") === open) return;

		const trigger = section.querySelector<HTMLElement>("[data-sidebar-toggle]");
		const body = section.querySelector<HTMLElement>("[data-sidebar-body]");
		if (!trigger || !body) return;

		window.clearTimeout(hideTimers.get(body));
		trigger.setAttribute("aria-expanded", String(open));

		if (open) {
			body.hidden = false;
			// Flush styles so the 0fr to 1fr transition starts from the collapsed state
			void body.offsetHeight;
			section.dataset.open = "true";
			return;
		}

		section.dataset.open = "false";
		if (prefersReducedMotion()) {
			body.hidden = true;
			return;
		}
		hideTimers.set(
			body,
			window.setTimeout(() => {
				body.hidden = true;
			}, 320)
		);
	}

	/*
	 * In-place page switching. On a category or industry page the sidebar swaps the hero and the
	 * results instead of reloading, so scroll position and keyboard focus survive. Product pages
	 * have no results container, so their sidebar links navigate normally. Any failure falls back
	 * to a regular navigation.
	 */
	let shownPath = trimSlash(location.pathname);
	let inflight: AbortController | undefined;

	function syncChrome(next: Document) {
		// Sidebar: copy the active-state classes onto the existing links so focus is not lost
		const nextLinks = Array.from(
			next.querySelectorAll<HTMLAnchorElement>("#catalogue-sidebar nav a")
		);
		sidebar?.querySelectorAll<HTMLAnchorElement>("nav a").forEach((link) => {
			const match = nextLinks.find((n) => n.getAttribute("href") === link.getAttribute("href"));
			if (!match) return;
			link.className = match.className;
			const current = match.getAttribute("aria-current");
			if (current) link.setAttribute("aria-current", current);
			else link.removeAttribute("aria-current");
		});

		// Open section follows the fetched page, so back/forward always shows the right one
		next.querySelectorAll<HTMLElement>("[data-sidebar-section]").forEach((nextSection) => {
			const live = getSections().find(
				(s) => s.dataset.sidebarSection === nextSection.dataset.sidebarSection
			);
			if (live) setSectionOpen(live, nextSection.dataset.open === "true");
		});

		// Header links: hrefs depend on the current path (language switcher), classes carry the
		// active-page underline
		const headerLinks = document.querySelectorAll<HTMLAnchorElement>("#main-header a");
		const nextHeaderLinks = next.querySelectorAll<HTMLAnchorElement>("#main-header a");
		if (headerLinks.length === nextHeaderLinks.length) {
			headerLinks.forEach((link, i) => {
				const nextLink = nextHeaderLinks[i];
				const href = nextLink?.getAttribute("href");
				if (href) link.setAttribute("href", href);
				if (nextLink) link.className = nextLink.className;
			});
		}

		// Footer share links point at the current page
		const nextFooter = next.querySelector("footer");
		if (nextFooter) document.querySelector("footer")?.replaceWith(nextFooter);

		document.title = next.title;
	}

	async function swapPage(href: string, push: boolean) {
		const results = getResults();
		if (!results) {
			location.assign(href);
			return;
		}

		inflight?.abort();
		const controller = new AbortController();
		inflight = controller;
		results.setAttribute("aria-busy", "true");

		try {
			const response = await fetch(href, { signal: controller.signal });
			if (!response.ok) throw new Error(`HTTP ${response.status}`);

			const next = new DOMParser().parseFromString(await response.text(), "text/html");
			const nextResults = next.querySelector("[data-catalogue-results]");
			const nextHero = next.querySelector("[data-catalogue-hero]");
			const hero = document.querySelector<HTMLElement>("[data-catalogue-hero]");
			if (!nextResults || !nextHero || !hero) throw new Error("Unexpected page");

			// The hero height depends on the description length; remember where the band sits so
			// the sidebar and grid can be kept in place after the swap
			const band = document.querySelector<HTMLElement>("[data-catalogue-band]");
			const bandTopBefore = band?.getBoundingClientRect().top ?? 0;

			hero.innerHTML = nextHero.innerHTML;
			// The hero is usually off screen after a click, so do not replay its intro animation
			hero.querySelectorAll<HTMLElement>(".hero-rise").forEach((el) => {
				el.style.animation = "none";
			});
			observeReveals(hero);

			// Reset any saved search state so restoration uses the new page's content
			savedResultsHTML = null;
			results.innerHTML = nextResults.innerHTML;
			observeReveals(results);
			setupProductSearch();

			syncChrome(next);

			const url = new URL(href, location.href);
			const q = getSearchQuery();
			if (q) url.searchParams.set("q", q);
			if (push) history.pushState({ catalogue: true }, "", url);
			shownPath = trimSlash(url.pathname);

			if (band) {
				const bandTopAfter = band.getBoundingClientRect().top;
				if (push && bandTopAfter < 0) {
					band.scrollIntoView({
						block: "start",
						behavior: prefersReducedMotion() ? "auto" : "smooth",
					});
				} else if (window.scrollY > 0 && bandTopAfter !== bandTopBefore) {
					window.scrollBy({ top: bandTopAfter - bandTopBefore, behavior: "instant" });
				}
			}

			results.removeAttribute("aria-busy");
		} catch (error) {
			if ((error as Error).name === "AbortError") return;
			location.assign(href);
		}
	}

	sidebar?.addEventListener("click", (event) => {
		const target = event.target as Element;

		// Header buttons only toggle; they never navigate
		const toggle = target.closest<HTMLElement>("[data-sidebar-toggle]");
		if (toggle) {
			const clicked = toggle.closest<HTMLElement>("[data-sidebar-section]");
			const willOpen = clicked?.dataset.open !== "true";
			getSections().forEach((s) => {
				setSectionOpen(s, s === clicked && willOpen);
			});
			return;
		}

		const link = target.closest<HTMLAnchorElement>("nav a");
		if (!link) return;

		if (window.innerWidth < 1024) closeFilters();

		// Product pages and modified clicks (new tab, etc.) navigate normally
		if (!getResults()) return;
		if (event.defaultPrevented || event.button !== 0) return;
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

		const url = new URL(link.href, location.href);
		if (url.origin !== location.origin) return;

		event.preventDefault();
		if (trimSlash(url.pathname) === shownPath) return;
		swapPage(url.href, true);
	});

	window.addEventListener("popstate", () => {
		if (!getResults() || trimSlash(location.pathname) === shownPath) return;
		savedResultsHTML = null;
		swapPage(location.href, false);
	});

	/*
	 * Cross-category product search.
	 * When query is non-empty: searches the JSON index embedded at build time and renders
	 * matching cards into [data-catalogue-results], saving the original HTML for restoration.
	 * When query is cleared: restores the saved original HTML.
	 */

	interface ProductEntry {
		title: string;
		description: string;
		url: string;
		image: string;
	}

	function getProductIndex(): ProductEntry[] {
		const el = document.querySelector<HTMLScriptElement>("[data-product-index]");
		if (!el) return [];
		try {
			return JSON.parse(el.textContent ?? "[]") as ProductEntry[];
		} catch {
			return [];
		}
	}

	function renderSearchResults(
		matches: ProductEntry[],
		labelDetails: string,
		labelNoResults: string
	): string {
		if (matches.length === 0) {
			return `<div class="text-industrial-gray py-24 text-center">
				<p class="text-lg">${labelNoResults}</p>
			</div>`;
		}
		const cards = matches
			.map(
				(p, i) => `
			<article
				class="card-hover product-card reveal group bg-background border-border-subtle/70 flex flex-col overflow-hidden rounded-xl border shadow-xs"
				style="--i:${i % 3}"
				data-product-item
				data-product-text="${(p.title + " " + p.description).toLowerCase().replace(/"/g, "&quot;")}"
			>
				<a href="${p.url}" class="border-border-subtle/40 focus-visible:outline-secondary relative flex aspect-4/3 items-center justify-center border-b bg-white p-4 focus-visible:outline-2 focus-visible:-outline-offset-2" aria-label="${p.title.replace(/"/g, "&quot;")}">
					<img src="${p.image || "/placeholder.svg"}" alt="${p.title.replace(/"/g, "&quot;")}"
						width="800" height="600"
						class="h-full w-full object-contain mix-blend-multiply"
						loading="lazy" />
				</a>
				<div class="flex flex-1 flex-col p-5 sm:p-6">
					<h3 class="font-headline-lg text-foreground m-0 mb-2 text-lg leading-snug font-semibold text-balance">${p.title}</h3>
					${p.description ? `<p class="font-body-md text-industrial-gray m-0 mb-5 line-clamp-2 text-sm leading-relaxed">${p.description}</p>` : ""}
					<div class="mt-auto">
						<a href="${p.url}"
							class="border-secondary/40 text-secondary group-hover:border-secondary group-hover:bg-secondary/5 focus-visible:outline-secondary font-technical-data flex w-full items-center justify-center gap-2 rounded-lg border py-2.5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
						>
							${labelDetails}
							<span class="material-symbols-outlined text-[16px] transition-transform group-hover:translate-x-1">arrow_forward</span>
						</a>
					</div>
				</div>
			</article>`
			)
			.join("");
		return `<section aria-label="Search results">
			<div data-product-grid class="gap-gutter grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
				${cards}
			</div>
		</section>`;
	}

	let savedResultsHTML: string | null = null;

	function runProductSearch(query: string): void {
		const results = getResults();
		if (!results) return;

		const input = document.querySelector<HTMLInputElement>("[data-product-search-input]");
		const labelDetails = input?.dataset.labelTechnicalDetails ?? "Technical Details";
		const labelNoResults =
			input?.dataset.labelNoResults ??
			"No products match your search. Try browsing another category.";

		if (query === "") {
			// Restore original page HTML
			if (savedResultsHTML !== null) {
				results.innerHTML = savedResultsHTML;
				observeReveals(results);
				savedResultsHTML = null;
			}
			return;
		}

		// Save current HTML before first search
		if (savedResultsHTML === null) {
			savedResultsHTML = results.innerHTML;
		}

		const index = getProductIndex();
		const matches = index.filter(
			(p) => p.title.toLowerCase().includes(query) || p.description.toLowerCase().includes(query)
		);

		results.innerHTML = renderSearchResults(matches, labelDetails, labelNoResults);
		observeReveals(results);
	}

	function setupProductSearch(): void {
		const existing = document.querySelector<HTMLInputElement>("[data-product-search-input]");
		if (!existing) return;

		// Clone to remove any previously attached listeners
		const input = existing.cloneNode(true) as HTMLInputElement;
		existing.replaceWith(input);

		// Pre-fill from URL on (re-)setup
		const initial = getSearchQuery();
		if (input.value !== initial) input.value = initial;

		input.addEventListener("input", () => {
			const q = input.value.trim().toLowerCase();
			setSearchQuery(input.value.trim());
			runProductSearch(q);
		});

		// Apply current query to results already in the DOM
		const q = initial.trim().toLowerCase();
		if (q) runProductSearch(q);
	}

	setupProductSearch();
</script>
