---
import { getInlineTranslations, type Lang } from "@/i18n";

interface Props {
	specs?: Array<{ label: string; value: string }>;
	lang: Lang;
}

const { specs = [], lang } = Astro.props;
const _ = getInlineTranslations(lang);
---

{
	specs && specs.length > 0 && (
		<section
			class="bg-background border-border-subtle/70 before:from-secondary relative overflow-hidden rounded-xl border shadow-xs before:absolute before:inset-x-0 before:top-0 before:h-0.5 before:bg-linear-to-r before:to-transparent"
			aria-labelledby="specs-heading"
		>
			<h2
				id="specs-heading"
				class="font-headline-lg text-foreground m-0 px-4 pt-6 pb-4 text-xl font-semibold tracking-tight break-words sm:px-8 sm:pt-7 sm:pb-5 sm:text-2xl"
			>
				{_("Technical Specifications")}
			</h2>
			<div class="border-border-subtle/60 border-t overflow-x-auto">
				<table class="w-full border-collapse text-left">
					<tbody class="font-technical-data text-technical-data">
						{specs.map((spec, index) => (
							<tr
								class={`border-border-subtle/60 hover:bg-secondary/5 border-b transition-colors last:border-b-0 ${
									index % 2 === 1 ? "bg-surface-container/60" : "bg-background"
								}`}
							>
								<th class="text-industrial-gray w-1/3 px-4 py-3 font-medium break-words sm:px-8 sm:py-4">{spec.label}</th>
								<td class="text-foreground px-4 py-3 font-semibold break-words sm:px-8 sm:py-4">{spec.value}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	)
}
