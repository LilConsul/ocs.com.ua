---
import type { Lang } from "@/i18n/utils";

interface Props {
	categoryData: {
		"en-label": string;
		"ua-label": string;
		"en-description": string;
		"ua-description": string;
	};
	lang: Lang;
}

const { categoryData, lang } = Astro.props;
const title = categoryData[`${lang}-label`];
const description = categoryData[`${lang}-description`];
---

<header class="mb-12">
	<!-- Large display heading with generous spacing -->
	<h1
		class="font-heading text-foreground mb-4 text-4xl leading-tight font-semibold tracking-tight md:text-5xl lg:text-6xl"
	>
		{title}
	</h1>
	<!-- Description with clear hierarchy -->
	<p class="text-muted-foreground max-w-3xl text-base leading-relaxed md:text-lg">
		{description}
	</p>
</header>
