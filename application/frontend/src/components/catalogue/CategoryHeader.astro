---
import type { Lang } from "@/i18n/utils";

interface Props {
	categoryData: {
		"en-label": string;
		"ua-label": string;
		"en-description": string;
		"ua-description": string;
	};
	lang: Lang;
}

const { categoryData, lang } = Astro.props;
const title = categoryData[`${lang}-label`];
const description = categoryData[`${lang}-description`];
---

<header class="mb-8 lg:mb-12">
	<h1
		class="font-display-lg-mobile text-display-lg-mobile lg:font-display-lg lg:text-display-lg text-primary mb-4"
	>
		{title}
	</h1>
	<p class="font-body-md text-body-md text-industrial-gray max-w-3xl">
		{description}
	</p>
</header>
