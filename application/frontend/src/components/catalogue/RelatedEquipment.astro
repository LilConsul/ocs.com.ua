---
import { Image } from "astro:assets";
import { getInlineTranslations, type Lang } from "@/i18n";
import { type EquipmentEntry, getCategory, getSlug } from "@/lib/content-utils";

interface Props {
	products: EquipmentEntry[];
	lang: Lang;
}

const { products = [], lang } = Astro.props;
const _ = getInlineTranslations(lang);
---

{
	products.length > 0 && (
		<section
			class="bg-background relative w-full overflow-hidden py-16 lg:py-24"
			aria-labelledby="related-heading"
			data-related
		>
			<div
				class="related-glow bg-secondary/10 pointer-events-none absolute -bottom-40 -left-24 size-[30rem] rounded-full blur-3xl"
				aria-hidden="true"
			/>

			<div class="px-edge-margin relative mx-auto max-w-[1600px]">
				<header class="mb-12">
					<span class="font-label-caps text-secondary flex items-center gap-3 text-xs font-semibold tracking-widest uppercase">
						<span class="bg-secondary h-px w-8" aria-hidden="true" />
						{_("Catalogue")}
					</span>
					<h2
						id="related-heading"
						class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance sm:text-3xl lg:text-4xl"
					>
						{_("Related Equipment")}
					</h2>
				</header>

				<div class="gap-gutter grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
					{products.map((item, index) => {
						const itemCategory = getCategory(item);
						const itemSlug = getSlug(item);
						const itemUrl = `/${lang}/catalogue/${itemCategory}/${itemSlug}`;
						const itemImg = item.data.gallery?.[0] || "/placeholder.jpg";
						const itemSpec = item.data.specs?.[0];

						return (
							<a
								href={itemUrl}
								class="related-card group bg-background border-border-subtle/70 hover:border-secondary/40 focus-visible:outline-secondary block overflow-hidden rounded-xl border shadow-xs transition-[translate,box-shadow,border-color] duration-300 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:hover:-translate-y-0.5"
								style={`--i:${index}`}
							>
								<div class="border-border-subtle/40 flex h-44 items-center justify-center border-b bg-white p-4">
									<Image
										src={itemImg}
										alt={item.data.title ?? ""}
										width={400}
										height={300}
										class="max-h-full max-w-full object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
										loading="lazy"
									/>
								</div>
								<div class="p-5">
									<p class="font-label-caps text-secondary mb-1 text-[11px] font-semibold tracking-wider uppercase">
										{itemCategory}
									</p>
									<h3 class="font-headline-lg text-foreground group-hover:text-secondary m-0 mb-2 text-base font-semibold transition-colors">
										{item.data.title}
									</h3>
									{itemSpec && (
										<p class="font-technical-data text-industrial-gray m-0 text-xs">
											{itemSpec.label}:{" "}
											<span class="text-foreground font-semibold">{itemSpec.value}</span>
										</p>
									)}
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>
	)
}

<style>
	@media (prefers-reduced-motion: no-preference) {
		/* Hidden only once the script has confirmed the animation will run */
		[data-anim="ready"] .related-card,
		[data-anim="ready"] .related-glow {
			opacity: 0;
		}

		[data-anim="in"] .related-card {
			animation: related-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) backwards;
			animation-delay: calc(var(--i, 0) * 100ms);
		}
		[data-anim="in"] .related-glow {
			animation: related-glow-in 1.4s ease-out backwards;
		}
	}

	@keyframes related-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
	}
	@keyframes related-glow-in {
		from {
			opacity: 0;
			transform: scale(0.7);
		}
	}
</style>

<script>
	import { revealOnce } from "@/lib/anims/reveal-once";

	const section = document.querySelector<HTMLElement>("[data-related]");
	if (section) revealOnce(section);
</script>
