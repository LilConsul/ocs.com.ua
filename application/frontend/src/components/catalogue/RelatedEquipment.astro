---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getInlineTranslations, type Lang } from "@/i18n";
import { productUrl } from "@/lib/catalogue-urls";
import {
	type EquipmentEntry,
	flattenSpecs,
	getCategoriesForLocale,
	getCategory,
	getSlug,
} from "@/lib/content-utils";
import { shortTitle } from "@/lib/featured-equipment";
import { PLACEHOLDER_IMAGE } from "@/lib/placeholder";

interface Props {
	products: EquipmentEntry[];
	lang: Lang;
	/** Pre-resolved galleries keyed by entry id, used when gallery is not in the entry (i18n: false). */
	galleries?: Record<string, ImageMetadata[]>;
}

const { products = [], lang, galleries = {} } = Astro.props;
const _ = getInlineTranslations(lang);
const categories = getCategoriesForLocale(lang);
const categoryTitle = (slug: string) => categories.find((c) => c.slug === slug)?.title ?? slug;
---

{products.length > 0 && (
	<section
		class="bg-background relative w-full overflow-hidden py-16 lg:py-24"
		aria-labelledby="related-heading"
	>
		<div
			class="reveal-glow bg-secondary/10 pointer-events-none absolute -bottom-40 -left-24 size-120 rounded-full blur-3xl"
			aria-hidden="true"
		/>

		<div class="px-edge-margin relative mx-auto max-w-[1600px]">
			<header class="mb-12">
				<span class="font-label-caps text-secondary flex items-center gap-3 text-xs font-semibold tracking-widest uppercase">
					<span class="eyebrow-rule bg-secondary h-px w-8" aria-hidden="true" />
					{_("Catalogue")}
				</span>
				<h2
					id="related-heading"
					class="reveal-heading font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance wrap-break-word sm:text-3xl lg:text-4xl"
				>
					{_("Related Equipment")}
				</h2>
			</header>

			<div class="gap-gutter grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
				{products.map((item, index) => {
					const itemCategory = getCategory(item);
					const itemSlug = getSlug(item);
					const itemUrl = productUrl(lang, itemCategory, itemSlug);
					const itemImg = galleries[item.id]?.[0] || PLACEHOLDER_IMAGE;
					const itemSpec = flattenSpecs(item.data.specs)[0];
					const itemModel = itemSlug.toUpperCase();

					return (
						<a
							href={itemUrl}
							class="card-hover catalogue-trace reveal group bg-background border-border-subtle/70 focus-visible:outline-secondary row-span-3 grid grid-rows-subgrid gap-y-0 overflow-hidden rounded-xl border shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2"
							style={`--i:${index}`}
						>
							<div class="skeleton border-border-subtle/40 bg-surface-container/60 flex h-44 items-center justify-center border-b p-4">
								<Image
									src={itemImg}
									alt={item.data.title ?? ""}
									widths={[400, 800]}
									sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
									format="webp"
									class="max-h-full max-w-full object-contain mix-blend-multiply dark:mix-blend-normal"
									loading="lazy"
								/>
							</div>
							<div class="px-4 pt-4 sm:px-5 sm:pt-5">
								<p class="font-label-caps text-industrial-gray m-0 mb-2 text-[11px] font-semibold tracking-wider uppercase">
									{categoryTitle(itemCategory)}
								</p>
								<h3 class="font-headline-lg text-foreground m-0 text-xl leading-tight font-semibold tracking-tight [overflow-wrap:anywhere]">
									{itemModel}
								</h3>
								<p class="font-body-md text-industrial-gray m-0 mt-1.5 text-sm leading-snug font-medium text-balance">
									{shortTitle(item.data.title ?? "", itemModel)}
								</p>
							</div>
							<div class="flex items-end px-4 pt-3 pb-4 sm:px-5 sm:pb-5">
								{itemSpec && (
									<dl class="border-border-subtle/60 m-0 w-full min-w-0 border-t pt-3">
										<dt class="font-label-caps text-industrial-gray mb-1 text-[10px] tracking-wider uppercase">
											{itemSpec.label}
										</dt>
										<dd class="font-headline-lg text-foreground m-0 text-base font-semibold tracking-tight [overflow-wrap:anywhere]">
											{itemSpec.value.split(",")[0].trim()}
										</dd>
									</dl>
								)}
							</div>
						</a>
					);
				})}
			</div>
		</div>
	</section>
)}
