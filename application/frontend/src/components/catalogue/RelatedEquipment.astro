---
import { Image } from "astro:assets";
import { getInlineTranslations, type Lang } from "@/i18n";
import { productUrl } from "@/lib/catalogue-urls";
import { type EquipmentEntry, flattenSpecs, getCategory, getSlug } from "@/lib/content-utils";

interface Props {
	products: EquipmentEntry[];
	lang: Lang;
	/** Pre-resolved galleries keyed by entry id, used when gallery is not in the entry (i18n: false). */
	galleries?: Record<string, string[]>;
}

const { products = [], lang, galleries = {} } = Astro.props;
const _ = getInlineTranslations(lang);
---

{
	products.length > 0 && (
		<section
			class="bg-background relative w-full overflow-hidden py-16 lg:py-24"
			aria-labelledby="related-heading"
		>
			<div
				class="reveal-glow bg-secondary/10 pointer-events-none absolute -bottom-40 -left-24 size-120 rounded-full blur-3xl"
				aria-hidden="true"
			/>

			<div class="px-edge-margin relative mx-auto max-w-[1600px]">
				<header class="mb-12">
					<span class="font-label-caps text-secondary flex items-center gap-3 text-xs font-semibold tracking-widest uppercase">
						<span class="eyebrow-rule bg-secondary h-px w-8" aria-hidden="true" />
						{_("Catalogue")}
					</span>
					<h2
						id="related-heading"
						class="font-headline-lg text-foreground mt-2 text-2xl font-semibold tracking-tight text-balance wrap-break-word sm:text-3xl lg:text-4xl"
					>
						{_("Related Equipment")}
					</h2>
				</header>

				<div class="gap-gutter grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
					{products.map((item, index) => {
						const itemCategory = getCategory(item);
						const itemSlug = getSlug(item);
						const itemUrl = productUrl(lang, itemCategory, itemSlug);
						const itemImg = galleries[item.id]?.[0] || "/placeholder.svg";
						const itemSpec = flattenSpecs(item.data.specs)[0];

						return (
							<a
								href={itemUrl}
								class="reveal group bg-background border-border-subtle/70 hover:border-secondary/40 focus-visible:outline-secondary block overflow-hidden rounded-xl border shadow-xs transition-[translate,box-shadow,border-color] duration-300 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 motion-safe:hover:-translate-y-0.5"
								style={`--i:${index}`}
							>
								<div class="border-border-subtle/40 flex h-44 items-center justify-center border-b bg-white p-4">
									<Image
										src={itemImg}
										alt={item.data.title ?? ""}
										width={400}
										height={300}
										class="max-h-full max-w-full object-contain mix-blend-multiply transition-transform duration-300 group-hover:scale-105"
										loading="lazy"
									/>
								</div>
								<div class="p-4 sm:p-5">
									<p class="font-label-caps text-secondary mb-1 text-[11px] font-semibold tracking-wider uppercase">
										{itemCategory}
									</p>
									<h3 class="font-headline-lg text-foreground group-hover:text-secondary m-0 mb-2 text-base font-semibold wrap-break-word transition-colors">
										{item.data.title}
									</h3>
									{itemSpec && (
										<p class="font-technical-data text-industrial-gray m-0 text-xs wrap-break-word">
											{itemSpec.label}:{" "}
											<span class="text-foreground font-semibold">{itemSpec.value}</span>
										</p>
									)}
								</div>
							</a>
						);
					})}
				</div>
			</div>
		</section>
	)
}
