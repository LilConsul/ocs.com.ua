---
import { ArrowRight } from "lucide-react";

import { Badge } from "@/components/ui/badge";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import type { HomepageContent } from "@/types/content";

interface Props {
	content: HomepageContent["featuredEquipment"];
}

const { content } = Astro.props;

const equipmentDescriptions: Record<string, string> = {
	"checkweigher-ema-300": "Dynamic checkweighing for high-throughput production lines.",
	"metal-detector-md-500": "Reliable contaminant detection for packaged and bulk products.",
	"xray-inspector-xi-700": "Advanced X-ray inspection for quality assurance and compliance.",
};
---

<section class="bg-muted/30 py-16 md:py-24">
	<div class="mx-auto max-w-7xl px-4">
		<div class="mx-auto mb-12 max-w-3xl space-y-4 text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">
				Equipment
			</p>
			<h2 class="font-heading text-3xl font-semibold md:text-4xl">
				{content.title}
			</h2>
			<p class="text-base text-muted-foreground md:text-lg">
				{content.description}
			</p>
		</div>

		<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
			{
				content.equipmentIds.map((id) => (
					<Card className="h-full border border-border/70 bg-background">
						<div class="aspect-[16/10] border-b border-border/70 bg-gradient-to-br from-primary/10 via-background to-muted" />
						<CardHeader className="space-y-3">
							<Badge variant="outline" className="w-fit">
								Featured
							</Badge>
							<CardTitle className="capitalize">
								{id.replaceAll("-", " ")}
							</CardTitle>
							<CardDescription>
								{equipmentDescriptions[id] ??
									"High-precision industrial equipment for demanding production environments."}
							</CardDescription>
						</CardHeader>
						<CardContent>
							<a
								href={`/equipment/${id}`}
								class="inline-flex items-center gap-2 text-sm font-medium text-primary transition-colors hover:text-primary/80"
							>
								View details
								<ArrowRight className="size-4" />
							</a>
						</CardContent>
					</Card>
				))
			}
		</div>
	</div>
</section>
