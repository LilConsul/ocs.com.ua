---
import { Award, Globe, Headphones, ShieldCheck } from "lucide-react";

import type { HomepageContent } from "@/types/content";

interface Props {
	content: HomepageContent["whyChooseUs"];
	tinaField?: (obj: any, ...path: (string | number)[]) => string | undefined;
}

const { content, tinaField } = Astro.props;

const iconMap = {
	award: Award,
	"shield-check": ShieldCheck,
	headphones: Headphones,
	globe: Globe,
} as const;
---

<section class="py-16 md:py-24" {...(tinaField ? { 'data-tina-field': tinaField(content, 'whyChooseUs') } : {})}>
	<div class="mx-auto max-w-7xl px-4">
		<div class="mx-auto mb-12 max-w-3xl space-y-4 text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-primary">
				Why OCS
			</p>
			<h2 class="font-heading text-3xl font-semibold md:text-4xl" {...(tinaField ? { 'data-tina-field': tinaField(content, 'title') } : {})}>
				{content.title}
			</h2>
		</div>

		<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4" {...(tinaField ? { 'data-tina-field': tinaField(content, 'benefits') } : {})}>
			{
				content.benefits.map((benefit, index) => {
					const Icon = iconMap[benefit.icon as keyof typeof iconMap] ?? Award;

					return (
						<div class="flex h-full flex-col gap-4 border border-border/70 bg-background p-6 text-center" {...(tinaField ? { 'data-tina-field': tinaField(benefit, index) } : {})}>
							<div class="mx-auto flex size-14 items-center justify-center border border-border/70 bg-muted text-primary">
								<Icon className="size-7" />
							</div>
							<h3 class="font-heading text-xl font-semibold" {...(tinaField ? { 'data-tina-field': tinaField(benefit, 'title') } : {})}>{benefit.title}</h3>
							<p class="text-sm leading-7 text-muted-foreground" {...(tinaField ? { 'data-tina-field': tinaField(benefit, 'description') } : {})}>
								{benefit.description}
							</p>
						</div>
					);
				})
			}
		</div>
	</div>
</section>
