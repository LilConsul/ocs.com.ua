---
import "../styles/global.css";
import type { ComponentProps } from "astro/types";
import { SEO } from "astro-seo";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
// biome-ignore lint/style/useImportType: rendered as a component in the template
import TechnicalField from "@/components/TechnicalField.astro";
import companyData from "@/data/company.json";
import { defaultLang, getIsoLang, getLangFromUrl } from "@/i18n";
import { markdownPath } from "@/lib/llms";
import type { SchemaGraph } from "@/lib/structured-data";
import motionOn from "../lib/anims/motion-on.js?raw";
import skeletonOn from "../lib/skeleton-on.js?raw";
import noJsCss from "../styles/no-js.css?raw";

type BackgroundVariant = NonNullable<ComponentProps<typeof TechnicalField>["variant"]>;

const sectionVariants: Record<string, BackgroundVariant> = {
	catalogue: "catalogue",
	wiki: "wiki",
	privacy: "wiki",
	terms: "wiki",
	contact: "contact",
	about: "about",
};

interface Props {
	title: string;
	description?: string;
	showHeader?: boolean;
	image?: string;
	article?: boolean;
	structuredData?: SchemaGraph;
}

const {
	title,
	description,
	showHeader = true,
	image,
	article = false,
	structuredData,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const isoLang = getIsoLang(lang);
const currentPath = Astro.url.pathname;
// Pages live under /{lang}/{section}/..., so the section is the second path segment
const section = currentPath.split("/")[2] ?? "";
const backgroundVariant = sectionVariants[section] ?? "quiet";

const siteUrl = Astro.site || "https://ocs.com.ua";
const canonicalUrl = new URL(currentPath, siteUrl).href;
const companyName = companyData.name[lang as "en" | "ua"] ?? companyData.name.en;

// Language alternates only exist for pages under /en/ or /ua/ (not the 404/50x error pages)
const isLocalized = /^\/(en|ua)(\/|$)/.test(currentPath);
const pathFor = (target: "en" | "ua") => currentPath.replace(/^\/(en|ua)(?=\/|$)/, `/${target}`);
const urlFor = (target: "en" | "ua") => new URL(pathFor(target), siteUrl).href;

const mdPath = markdownPath(currentPath);
const markdownUrl = mdPath ? new URL(mdPath, siteUrl).href : undefined;

// Social platforms don't render SVG, so the default share image is a 1200x630 PNG per language
const ogImage = new URL(image || `/assets/og-${lang}.png`, siteUrl).href;
const ogImageIsDefault = !image;

const defaultDescription =
	lang === "en"
		? "OS-Technology Ukraine - B2B industrial equipment for precision weighing, inspection, and quality control systems"
		: "ОС-Технолоджи Україна - промислове обладнання для точного зважування, інспекції та систем контролю якості";
---

<!doctype html>
<html lang={isoLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/assets/fonts/material-symbols-outlined.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<noscript><style is:inline set:html={noJsCss}></style></noscript>
		<script is:inline set:html={motionOn} />
		<script is:inline set:html={skeletonOn} />
		<meta name="generator" content={Astro.generator} />

		<SEO
			title={title}
			description={description || defaultDescription}
			canonical={canonicalUrl}
			openGraph={{
				basic: {
					title: title,
					type: article ? "article" : "website",
					image: ogImage,
					url: canonicalUrl,
				},
				optional: {
					description: description || defaultDescription,
					locale: lang === "en" ? "en_US" : "uk_UA",
					siteName: companyName,
				},
				image: {
					alt: title,
					...(ogImageIsDefault && { type: "image/png", width: 1200, height: 630 }),
				},
			}}
			twitter={{
				card: "summary_large_image",
				title: title,
				description: description || defaultDescription,
				image: ogImage,
				imageAlt: title,
			}}
			languageAlternates={isLocalized
				? [
						{ href: urlFor("ua"), hrefLang: getIsoLang("ua") },
						{ href: urlFor("en"), hrefLang: getIsoLang("en") },
						// Same fallback on every page: the site's default language
						{ href: urlFor(defaultLang), hrefLang: "x-default" },
					]
				: undefined}
		/>

		{
			// Points AI tools at the plain-Markdown copy of this page (see src/lib/llms.ts)
			markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />
		}

		{
			structuredData && (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
			)
		}

		<!-- BEGIN PLERDY CODE -->
		<script is:inline data-plerdy_code="1">
			(function (w, d) {
				if (w.__plerdyCode) return;
				w.__plerdyCode = 1;
				w._protocol = w.location.protocol == "https:" ? "https://" : "http://";
				w._site_hash_code = "4032906a023912ef8712153f97e74d4c";
				w._suid = 83066;
				var s = d.createElement("script");
				s.async = true;
				s.referrerPolicy = "strict-origin-when-cross-origin";
				s.src = "https://a.plerdy.com/public/js/click/main.js?v=" + Math.random();
				d.head.appendChild(s);
			})(window, document);
		</script>
		<!-- END PLERDY CODE -->
	</head>
	<body class={`page-${backgroundVariant} bg-background text-foreground min-h-screen antialiased`}>
		<div class="site-technical-field" aria-hidden="true">
			<TechnicalField
				variant={backgroundVariant}
				opacity={backgroundVariant === "quiet" ? 0.22 : 0.28}
			/>
		</div>
		<div class="scroll-progress" data-scroll-progress aria-hidden="true"></div>
		{showHeader && <Header currentLang={lang} currentPath={currentPath} />}
		<main class="relative z-10 pt-[calc(5rem+var(--banner-h,0px))]">
			<slot />
		</main>
		<Footer
			share={isLocalized ? { title, description: description || defaultDescription } : undefined}
		/>
		<script>
			import "@/lib/anims/runtime";
			import { initImageSkeletons } from "@/lib/image-skeleton";

			// skeleton-on.js (in <head>) ends skeletons as pictures load; this sweeps up the rest
			initImageSkeletons();
		</script>
		<script>
			const progress = document.querySelector<HTMLElement>("[data-scroll-progress]");
			let progressFrame = 0;

			const updateScrollProgress = () => {
				progressFrame = 0;
				if (!progress) return;
				const scrollable = document.documentElement.scrollHeight - window.innerHeight;
				progress.style.transform = `scaleX(${scrollable > 0 ? window.scrollY / scrollable : 0})`;
			};

			window.addEventListener(
				"scroll",
				() => {
					if (!progressFrame) progressFrame = requestAnimationFrame(updateScrollProgress);
				},
				{ passive: true }
			);
			updateScrollProgress();
		</script>
	</body>
</html>
