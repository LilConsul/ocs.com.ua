---
import "../styles/global.css";
import { SEO } from "astro-seo";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import companyData from "@/data/company.json";
import { defaultLang, getIsoLang, getLangFromUrl } from "@/i18n";
import type { SchemaGraph } from "@/lib/structured-data";

interface Props {
	title: string;
	description?: string;
	showHeader?: boolean;
	image?: string;
	article?: boolean;
	structuredData?: SchemaGraph;
}

const {
	title,
	description,
	showHeader = true,
	image,
	article = false,
	structuredData,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const isoLang = getIsoLang(lang);
const currentPath = Astro.url.pathname;

const siteUrl = Astro.site || "https://ocs.com.ua";
const canonicalUrl = new URL(currentPath, siteUrl).href;
const companyName = companyData.name[lang as "en" | "ua"] ?? companyData.name.en;

// Language alternates only exist for pages under /en/ or /ua/ (not the 404/50x error pages)
const isLocalized = /^\/(en|ua)(\/|$)/.test(currentPath);
const pathFor = (target: "en" | "ua") => currentPath.replace(/^\/(en|ua)(?=\/|$)/, `/${target}`);
const urlFor = (target: "en" | "ua") => new URL(pathFor(target), siteUrl).href;

// Social platforms don't render SVG, so the default share image is a 1200x630 PNG per language
const ogImage = new URL(image || `/assets/og-${lang}.png`, siteUrl).href;
const ogImageIsDefault = !image;

const defaultDescription =
	lang === "en"
		? "OS-Technology Ukraine - B2B industrial equipment for precision weighing, inspection, and quality control systems"
		: "ОС-Технолоджи Україна - промислове обладнання для точного зважування, інспекції та систем контролю якості";
---

<!doctype html>
<html lang={isoLang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link
			rel="preload"
			href="/assets/fonts/material-symbols-outlined.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		<SEO
			title={title}
			description={description || defaultDescription}
			canonical={canonicalUrl}
			openGraph={{
				basic: {
					title: title,
					type: article ? "article" : "website",
					image: ogImage,
					url: canonicalUrl,
				},
				optional: {
					description: description || defaultDescription,
					locale: lang === "en" ? "en_US" : "uk_UA",
					siteName: companyName,
				},
				image: {
					alt: title,
					...(ogImageIsDefault && { type: "image/png", width: 1200, height: 630 }),
				},
			}}
			twitter={{
				card: "summary_large_image",
				title: title,
				description: description || defaultDescription,
				image: ogImage,
				imageAlt: title,
			}}
			languageAlternates={isLocalized
				? [
						{ href: urlFor("ua"), hrefLang: getIsoLang("ua") },
						{ href: urlFor("en"), hrefLang: getIsoLang("en") },
						// Same fallback on every page: the site's default language
						{ href: urlFor(defaultLang), hrefLang: "x-default" },
					]
				: undefined}
		/>

		{
			structuredData && (
				<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
			)
		}

		<!-- BEGIN PLERDY CODE -->
		<script is:inline data-plerdy_code="1">
			(function (w, d) {
				if (w.__plerdyCode) return;
				w.__plerdyCode = 1;
				w._protocol = w.location.protocol == "https:" ? "https://" : "http://";
				w._site_hash_code = "722f7e7a90fc3a805c26e6d3b638bc77";
				w._suid = 82713;
				var s = d.createElement("script");
				s.async = true;
				s.referrerPolicy = "strict-origin-when-cross-origin";
				s.src = "https://a.plerdy.com/public/js/click/main.js?v=" + Math.random();
				d.head.appendChild(s);
			})(window, document);
		</script>
		<!-- END PLERDY CODE -->
	</head>
	<body class="bg-background text-foreground min-h-screen antialiased">
		{showHeader && <Header currentLang={lang} currentPath={currentPath} />}
		<main class="pt-[calc(5rem+var(--banner-h,0px))]">
			<slot />
		</main>
		<Footer
			share={isLocalized ? { title, description: description || defaultDescription } : undefined}
		/>
		<script>
			import { initEyebrowRules } from "@/lib/anims/eyebrow-rule";

			initEyebrowRules();
		</script>
	</body>
</html>
