{
	"name": "frontend",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"test:e2e": "playwright test",
		"check:links": "node scripts/check-links.mjs",
		"check": "biome check .",
		"check:fix": "biome check --write . && prettier --write \"**/*.{astro,tsx,jsx}\"",
		"ci": "biome ci .",
		"i18n": "node scripts/i18n-extract-po.js && node scripts/i18n-compile.js",
		"i18n:extract": "node scripts/i18n-extract-po.js",
		"i18n:init": "node scripts/i18n-extract-po.js --init",
		"i18n:compile": "node scripts/i18n-compile.js",
		"remark:check": "remark src/content --frail",
		"remark:write": "remark src/content --output"
	},
	"remarkConfig": {
		"plugins": [
			"remark-frontmatter"
		]
	},
	"dependencies": {
		"@astrojs/node": "11.1.12",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@lucide/astro": "^1.72.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"astro": "7.4.10",
		"astro-seo": "^1.2.0",
		"astro-social-share": "^2.2.0",
		"d3-geo": "^3.1.2",
		"decap-cms-app": "^3.17.3",
		"marked": "^18.2.0",
		"motion": "^14.12.0",
		"nodemailer": "^10.5.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.5",
		"topojson-client": "^3.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@biomejs/biome": "^2.6.6",
		"@playwright/test": "^1.65.0",
		"@types/bun": "^1.4.4",
		"@types/d3-geo": "^3.1.1",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-server": "^3.0.4",
		"@types/topojson-simplify": "^3.0.3",
		"@types/topojson-specification": "^1.0.5",
		"glob": "^14.0.4",
		"immutable": "^5.1.10",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"topojson-server": "^3.0.1",
		"topojson-simplify": "^3.0.3",
		"typescript": "^7.0.2",
		"yaml": "^2.9.1"
	},
	"patchedDependencies": {
		"decap-cms-core@3.19.1": "patches/decap-cms-core@3.19.1.patch"
	}
}
