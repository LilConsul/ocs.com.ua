{
	"name": "frontend",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "biome check .",
		"check:fix": "biome check --write . && prettier --write \"**/*.{astro,tsx,jsx}\"",
		"ci": "biome ci .",
		"i18n": "node scripts/i18n-extract-po.js && node scripts/i18n-compile.js",
		"i18n:extract": "node scripts/i18n-extract-po.js",
		"i18n:init": "node scripts/i18n-extract-po.js --init",
		"i18n:compile": "node scripts/i18n-compile.js",
		"remark:check": "remark src/content --frail",
		"remark:write": "remark src/content --output"
	},
	"remarkConfig": {
		"plugins": [
			"remark-frontmatter"
		]
	},
	"dependencies": {
		"@astrojs/node": "11.1.7",
		"@astrojs/react": "^7.0.1",
		"@astrojs/sitemap": "^3.7.4",
		"@fontsource-variable/ibm-plex-sans": "^5.2.8",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"astro": "7.2.8",
		"astro-seo": "^1.2.0",
		"astro-social-share": "^2.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"decap-cms-app": "^3.16.3",
		"lucide-react": "^1.17.0",
		"marked": "^18.0.12",
		"nodemailer": "^10.1.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.4.16",
		"@types/bun": "^1.4.3",
		"@types/node": "^22.20.2",
		"@types/nodemailer": "^8.0.2",
		"glob": "^13.0.6",
		"image-size": "^2.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remark-cli": "^12.0.1",
		"remark-frontmatter": "^5.0.0",
		"shadcn": "^4.10.0",
		"typescript": "^6.0.3",
		"yaml": "^2.9.1"
	}
}
